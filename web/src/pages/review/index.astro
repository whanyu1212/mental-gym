---
import { getGuide } from "../../data/algorithmGuides";
import { mlProblems } from "../../data/mlProblems";
import { problems } from "../../data/problems";
import { sqlProblems } from "../../data/sqlProblems";
import Layout from "../../layouts/Layout.astro";
import { buildReviewDeck, serializeReviewDeck } from "../../lib/review-deck";
import { withBase } from "../../lib/url";

const deckJson = serializeReviewDeck(
	buildReviewDeck(
		{ problems, getGuide, mlProblems, sqlProblems },
		import.meta.env.BASE_URL
	)
);
---

<Layout title="Daily Review | Mental Gym">
	<review-deck
		class="review-shell"
		data-problems-url={withBase("/problems?view=cards")}
	>
		<header class="review-header">
			<div class="review-title-block">
				<p class="eyebrow">Spaced Repetition</p>
				<h1>Daily Review</h1>
			</div>
			<p class="review-progress" data-session-progress aria-live="polite"></p>
		</header>

		<div class="spread-banner" data-spread-banner hidden>
			<div class="spread-copy">
				<strong data-spread-title>Backlog check</strong>
				<p data-spread-text></p>
			</div>
			<button type="button" class="spread-btn" data-spread-btn>
				Spread over 5 days
			</button>
		</div>

		<section class="review-state-card" data-review-empty hidden>
			<h2 data-empty-heading>All caught up.</h2>
			<p data-empty-copy>
				No cards are due right now. Browse Quick Review cards to annotate your
				personal traps, or inspect your progress.
			</p>
			<div class="state-actions">
				<a class="primary-link" href={withBase("/problems?view=cards")}>
					Browse Quick Review →
				</a>
				<a class="secondary-link" href={withBase("/progress")}>View progress</a>
			</div>
		</section>

		<section class="review-card" data-review-stage hidden>
			<div class="card-front-meta">
				<span class="card-id" data-card-id></span>
				<span class="requeue-badge" data-requeue-badge hidden>
					Again · try once more
				</span>
			</div>

			<h2 class="card-title" data-card-title></h2>

			<div class="review-prompt prose" data-card-prompt></div>

			<div class="front-actions" data-front-actions>
				<p class="recall-checklist">
					Before revealing: name the pattern, invariant, main trap, and Big-O.
				</p>
				<button type="button" class="reveal-btn" data-reveal-btn>
					Reveal answer <kbd>Space</kbd>
				</button>
			</div>

			<div class="review-back" data-review-back hidden>
				<div class="back-meta-row">
					<div class="back-meta-badges">
						<span class="meta-group" data-back-group></span>
						<span class="meta-diff" data-back-diff></span>
						<span class="meta-complexity" data-back-complexity hidden></span>
						<span class="meta-weak" data-back-weakspot hidden>Weak spot</span>
					</div>
					<a class="open-problem-link" data-back-link href={withBase("/problems")}>
						Open full problem ↗
					</a>
				</div>

				<p class="back-pattern" data-back-pattern></p>

				<dl class="back-facts" data-back-facts></dl>

				<div class="note-box">
					<div class="note-header">
						<label class="note-label" for="review-my-trap">My trap</label>
						<span class="note-status" data-note-status aria-live="polite"></span>
					</div>
					<textarea
						id="review-my-trap"
						class="note-input"
						rows="2"
						data-note-input
						placeholder="Jot down what tripped you up…"
					></textarea>
					<div class="note-actions">
						<button type="button" class="note-save-btn" data-note-save hidden>
							Save
						</button>
					</div>
				</div>

				<div class="rating-section">
					<p class="rating-prompt">How well did you recall the solution?</p>
					<div class="rating-buttons" data-rating-buttons>
						<button type="button" class="rating-btn again" data-quality="0">
							<span class="rating-top">
								<span class="rating-label">Again</span>
								<kbd>1</kbd>
							</span>
							<span class="rating-preview" data-preview="0">Today</span>
						</button>
						<button type="button" class="rating-btn hard" data-quality="1">
							<span class="rating-top">
								<span class="rating-label">Hard</span>
								<kbd>2</kbd>
							</span>
							<span class="rating-preview" data-preview="1">1d</span>
						</button>
						<button type="button" class="rating-btn good" data-quality="2">
							<span class="rating-top">
								<span class="rating-label">Good</span>
								<kbd>3</kbd>
							</span>
							<span class="rating-preview" data-preview="2">1d</span>
						</button>
						<button type="button" class="rating-btn easy" data-quality="3">
							<span class="rating-top">
								<span class="rating-label">Easy</span>
								<kbd>4</kbd>
							</span>
							<span class="rating-preview" data-preview="3">4d</span>
						</button>
					</div>
				</div>
			</div>
		</section>

		<section class="review-state-card" data-review-complete hidden>
			<h2>Session complete.</h2>
			<p data-complete-summary></p>
			<div class="state-actions">
				<button type="button" class="reveal-btn" data-more-btn hidden>
					Review 5 more
				</button>
				<a class="primary-link" data-complete-problems href={withBase("/problems?view=cards")}>
					Browse Quick Review →
				</a>
				<a class="secondary-link" href={withBase("/progress")}>View progress</a>
			</div>
		</section>
	</review-deck>

	<script type="application/json" id="review-deck-data" set:html={deckJson} />
</Layout>

<script>
	import {
		advanceSession,
		countOverdue,
		createReviewSession,
		DEFAULT_DAILY_CAP,
		EXTRA_BATCH_SIZE,
		formatIntervalPreview,
		OVERDUE_SPREAD_DAYS,
		shouldOfferOverdueSpread,
		type ReviewSessionState,
	} from "../../scripts/review-session";
	import {
		getAllRecords,
		putRecords,
		putReviewAndEvent,
	} from "../../scripts/sr-db";
	import { savePersonalNote } from "../../scripts/sr-notes";
	import {
		isWeakSpot,
		localDateISO,
		schedule,
		spreadOverdue,
		todayISO,
	} from "../../scripts/sr-scheduler";
	import type { ReviewQuality, ReviewRecord } from "../../scripts/sr-types";
	import type { ReviewDeckCard } from "../../lib/review-deck";

	class ReviewDeckElement extends HTMLElement {
		private initialized = false;
		private keyHandler: ((event: KeyboardEvent) => void) | null = null;
		private statusTimer: number | undefined;

		connectedCallback() {
			if (this.initialized) {
				if (this.keyHandler) {
					window.addEventListener("keydown", this.keyHandler);
				}
				return;
			}
			this.initialized = true;

			const dataEl = document.getElementById("review-deck-data");
			let deck: Record<string, ReviewDeckCard> = {};
			try {
				deck = dataEl?.textContent ? JSON.parse(dataEl.textContent) : {};
			} catch {
				deck = {};
			}

			const progressEl = this.querySelector<HTMLElement>("[data-session-progress]")!;
			const spreadBanner = this.querySelector<HTMLElement>("[data-spread-banner]")!;
			const spreadText = this.querySelector<HTMLElement>("[data-spread-text]")!;
			const spreadBtn = this.querySelector<HTMLButtonElement>("[data-spread-btn]")!;

			const emptyEl = this.querySelector<HTMLElement>("[data-review-empty]")!;
			const emptyHeadingEl = this.querySelector<HTMLElement>("[data-empty-heading]")!;
			const emptyCopyEl = this.querySelector<HTMLElement>("[data-empty-copy]")!;
			const stageEl = this.querySelector<HTMLElement>("[data-review-stage]")!;
			const completeEl = this.querySelector<HTMLElement>("[data-review-complete]")!;

			const cardIdEl = this.querySelector<HTMLElement>("[data-card-id]")!;
			const requeueBadgeEl = this.querySelector<HTMLElement>("[data-requeue-badge]")!;
			const cardTitleEl = this.querySelector<HTMLElement>("[data-card-title]")!;
			const cardPromptEl = this.querySelector<HTMLElement>("[data-card-prompt]")!;
			const frontActionsEl = this.querySelector<HTMLElement>("[data-front-actions]")!;
			const revealBtn = this.querySelector<HTMLButtonElement>("[data-reveal-btn]")!;

			const backEl = this.querySelector<HTMLElement>("[data-review-back]")!;
			const backGroupEl = this.querySelector<HTMLElement>("[data-back-group]")!;
			const backDiffEl = this.querySelector<HTMLElement>("[data-back-diff]")!;
			const backComplexityEl = this.querySelector<HTMLElement>("[data-back-complexity]")!;
			const backWeakEl = this.querySelector<HTMLElement>("[data-back-weakspot]")!;
			const backLinkEl = this.querySelector<HTMLAnchorElement>("[data-back-link]")!;
			const backPatternEl = this.querySelector<HTMLElement>("[data-back-pattern]")!;
			const backFactsEl = this.querySelector<HTMLElement>("[data-back-facts]")!;

			const noteInput = this.querySelector<HTMLTextAreaElement>("[data-note-input]")!;
			const noteSaveBtn = this.querySelector<HTMLButtonElement>("[data-note-save]")!;
			const noteStatusEl = this.querySelector<HTMLElement>("[data-note-status]")!;

			const ratingButtons = Array.from(
				this.querySelectorAll<HTMLButtonElement>("[data-rating-buttons] [data-quality]")
			);
			const completeSummaryEl = this.querySelector<HTMLElement>("[data-complete-summary]")!;
			const moreBtn = this.querySelector<HTMLButtonElement>("[data-more-btn]")!;

			let allRecords: ReviewRecord[] = [];
			let session: ReviewSessionState = createReviewSession([]);
			const sessionDismissedKeys = new Set<string>();
			let revealed = false;
			let isRating = false;
			let isSpreading = false;
			let noteSavePromise: Promise<ReviewRecord | null> | null = null;
			let activeSaveKey: string | null = null;
			let pendingNoteCommit = false;
			let savedNote = "";

			const showNoteStatus = (msg: string, isError = false) => {
				window.clearTimeout(this.statusTimer);
				noteStatusEl.textContent = msg;
				noteStatusEl.classList.toggle("is-error", isError);
				if (msg) {
					this.statusTimer = window.setTimeout(() => {
						noteStatusEl.textContent = "";
						noteStatusEl.classList.remove("is-error");
					}, 2000);
				}
			};

			const syncNoteDirty = () => {
				noteSaveBtn.hidden = noteInput.value.trim() === savedNote;
			};

			const appendFact = (label: string, text: string, trapCase?: ReviewDeckCard["trapCase"]) => {
				if (!text && !trapCase) return;
				const wrap = document.createElement("div");
				wrap.className = "back-fact";
				const dt = document.createElement("dt");
				dt.textContent = label;
				const dd = document.createElement("dd");

				if (text) {
					const p = document.createElement("p");
					p.className = "fact-copy";
					p.textContent = text;
					dd.appendChild(p);
				}
				if (trapCase) {
					const box = document.createElement("div");
					box.className = "trap-case";
					const io = document.createElement("span");
					io.className = "trap-case-io";
					const cIn = document.createElement("code");
					cIn.textContent = trapCase.input;
					const arrow = document.createElement("span");
					arrow.setAttribute("aria-hidden", "true");
					arrow.textContent = "→";
					const cOut = document.createElement("code");
					cOut.textContent = trapCase.expected;
					io.append(cIn, arrow, cOut);
					box.appendChild(io);
					if (trapCase.note) {
						const note = document.createElement("span");
						note.className = "trap-case-note";
						note.textContent = trapCase.note;
						box.appendChild(note);
					}
					dd.appendChild(box);
				}

				wrap.append(dt, dd);
				backFactsEl.appendChild(wrap);
			};

			const renderCurrent = () => {
				const current = session.queue[0];

				if (shouldOfferOverdueSpread(session.overdueCount)) {
					spreadText.textContent = `You have ${session.overdueCount} overdue cards — spread them across the next ${OVERDUE_SPREAD_DAYS} days without resetting your intervals?`;
					spreadBanner.hidden = false;
				} else {
					spreadBanner.hidden = true;
				}

				if (!current) {
					stageEl.hidden = true;
					if (session.completedCount === 0 && session.initialBatchSize === 0) {
						emptyHeadingEl.textContent = "All caught up.";
						emptyCopyEl.textContent =
							"No cards are due right now. Browse Quick Review cards to annotate your personal traps, or inspect your progress.";
						emptyEl.hidden = false;
						completeEl.hidden = true;
						progressEl.textContent = session.backlogCount > 0 ? `${session.backlogCount} waiting` : "0 due";
					} else {
						emptyEl.hidden = true;
						completeEl.hidden = false;
						const dismissedCount = sessionDismissedKeys.size;
						if (session.backlogCount > 0) {
							progressEl.textContent = `Batch done · ${session.backlogCount} in backlog`;
						} else if (dismissedCount > 0) {
							progressEl.textContent = `Batch paused · ${dismissedCount} missed still due today`;
						} else {
							progressEl.textContent = "All due cards complete";
						}

						const parts = [
							`Reviewed ${session.completedCount} ${session.completedCount === 1 ? "card" : "cards"}`,
						];
						if (session.againCount > 0) {
							parts.push(`${session.againCount} missed`);
						}
						if (session.backlogCount > 0) {
							parts.push(`${session.backlogCount} remaining in backlog`);
						} else if (dismissedCount > 0) {
							parts.push(`${dismissedCount} missed ${dismissedCount === 1 ? "card" : "cards"} still due today`);
						}
						completeSummaryEl.textContent = `${parts.join(" · ")}.`;
						moreBtn.hidden = session.backlogCount === 0;
						moreBtn.textContent = `Review ${Math.min(EXTRA_BATCH_SIZE, session.backlogCount)} more`;
					}
					return;
				}

				emptyEl.hidden = true;
				completeEl.hidden = true;
				stageEl.hidden = false;
				revealed = false;
				frontActionsEl.hidden = false;
				backEl.hidden = true;

				const position = Math.min(session.completedCount + 1, session.initialBatchSize);
				const backlogLabel =
					session.backlogCount > 0 ? ` · ${session.backlogCount} more in backlog` : "";
				progressEl.textContent = `Card ${position} of ${session.initialBatchSize}${backlogLabel}`;

				const cardData = deck[current.problemKey];
				cardIdEl.textContent = cardData ? `#${cardData.id}` : current.slug;
				requeueBadgeEl.hidden = !session.requeuedKeys.includes(current.problemKey);
				cardTitleEl.textContent = cardData?.title ?? current.title;

				cardPromptEl.innerHTML = "";
				if (cardData?.promptHtml) {
					cardPromptEl.innerHTML = cardData.promptHtml;
				} else if (cardData?.promptText) {
					const p = document.createElement("p");
					p.textContent = cardData.promptText;
					cardPromptEl.appendChild(p);
				} else {
					const p = document.createElement("p");
					p.textContent = "Recall the pattern, key invariant, traps, and complexity from memory.";
					cardPromptEl.appendChild(p);
				}
				cardPromptEl.scrollTop = 0;

				backGroupEl.textContent = cardData?.group ?? current.group;
				const diffText = cardData?.difficulty ?? current.difficulty;
				backDiffEl.textContent = diffText;
				backDiffEl.className = `meta-diff ${diffText.toLowerCase()}`;

				const complexity = [cardData?.timeComplexity, cardData?.spaceComplexity]
					.filter(Boolean)
					.join(" · ");
				if (complexity) {
					backComplexityEl.textContent = complexity;
					backComplexityEl.hidden = false;
				} else {
					backComplexityEl.hidden = true;
				}

				backWeakEl.hidden = !isWeakSpot(current);
				backLinkEl.href = cardData?.href ?? this.dataset.problemsUrl ?? "#";
				backPatternEl.textContent = cardData?.pattern ?? current.group;

				backFactsEl.innerHTML = "";
				if (cardData) {
					appendFact("Trigger", cardData.trigger);
					appendFact("Invariant", cardData.invariant);
					if (cardData.domain === "algorithms") {
						appendFact("Top trap", cardData.topTrap, cardData.trapCase);
					} else if (cardData.hints.length > 0) {
						appendFact("Hints", cardData.hints.join(" · "));
					}
				}

				savedNote = current.note ?? "";
				noteInput.value = savedNote;
				showNoteStatus("");
				syncNoteDirty();

				const now = new Date();
				for (const btn of ratingButtons) {
					const q = Number(btn.dataset.quality) as ReviewQuality;
					const preview = btn.querySelector<HTMLElement>("[data-preview]");
					if (preview) {
						preview.textContent = formatIntervalPreview(current, q, now);
					}
					btn.disabled = false;
				}
			};

			const runNoteSave = async (
				target: ReviewRecord,
				snapshot: string
			): Promise<ReviewRecord | null> => {
				const savingKey = target.problemKey;
				noteSaveBtn.disabled = true;
				try {
					const updated = await savePersonalNote(
						{
							domain: target.domain,
							slug: target.slug,
							title: target.title,
							difficulty: target.difficulty,
							group: target.group,
						},
						snapshot
					);
					allRecords = allRecords.map((r) =>
						r.problemKey === updated.problemKey ? updated : r
					);
					if (session.queue[0]?.problemKey === savingKey) {
						session.queue[0] = updated;
						savedNote = updated.note ?? "";
						if (noteInput.value === snapshot) {
							noteInput.value = savedNote;
						}
						syncNoteDirty();
						showNoteStatus(savedNote ? "Saved" : "Cleared");
					}
					window.dispatchEvent(new CustomEvent("mental-gym:progress-updated"));
					return updated;
				} catch {
					if (session.queue[0]?.problemKey === savingKey) {
						showNoteStatus("Could not save", true);
					}
					return null;
				} finally {
					noteSaveBtn.disabled = false;
				}
			};

			const commitNote = async (expectedKey?: string): Promise<ReviewRecord | null> => {
				if (noteSavePromise) {
					if (!expectedKey || activeSaveKey === expectedKey) {
						pendingNoteCommit = true;
					}
					while (noteSavePromise) {
						await noteSavePromise;
					}
				}

				const current = session.queue[0];
				if (!current) return null;
				if (expectedKey && current.problemKey !== expectedKey) {
					return current;
				}

				const snapshot = noteInput.value;
				const trimmed = snapshot.trim();
				if (trimmed === savedNote) {
					noteInput.value = savedNote;
					syncNoteDirty();
					return current;
				}

				activeSaveKey = current.problemKey;
				const currentPromise = runNoteSave(current, snapshot).finally(async () => {
					if (noteSavePromise === currentPromise) {
						noteSavePromise = null;
						activeSaveKey = null;
					}
					if (pendingNoteCommit) {
						pendingNoteCommit = false;
						const active = session.queue[0];
						if (active && (!expectedKey || active.problemKey === expectedKey)) {
							await commitNote(active.problemKey);
						}
					}
				});
				noteSavePromise = currentPromise;
				const updated = await currentPromise;
				while (noteSavePromise) {
					await noteSavePromise;
				}
				return (
					allRecords.find((r) => r.problemKey === current.problemKey) ??
					updated ??
					current
				);
			};

			const reveal = () => {
				if (stageEl.hidden || revealed) return;
				revealed = true;
				frontActionsEl.hidden = true;
				backEl.hidden = false;
			};

			const rateCurrent = async (quality: ReviewQuality) => {
				const current = session.queue[0];
				if (!current || !revealed || isRating || isSpreading) return;
				const currentKey = current.problemKey;
				isRating = true;
				spreadBtn.disabled = true;
				ratingButtons.forEach((btn) => {
					btn.disabled = true;
				});

				try {
					const latestRecord = (await commitNote(currentKey)) ?? current;
					if (session.queue[0]?.problemKey !== currentKey) return;

					const now = new Date();
					const today = localDateISO(now);
					const updated = schedule(latestRecord, quality, { now });
					await putReviewAndEvent(updated, {
						reviewedAt: now.toISOString(),
						reviewDate: today,
						problemKey: updated.problemKey,
						domain: updated.domain,
						group: updated.group,
						rating: quality,
						interval: updated.interval,
					});

					allRecords = allRecords.map((r) =>
						r.problemKey === updated.problemKey ? updated : r
					);
					const nextSession = advanceSession(session, updated, quality);
					for (const key of nextSession.dismissedKeys) {
						sessionDismissedKeys.add(key);
					}
					session = {
						...nextSession,
						overdueCount: countOverdue(allRecords, today),
					};
					window.dispatchEvent(new CustomEvent("mental-gym:progress-updated"));
					renderCurrent();
				} catch {
					ratingButtons.forEach((btn) => {
						btn.disabled = false;
					});
					showNoteStatus("Could not save review", true);
				} finally {
					isRating = false;
					spreadBtn.disabled = false;
				}
			};

			const startBatch = async (cap: number) => {
				try {
					allRecords = await getAllRecords();
					session = createReviewSession(allRecords, {
						today: todayISO(),
						cap,
						excludeKeys: [...sessionDismissedKeys],
					});
					renderCurrent();
				} catch {
					stageEl.hidden = true;
					completeEl.hidden = true;
					spreadBanner.hidden = true;
					emptyHeadingEl.textContent = "Could not load your review queue.";
					emptyCopyEl.textContent =
						"Progress storage may be blocked in another tab or unavailable in this browser.";
					emptyEl.hidden = false;
					progressEl.textContent = "Unavailable";
				}
			};

			revealBtn.addEventListener("click", reveal);

			ratingButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					const q = Number(btn.dataset.quality) as ReviewQuality;
					void rateCurrent(q);
				});
			});

			noteInput.addEventListener("input", () => {
				if (noteStatusEl.textContent) showNoteStatus("");
				syncNoteDirty();
			});

			noteInput.addEventListener("blur", () => {
				void commitNote(session.queue[0]?.problemKey);
			});

			noteInput.addEventListener("keydown", (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key === "Enter") {
					event.preventDefault();
					void commitNote(session.queue[0]?.problemKey);
				}
			});

			noteSaveBtn.addEventListener("click", () => {
				void commitNote(session.queue[0]?.problemKey);
			});

			spreadBtn.addEventListener("click", async () => {
				if (isRating || isSpreading) return;
				isSpreading = true;
				spreadBtn.disabled = true;
				ratingButtons.forEach((btn) => {
					btn.disabled = true;
				});
				try {
					await commitNote(session.queue[0]?.problemKey);
					const today = todayISO();
					const updated = spreadOverdue(allRecords, {
						today,
						days: OVERDUE_SPREAD_DAYS,
					});
					await putRecords(updated);
					window.dispatchEvent(new CustomEvent("mental-gym:progress-updated"));
					await startBatch(DEFAULT_DAILY_CAP);
				} catch {
					ratingButtons.forEach((btn) => {
						btn.disabled = false;
					});
					showNoteStatus("Could not spread overdue cards", true);
				} finally {
					isSpreading = false;
					spreadBtn.disabled = false;
				}
			});

			moreBtn.addEventListener("click", () => {
				void startBatch(EXTRA_BATCH_SIZE);
			});

			this.keyHandler = (event: KeyboardEvent) => {
				if (event.metaKey || event.ctrlKey || event.altKey) return;
				const target = event.target as HTMLElement | null;
				if (
					target &&
					(target.tagName === "TEXTAREA" ||
						target.tagName === "INPUT" ||
						target.tagName === "SELECT" ||
						target.isContentEditable)
				) {
					return;
				}
				if (stageEl.hidden) return;

				if (!revealed && (event.code === "Space" || event.key === " ")) {
					event.preventDefault();
					reveal();
					return;
				}

				if (revealed && ["1", "2", "3", "4"].includes(event.key)) {
					event.preventDefault();
					const quality = (Number(event.key) - 1) as ReviewQuality;
					void rateCurrent(quality);
				}
			};
			window.addEventListener("keydown", this.keyHandler);

			void startBatch(DEFAULT_DAILY_CAP);
		}

		disconnectedCallback() {
			window.clearTimeout(this.statusTimer);
			if (this.keyHandler) {
				window.removeEventListener("keydown", this.keyHandler);
			}
		}
	}

	if (!customElements.get("review-deck")) {
		customElements.define("review-deck", ReviewDeckElement);
	}
</script>

