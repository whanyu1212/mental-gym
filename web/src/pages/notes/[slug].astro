---
import { getCollection, render } from "astro:content";
import ComplexityChart from "../../components/ComplexityChart.astro";
import { withBase } from "../../lib/url";
import SortingChart from "../../components/SortingChart.astro";
import StackDepthChart from "../../components/StackDepthChart.astro";
import LastVisited from "../../components/LastVisited.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const notes = await getCollection("notes");
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Layout title={`${note.data.title} | Mental Gym`} math={true}>
	<nav class="breadcrumb">
		<a href={withBase("/")}>Home</a>
		<span class="sep">›</span>
		<span>{note.data.title}</span>
	</nav>

	{(note.data.status === "wip" || (note.data.tags && note.data.tags.length > 0)) && (
		<div class="note-meta">
			{note.data.status === "wip" && <span class="status">WIP</span>}
			{note.data.tags && note.data.tags.map((tag) => <span class="tag">{tag}</span>)}
		</div>
	)}

	<article class="prose">
		<Content />
		{note.id === "asymptotic-analysis" && (
			<div class="chart-section">
				<h2>Growth Rate Visualised</h2>
				<p class="chart-intro">How the common complexity classes scale as <em>n</em> grows. Note the logarithmic y-axis — O(2ⁿ) and O(n!) shoot off the chart almost immediately.</p>
				<ComplexityChart />
			</div>
		)}
		{note.id === "time-complexity" && (
			<div class="chart-section">
				<h2>Sorting Algorithm Comparison</h2>
				<p class="chart-intro">Best, average, and worst-case time complexity for common sorting algorithms. Quick sort's worst case stands out — it degrades to O(n²) on sorted input without a randomised pivot.</p>
				<SortingChart />
			</div>
		)}
		{note.id === "space-complexity" && (
			<div class="chart-section">
				<h2>Call Stack Depth by Recursion Pattern</h2>
				<p class="chart-intro">Maximum simultaneous stack frames as <em>n</em> grows. The difference between O(log n) and O(n) stack depth becomes critical at large inputs — the latter risks stack overflow.</p>
				<StackDepthChart />
			</div>
		)}
	</article>
	<LastVisited title={note.data.title} kind="Notes" />
</Layout>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--fs-eyebrow);
		color: var(--muted);
		margin-bottom: 2rem;
		font-family: var(--font-sans);
		letter-spacing: 0.04em;
	}

	.breadcrumb a {
		color: var(--muted);
	}

	.breadcrumb a:hover {
		color: var(--accent);
	}

	.sep {
		opacity: 0.4;
	}

	.note-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 1.5rem;
	}

	.status,
	.tag {
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		color: var(--muted);
		font: var(--fs-micro) var(--font-sans);
		letter-spacing: 0.04em;
		padding: 0.2rem 0.55rem;
		text-transform: uppercase;
	}

	.status {
		border-color: color-mix(in srgb, var(--status-medium) 45%, transparent);
		color: var(--status-medium);
		font-weight: 600;
	}

	.chart-section {
		margin-top: 2.5rem;
	}

	.chart-section h2 {
		font-size: var(--fs-xl);
		margin: 0 0 0.75rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
		color: var(--text);
	}

	.chart-intro {
		color: var(--muted);
		font-size: var(--fs-sm);
		margin: 0 0 0.5rem;
		line-height: 1.6;
	}
</style>
