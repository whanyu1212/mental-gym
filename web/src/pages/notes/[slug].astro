---
import { getCollection, render } from "astro:content";
import ComplexityChart from "../../components/ComplexityChart.astro";
import { withBase } from "../../lib/url";
import SortingChart from "../../components/SortingChart.astro";
import StackDepthChart from "../../components/StackDepthChart.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const notes = await getCollection("notes");
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Layout title={`${note.data.title} | Mental Gym`} math={true}>
	<nav class="breadcrumb">
		<a href={withBase("/")}>Home</a>
		<span class="sep">›</span>
		<span>{note.data.title}</span>
	</nav>

	<article class="prose">
		<Content />
		{note.id === "asymptotic-analysis" && (
			<div class="chart-section">
				<h2>Growth Rate Visualised</h2>
				<p class="chart-intro">How the common complexity classes scale as <em>n</em> grows. Note the logarithmic y-axis — O(2ⁿ) and O(n!) shoot off the chart almost immediately.</p>
				<ComplexityChart />
			</div>
		)}
		{note.id === "time-complexity" && (
			<div class="chart-section">
				<h2>Sorting Algorithm Comparison</h2>
				<p class="chart-intro">Best, average, and worst-case time complexity for common sorting algorithms. Quick sort's worst case stands out — it degrades to O(n²) on sorted input without a randomised pivot.</p>
				<SortingChart />
			</div>
		)}
		{note.id === "space-complexity" && (
			<div class="chart-section">
				<h2>Call Stack Depth by Recursion Pattern</h2>
				<p class="chart-intro">Maximum simultaneous stack frames as <em>n</em> grows. The difference between O(log n) and O(n) stack depth becomes critical at large inputs — the latter risks stack overflow.</p>
				<StackDepthChart />
			</div>
		)}
	</article>
</Layout>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		color: var(--muted);
		margin-bottom: 2rem;
		font-family: var(--font-sans);
		letter-spacing: 0.04em;
	}

	.breadcrumb a {
		color: var(--muted);
	}

	.breadcrumb a:hover {
		color: var(--accent);
	}

	.sep {
		opacity: 0.4;
	}

	.chart-section {
		margin-top: 2.5rem;
	}

	.chart-section h2 {
		font-size: 1.25rem;
		margin: 0 0 0.75rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
		color: var(--text);
	}

	.chart-intro {
		color: var(--muted);
		font-size: 0.9rem;
		margin: 0 0 0.5rem;
		line-height: 1.6;
	}
</style>
