---
import { getCollection, render } from "astro:content";
import CodeTabs from "../../components/CodeTabs.astro";
import ComplexityChart from "../../components/ComplexityChart.astro";
import { withBase } from "../../lib/url";
import SortingChart from "../../components/SortingChart.astro";
import StackDepthChart from "../../components/StackDepthChart.astro";
import LastVisited from "../../components/LastVisited.astro";
import NoteHighlighter from "../../components/NoteHighlighter.astro";
import Layout from "../../layouts/Layout.astro";
import { courses, exerciseHref, moduleHref, modules } from "../../data/roadmap";

export async function getStaticPaths() {
	const notes = await getCollection("notes");
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
const course = note.data.courseId ? courses.find((entry) => entry.id === note.data.courseId) : undefined;
const module = note.data.moduleId ? modules.find((entry) => entry.id === note.data.moduleId) : undefined;
const moduleLink = note.data.moduleId ? moduleHref(note.data.moduleId) : undefined;
const relatedExercises = note.data.relatedExercises ?? [];
const kindLabel = note.data.kind === "template"
	? "Template"
	: note.data.kind === "course"
		? "Course note"
		: note.data.kind === "weekly-review"
			? "Weekly review"
			: undefined;
---

<Layout title={`${note.data.title} | Mental Gym`} math={true}>
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href={withBase("/learn/")}>Learn</a>
		<span class="sep">›</span>
		<a href={withBase("/notes/")}>All notes</a>
		<span class="sep">›</span>
		<span>{note.data.title}</span>
	</nav>

	{(kindLabel || note.data.status === "wip" || (note.data.tags && note.data.tags.length > 0)) && (
		<div class="note-meta">
			{kindLabel && <span class="status">{kindLabel}</span>}
			{note.data.status === "wip" && <span class="status">WIP</span>}
			{note.data.tags && note.data.tags.map((tag) => <span class="tag">{tag}</span>)}
		</div>
	)}

	{(course || module || note.data.sourceUrl || relatedExercises.length > 0) && (
		<aside class="note-links" aria-label="Roadmap links">
			{course && (
				<p>
					<span>Course</span>
					<a href={course.url}>{course.code} · {course.title}</a>
					<small>{course.offering}</small>
				</p>
			)}
			{module && moduleLink && (
				<p>
					<span>Module</span>
					<a href={withBase(moduleLink)}>{module.title}</a>
				</p>
			)}
			{note.data.sourceUrl && note.data.sourceUrl !== course?.url && (
				<p>
					<span>Source</span>
					<a href={note.data.sourceUrl}>{note.data.sourceUrl}</a>
				</p>
			)}
			{relatedExercises.length > 0 && (
				<p>
					<span>Related practice</span>
					{relatedExercises.map((exercise) => (
						<a href={withBase(exerciseHref(exercise))}>{exercise.slug}</a>
					))}
				</p>
			)}
		</aside>
	)}

	<article class:list={["prose", { "asymptotic-note": note.id === "asymptotic-analysis" }]}>
		<Content />
		{note.id === "asymptotic-analysis" && (
			<div class="chart-section">
				<h2>Growth Rate Visualised</h2>
				<p class="chart-intro">How the common complexity classes scale as <em>n</em> grows. Note the logarithmic y-axis — O(2ⁿ) and O(n!) shoot off the chart almost immediately.</p>
				<ComplexityChart />
			</div>
		)}
		{note.id === "time-complexity" && (
			<div class="chart-section">
				<h2>Sorting Algorithm Comparison</h2>
				<p class="chart-intro">Best, average, and worst-case time complexity for common sorting algorithms. Quick sort's worst case stands out — it degrades to O(n²) on sorted input without a randomised pivot.</p>
				<SortingChart />
			</div>
		)}
		{note.id === "space-complexity" && (
			<div class="chart-section">
				<h2>Call Stack Depth by Recursion Pattern</h2>
				<p class="chart-intro">Maximum simultaneous stack frames as <em>n</em> grows. The difference between O(log n) and O(n) stack depth becomes critical at large inputs — the latter risks stack overflow.</p>
				<StackDepthChart />
			</div>
		)}
	</article>
	<CodeTabs />
	<NoteHighlighter noteId={note.id} />
	<LastVisited title={note.data.title} kind="Notes" />
</Layout>

<style>
	/* Keep the reading-layout prototype confined to the halving example. */
	.asymptotic-note :global(.halving-example) {
		box-sizing: border-box;
		width: 100%;
		margin: 3rem 0;
		padding: clamp(1rem, 3vw, 2rem);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--bg);
	}
	.asymptotic-note :global(.halving-example .example-eyebrow) {
		margin: 0 0 0.5rem;
		font-size: var(--fs-fine);
		font-weight: 600;
		color: var(--accent);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.asymptotic-note :global(.halving-example h3) {
		margin: 0 0 1rem;
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		line-height: 1.25;
		letter-spacing: -0.02em;
		text-transform: none;
	}
	.asymptotic-note :global(.halving-example h4) {
		margin: 0 0 1.25rem;
		padding: 0;
		border: 0;
		font-size: 1.1rem;
		line-height: 1.4;
	}
	.asymptotic-note :global(.halving-example h5) {
		margin: 0 0 1rem;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--accent);
		font-weight: 600;
	}
	.asymptotic-note :global(.halving-example .example-result),
	.asymptotic-note :global(.halving-example .example-takeaway) {
		padding: 1.25rem;
		background: var(--panel);
		border-radius: var(--radius-sm);
	}
	.asymptotic-note :global(.halving-example .example-result) {
		border-left: 3px solid var(--accent);
		margin: 1.5rem 0 2.5rem;
	}
	.asymptotic-note :global(.halving-example .calculation-step) {
		padding: 1.5rem 0;
		border-top: 1px solid var(--border);
	}
	.asymptotic-note :global(.halving-example .example-takeaway) {
		margin-top: 1rem;
	}
	.asymptotic-note :global(.halving-example .katex-display) {
		max-width: 100%;
		margin: 1.25rem 0;
		padding: 0.5rem 0;
	}
	.asymptotic-note :global(.halving-example table) {
		display: table;
		font-size: var(--fs-sm);
	}
	.asymptotic-note :global(.halving-example th) {
		font-size: var(--fs-sm);
		text-transform: none;
		letter-spacing: normal;
	}
	.asymptotic-note :global(.halving-example td),
	.asymptotic-note :global(.halving-example th) {
		padding: 0.65rem 0.75rem;
	}
	.asymptotic-note :global(.halving-example .calculation-step > :last-child),
	.asymptotic-note :global(.halving-example .example-result > :last-child),
	.asymptotic-note :global(.halving-example .example-takeaway > :last-child) {
		margin-bottom: 0;
	}
	@media (max-width: 540px) {
		.asymptotic-note :global(.halving-example) {
			padding: 1rem 0;
			border-right: 0;
			border-left: 0;
			border-radius: 0;
		}
		.asymptotic-note :global(.halving-example pre) {
			padding: 1rem;
		}
		.asymptotic-note :global(.halving-example td),
		.asymptotic-note :global(.halving-example th) {
			padding: 0.5rem;
		}
		.asymptotic-note :global(.halving-example .katex-display) {
			font-size: 0.9em;
		}
	}

	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--fs-eyebrow);
		color: var(--muted);
		margin-bottom: 2rem;
		font-family: var(--font-sans);
		letter-spacing: 0.04em;
	}

	.breadcrumb a {
		color: var(--muted);
	}

	.breadcrumb a:hover {
		color: var(--accent);
	}

	.sep {
		opacity: 0.4;
	}

	.note-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 1.5rem;
	}

	.status,
	.tag {
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		color: var(--muted);
		font: var(--fs-micro) var(--font-sans);
		letter-spacing: 0.04em;
		padding: 0.2rem 0.55rem;
		text-transform: uppercase;
	}

	.status {
		border-color: color-mix(in srgb, var(--status-medium) 45%, transparent);
		color: var(--status-medium);
		font-weight: 600;
	}

	.note-links {
		display: grid;
		gap: 0.85rem;
		margin: 0 0 2rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--panel);
	}

	.note-links p {
		display: grid;
		gap: 0.2rem;
		margin: 0;
	}

	.note-links span {
		color: var(--muted);
		font: 600 var(--fs-micro) var(--font-sans);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.note-links a {
		color: var(--text);
	}

	.note-links a:hover {
		color: var(--accent);
	}

	.note-links small {
		color: var(--muted);
		font-size: var(--fs-sm);
	}

	.chart-section {
		margin-top: 2.5rem;
	}

	.chart-section h2 {
		font-size: var(--fs-xl);
		margin: 0 0 0.75rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
		color: var(--text);
	}

	.chart-intro {
		color: var(--muted);
		font-size: var(--fs-sm);
		margin: 0 0 0.5rem;
		line-height: 1.6;
	}
</style>
