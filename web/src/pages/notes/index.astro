---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { withBase } from "../../lib/url";
import { learningLanguages } from "../../data/learningTracks";
import { readingTimeMinutes } from "../../lib/readingTime";
import ResumeRow from "../../components/ResumeRow.astro";
import { courses, moduleHref, modules, noteCourseId } from "../../data/roadmap";

const languageOptions = learningLanguages;
const languageIds = new Set<string>(languageOptions.map((language) => language.id));
const published = (await getCollection("notes")).filter((note) => note.data.category !== "Meta");
const templateNotes = published.filter((note) => note.data.kind === "template");
const allNotes = published.filter((note) => note.data.kind !== "template");
const linkedNotes = allNotes.filter((note) => note.data.courseId || note.data.moduleId);

const moduleById = new Map(modules.map((module) => [module.id, module]));
const notesByCourse = courses
	.map((course) => ({
		course,
		notes: linkedNotes.filter((note) => noteCourseId(note.data) === course.id),
	}))
	.filter((group) => group.notes.length > 0);
const ungroupedLinkedNotes = linkedNotes.filter((note) => !noteCourseId(note.data));

// Explicit, pedagogical category order (foundational → reusable → reference),
// mirroring ALGO_GROUP_ORDER in problems/index.astro. Any category not listed
// here falls through to the end, alphabetically, so new categories never vanish.
const CATEGORY_ORDER = ["Complexity", "Patterns", "Languages"];
const presentCategories = [...new Set(allNotes.map((note) => note.data.category))];
const categories = [
	...CATEGORY_ORDER.filter((c) => presentCategories.includes(c)),
	...presentCategories.filter((c) => !CATEGORY_ORDER.includes(c)).sort(),
];
const notesByCategory = categories.map((category) => ({
	name: category,
	notes: allNotes
		.filter((note) => note.data.category === category)
		.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title)),
}));
---

<Layout title="All notes | Mental Gym">
	<section class="hero">
		<a class="back-link" href={withBase("/learn/")}>← Learning tracks</a>
		<h1>All notes</h1>
		<p class="tagline">Theoretical concepts, algorithmic patterns, and language-specific tips.</p>
	</section>

	<ResumeRow />

	<div class="notes-container" data-notes-library>
		<fieldset class="language-filter" data-language-filter hidden>
			<legend>Filter notes by language</legend>
			<div class="language-options">
				<label>
					<input type="radio" name="notes-language" value="all" checked />
					<span>All languages</span>
				</label>
				{languageOptions.map((language) => (
					<label>
						<input
							type="radio"
							name="notes-language"
							value={language.id}
							data-language-name={language.name}
							data-learn-href={withBase(`/learn/${language.id}/`)}
						/>
						<span>{language.name}</span>
					</label>
				))}
			</div>
			<p class="filter-summary" data-filter-summary aria-live="polite"></p>
			<p class="filter-help">Course overview and templates appear under All languages. Linked course notes remain in the category results while filtering.</p>
		</fieldset>
		{(notesByCourse.length > 0 || ungroupedLinkedNotes.length > 0) && (
			<section class="linked-section" data-unfiltered-only>
				<h2 class="category-heading">
					<span class="category-name">By course / module</span>
					<span class="category-count">{linkedNotes.length}</span>
				</h2>
				<p class="linked-copy">Authored notes that declare a roadmap course or module. Templates and private weekly reviews are not mixed in here.</p>
				{notesByCourse.map(({ course, notes }) => (
					<div class="course-group">
						<h3 class="course-heading">{course.code} · {course.title}</h3>
						<ul class="linked-list">
							{notes.map((note) => {
								const module = note.data.moduleId ? moduleById.get(note.data.moduleId) : undefined;
								const href = note.data.moduleId ? moduleHref(note.data.moduleId) : undefined;
								return (
									<li>
										<a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a>
										{module && href && (
											<a class="module-link" href={withBase(href)}>{module.title}</a>
										)}
									</li>
								);
							})}
						</ul>
					</div>
				))}
				{ungroupedLinkedNotes.length > 0 && (
					<div class="course-group">
						<h3 class="course-heading">Module only</h3>
						<ul class="linked-list">
							{ungroupedLinkedNotes.map((note) => {
								const module = note.data.moduleId ? moduleById.get(note.data.moduleId) : undefined;
								const href = note.data.moduleId ? moduleHref(note.data.moduleId) : undefined;
								return (
									<li>
										<a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a>
										{module && href && (
											<a class="module-link" href={withBase(href)}>{module.title}</a>
										)}
									</li>
								);
							})}
						</ul>
					</div>
				)}
			</section>
		)}
		{notesByCategory.map((category) => (
			<section class="category-section" data-note-category>
				<h2 class="category-heading">
					<span class="category-name">{category.name}</span>
					<span class="category-count" data-category-count>{category.notes.length}</span>
				</h2>
				<div class="notes-grid">
					{category.notes.map((note) => {
						const noteLanguages = (note.data.tags ?? [])
							.map((tag) => tag.toLowerCase())
							.filter((tag) => languageIds.has(tag));
						return (
							<a
								href={withBase(`/notes/${note.id}/`)}
								class="note-card"
								data-note-card
								data-languages={noteLanguages.join(" ")}
							>
								<div class="note-content">
									<div class="note-heading">
										<h3 class="note-title">{note.data.title}</h3>
										{note.data.status === "wip" && <span class="status">WIP</span>}
									</div>
									{note.data.description && <p class="note-description">{note.data.description}</p>}
									{note.data.tags && note.data.tags.length > 0 && (
										<ul class="tag-list" aria-label="Topics">
											{note.data.tags.map((tag) => <li>{tag}</li>)}
										</ul>
									)}
								</div>
								<div class="note-footer">
									<span class="read-time">{readingTimeMinutes(note.body)} min read</span>
									<span class="read-more">Read note <span class="arrow">→</span></span>
								</div>
							</a>
						);
					})}
				</div>
			</section>
		))}
		<section class="empty-state" data-language-empty hidden>
			<h2 data-empty-title>No notes found</h2>
			<p data-empty-copy>There are no notes for this language yet.</p>
			<a data-empty-link href={withBase("/learn/julia/")}>Open the learning track</a>
			<button type="button" data-reset-language>Show all notes</button>
		</section>
		{templateNotes.length > 0 && (
			<section class="category-section" data-unfiltered-only>
				<h2 class="category-heading">
					<span class="category-name">Templates</span>
					<span class="category-count">{templateNotes.length}</span>
				</h2>
				<p class="linked-copy">Copy these outlines. They are not study journals and do not record anyone’s hours or attempts.</p>
				<div class="notes-grid">
					{templateNotes
						.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title))
						.map((note) => (
						<a href={withBase(`/notes/${note.id}/`)} class="note-card">
							<div class="note-content">
								<div class="note-heading">
									<h3 class="note-title">{note.data.title}</h3>
									<span class="status">Template</span>
								</div>
								{note.data.description && <p class="note-description">{note.data.description}</p>}
							</div>
							<div class="note-footer">
								<span class="read-time">{readingTimeMinutes(note.body)} min read</span>
								<span class="read-more">Open outline <span class="arrow">→</span></span>
							</div>
						</a>
					))}
				</div>
			</section>
		)}
	</div>
</Layout>

<script>
	const library = document.querySelector<HTMLElement>("[data-notes-library]");
	const filter = library?.querySelector<HTMLFieldSetElement>("[data-language-filter]");

	if (library && filter) {
		const supportedLanguages = new Set([...filter.querySelectorAll<HTMLInputElement>("input[data-language-name]")].map(input => input.value));
		const languageInput = (language: string) => filter.querySelector<HTMLInputElement>(`input[value="${language}"]`);
		const requestedLanguage = () => new URLSearchParams(window.location.search).get("language") ?? "all";

		const applyLanguage = (requested: string) => {
			const language = supportedLanguages.has(requested) ? requested : "all";
			const selectedInput = languageInput(language) ?? languageInput("all");
			const languageName = selectedInput?.dataset.languageName ?? "all languages";
			let visibleTotal = 0;

			for (const card of library.querySelectorAll<HTMLElement>("[data-note-card]")) {
				const languages = (card.dataset.languages ?? "").split(/\s+/).filter(Boolean);
				const visible = language === "all" || languages.includes(language);
				card.hidden = !visible;
				if (visible) visibleTotal++;
			}

			for (const category of library.querySelectorAll<HTMLElement>("[data-note-category]")) {
				const visibleCount = [...category.querySelectorAll<HTMLElement>("[data-note-card]")].filter((card) => !card.hidden).length;
				const count = category.querySelector("[data-category-count]");
				if (count) count.textContent = String(visibleCount);
				category.hidden = visibleCount === 0;
			}

			for (const section of library.querySelectorAll<HTMLElement>("[data-unfiltered-only]")) {
				section.hidden = language !== "all";
			}

			for (const input of filter.querySelectorAll<HTMLInputElement>('input[name="notes-language"]')) {
				input.checked = input === selectedInput;
			}

			const summary = filter.querySelector("[data-filter-summary]");
			if (summary) {
				summary.textContent = language === "all"
					? `${visibleTotal} notes in the library`
					: `${visibleTotal} ${languageName} ${visibleTotal === 1 ? "note" : "notes"}`;
			}

			const emptyState = library.querySelector<HTMLElement>("[data-language-empty]");
			if (emptyState) {
				emptyState.hidden = visibleTotal !== 0;
				const title = emptyState.querySelector("[data-empty-title]");
				const copy = emptyState.querySelector("[data-empty-copy]");
				const link = emptyState.querySelector<HTMLAnchorElement>("[data-empty-link]");
				if (title) title.textContent = `No ${languageName} notes found`;
				if (copy) copy.textContent = `No notes match this language filter. Explore the ${languageName} learning track or return to the full library.`;
				if (link && selectedInput?.dataset.learnHref) {
					link.href = selectedInput.dataset.learnHref;
					link.textContent = `Open the ${languageName} learning track`;
				}
			}
		};

		const updateUrl = (language: string) => {
			const url = new URL(window.location.href);
			if (language === "all") url.searchParams.delete("language");
			else url.searchParams.set("language", language);
			window.history.pushState({}, "", url);
		};

		filter.addEventListener("change", (event) => {
			const input = event.target;
			if (!(input instanceof HTMLInputElement) || input.name !== "notes-language") return;
			applyLanguage(input.value);
			updateUrl(input.value);
		});

		library.querySelector("[data-reset-language]")?.addEventListener("click", () => {
			applyLanguage("all");
			updateUrl("all");
			languageInput("all")?.focus();
		});

		window.addEventListener("popstate", () => applyLanguage(requestedLanguage()));
		applyLanguage(requestedLanguage());
		filter.hidden = false;
	}
</script>

<style>
	[hidden] {
		display: none !important;
	}

	.hero {
		text-align: center;
		padding: 3.5rem 1rem 2.5rem;
	}

	.hero h1 {
		font-size: var(--fs-hero);
		margin: 0;
		color: var(--accent);
		font-family: var(--font-serif);
		font-weight: 600;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--muted);
		font: 600 var(--fs-sm) var(--font-sans);
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.tagline {
		font-size: var(--fs-xl);
		color: var(--muted);
		margin-top: 0.5rem;
		font-family: var(--font-serif);
		font-style: italic;
	}

	.notes-container {
		max-width: 100%;
		margin: 0 auto;
		padding: 0 1.5rem 5rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.language-filter {
		margin: 0;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--glass-surface);
	}

	.language-filter legend {
		padding: 0 0.4rem;
		color: var(--text);
		font: 600 var(--fs-sm) var(--font-sans);
	}

	.language-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.language-options label {
		position: relative;
	}

	.language-options input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	.language-options span {
		display: block;
		padding: 0.5rem 0.8rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		color: var(--muted);
		font: 600 var(--fs-sm) var(--font-sans);
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}

	.language-options label:hover span {
		border-color: var(--accent);
		color: var(--text);
	}

	.language-options input:focus-visible + span {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.language-options input:checked + span {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
	}

	.filter-summary,
	.filter-help {
		margin: 0.85rem 0 0;
		font: var(--fs-sm) var(--font-sans);
	}

	.filter-summary {
		color: var(--text);
	}

	.filter-help {
		color: var(--muted);
		line-height: 1.5;
	}

	.empty-state {
		padding: 2.5rem 1.5rem;
		border: 1px dashed var(--border);
		border-radius: var(--radius-md);
		text-align: center;
	}

	.empty-state h2 {
		margin: 0;
		color: var(--text);
		font: 600 var(--fs-h2) var(--font-serif);
	}

	.empty-state p {
		max-width: 36rem;
		margin: 0.75rem auto 1.25rem;
		color: var(--muted);
		line-height: 1.6;
	}

	.empty-state a,
	.empty-state button {
		display: inline-block;
		margin: 0.25rem;
		padding: 0.55rem 0.85rem;
		border: 1px solid var(--accent);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--accent);
		font: 600 var(--fs-sm) var(--font-sans);
		text-decoration: none;
		cursor: pointer;
	}

	.empty-state a:hover,
	.empty-state button:hover {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}

	.linked-copy {
		color: var(--muted);
		font-size: var(--fs-sm);
		line-height: 1.6;
		margin: -0.75rem 0 1.25rem;
	}

	.course-group + .course-group {
		margin-top: 1.5rem;
	}

	.course-heading {
		font: 600 var(--fs-sm) var(--font-sans);
		margin: 0 0 0.6rem;
		color: var(--text);
	}

	.linked-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}

	.linked-list li {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: baseline;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
		padding: 0.7rem 0;
	}

	.linked-list a {
		color: var(--text);
		text-decoration: none;
	}

	.linked-list a:hover {
		color: var(--accent);
	}

	.module-link {
		color: var(--muted) !important;
		font: var(--fs-eyebrow) var(--font-sans);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.category-heading {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: var(--fs-eyebrow);
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--accent);
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-sans);
		font-weight: 600;
	}

	/* Count chip — mirrors .topic-count on the landing page. The negative
	   letter-spacing cancels the heading's 0.2em tracking so the digit isn't
	   pushed off-center inside its chip. */
	.category-count {
		font-size: var(--fs-eyebrow);
		font-weight: 500;
		letter-spacing: 0;
		color: var(--muted);
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		padding: 0.1rem 0.45rem;
	}

	.notes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	.note-card {
		position: relative;
		background: var(--glass-surface);
		border: 1px solid var(--glass-border);
		padding: 1.5rem;
		border-radius: var(--radius-md);
		overflow: hidden;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		backdrop-filter: blur(var(--glass-blur)) saturate(135%);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(135%);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
		transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
	}

	/* Accent edge-bar — mirrors .domain-accent on the landing page. Sits flush
	   to the card's top edge; revealed by the card's overflow:hidden + radius. */
	.note-card::before {
		content: "";
		position: absolute;
		inset: 0 0 auto 0;
		height: 3px;
		background: var(--accent);
		opacity: 0;
		transition: opacity 0.2s;
	}

	.note-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-lg);
	}

	.note-card:hover::before {
		opacity: 1;
	}

	.note-heading {
		display: flex;
		align-items: start;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.note-title {
		margin: 0;
		font-size: var(--fs-xl);
		color: var(--text);
		font-family: var(--font-serif);
		line-height: 1.3;
		flex: 1;
	}

	.status {
		border: 1px solid color-mix(in srgb, var(--status-medium) 45%, transparent);
		border-radius: var(--radius-pill);
		color: var(--status-medium);
		font: 600 var(--fs-micro) var(--font-sans);
		letter-spacing: 0.08em;
		padding: 0.2rem 0.45rem;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.note-description {
		margin: 0;
		font-size: var(--fs-sm);
		color: var(--muted);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}

	.tag-list li {
		background: color-mix(in srgb, var(--accent) 9%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
		border-radius: var(--radius-pill);
		color: var(--muted);
		font: var(--fs-micro) var(--font-sans);
		letter-spacing: 0.04em;
		padding: 0.18rem 0.5rem;
	}

	.note-footer {
		margin-top: 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: var(--fs-eyebrow);
		font-weight: 600;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* Reading time — quiet metadata, not a call to action, so it stays muted
	   and un-bolded against the accent "Read note" affordance opposite it. */
	.read-time {
		color: var(--muted);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.arrow {
		opacity: 0;
		transition: opacity 0.15s, transform 0.2s;
	}

	.note-card:hover .arrow {
		opacity: 1;
		transform: translateX(4px);
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 2.5rem;
		}

		.language-options {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.language-options span {
			text-align: center;
		}

		.notes-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
