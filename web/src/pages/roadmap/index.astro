---
import RoadmapPlan from "../../components/roadmap/RoadmapPlan.astro";
import TrackChooser from "../../components/roadmap/TrackChooser.astro";
import { courses } from "../../data/roadmap";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="AI Engineering Roadmap | Mental Gym">
	<section class="hero">
		<p class="eyebrow">Six-month roadmap</p>
		<h1>Choose a path. Build evidence every week.</h1>
		<p>
			Eight shared foundation weeks lead into role-specific study and a capstone. Every week keeps required work within a 15-hour budget.
		</p>
	</section>

	<RoadmapPlan />

	<section class="evidence" aria-labelledby="evidence-title">
		<div class="section-heading">
			<p class="eyebrow">Evidence over activity</p>
			<h2 id="evidence-title">Every week ends with something inspectable</h2>
			<p>Each week lists a deliverable and the evidence to keep. Good evidence covers four steps.</p>
		</div>
		<ol>
			<li><span>01 · Source</span><h3>Implement</h3><p>Versioned code, explicit constraints, and reproducible commands.</p></li>
			<li><span>02 · Checks</span><h3>Validate</h3><p>Tests, baselines, metrics, and failure-focused examples.</p></li>
			<li><span>03 · Recall</span><h3>Explain</h3><p>Independent reasoning, delayed recall, and clear trade-offs.</p></li>
			<li><span>04 · Project</span><h3>Apply</h3><p>A bounded deliverable tied to a real system or user outcome.</p></li>
		</ol>
	</section>

	<section class="tracks">
		<div class="section-heading">
			<p class="eyebrow">Four paths</p>
			<h2>Select your primary outcome</h2>
			<p>All paths share the same foundation. Choose one specialization rather than expanding the weekly workload.</p>
		</div>
		<TrackChooser />
	</section>

	<section class="course-notes">
		<p class="eyebrow">Course sources</p>
		<h2>Versioned and honest about access</h2>
		<div>
			{courses.map((course) => (
				<article>
					<a href={course.url}>{course.code} · {course.title}</a>
					<p>{course.offering}</p>
					<small>{course.accessNotes} {course.computeNotes}</small>
				</article>
			))}
		</div>
	</section>
</Layout>

<style>
	.hero {
		max-width: 760px;
		padding: 3.5rem 0 2.5rem;
	}

	.eyebrow,
	.evidence li span {
		color: var(--accent);
		font: 600 var(--fs-eyebrow) var(--font-sans);
		letter-spacing: 0.13em;
		margin: 0;
		text-transform: uppercase;
	}

	h1,
	h2 {
		font-family: var(--font-serif);
		font-weight: 600;
	}

	h1 {
		font-size: var(--fs-mega);
		line-height: 1;
		margin: 0.5rem 0 1rem;
	}

	.hero > p:last-child,
	.section-heading > p:last-child {
		color: var(--muted);
		font: var(--fs-lg) / 1.6 var(--font-sans);
		margin: 0;
	}

	.evidence {
		margin-bottom: 3.5rem;
	}

	.evidence ol {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.evidence li,
	.course-notes article {
		background: var(--glass-surface);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
		padding: 1.25rem;
	}

	.evidence h3 {
		font: 600 var(--fs-xl) var(--font-serif);
		margin: 0.6rem 0 0.4rem;
	}

	.evidence li p,
	.course-notes p,
	.course-notes small {
		color: var(--muted);
		font: var(--fs-sm) / 1.55 var(--font-sans);
		margin: 0;
	}

	.section-heading {
		margin-bottom: 1.25rem;
		max-width: 720px;
	}

	.section-heading h2,
	.course-notes h2 {
		font-size: var(--fs-h2);
		margin: 0.35rem 0 0.45rem;
	}

	.section-heading > p:last-child {
		font-size: var(--fs-sm);
	}

	.course-notes {
		margin-top: 3.5rem;
	}

	.course-notes > div {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.course-notes a {
		color: var(--text);
		font: 600 var(--fs-base) var(--font-serif);
	}

	.course-notes small {
		display: block;
		font-size: var(--fs-fine);
		margin-top: 0.5rem;
	}

	@media (max-width: 900px) {
		.evidence ol {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.evidence ol,
		.course-notes > div {
			grid-template-columns: 1fr;
		}
	}
</style>
