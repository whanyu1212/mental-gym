---
import TrackChooser from "../../components/roadmap/TrackChooser.astro";
import WeekCard from "../../components/roadmap/WeekCard.astro";
import { modulesForTrack, tracks, type RoadmapTrack } from "../../data/roadmap";
import Layout from "../../layouts/Layout.astro";
import { withBase } from "../../lib/url";

export function getStaticPaths() {
	return tracks.map((track) => ({
		params: { track: track.id },
		props: { track },
	}));
}

interface Props {
	track: RoadmapTrack;
}

const { track } = Astro.props;
const scheduledModules = modulesForTrack(track);
const foundationModules = scheduledModules.slice(0, 8);
const specializationModules = scheduledModules.slice(8, 20);
const capstoneModules = scheduledModules.slice(20);
---

<Layout title={`${track.title} Roadmap | Mental Gym`}>
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href={withBase("/roadmap/")}>Roadmap</a>
		<span aria-hidden="true">›</span>
		<span>{track.title}</span>
	</nav>

	<section class="hero">
		<p class="eyebrow">Roadmap · {track.shortTitle}</p>
		<h1>{track.title}</h1>
		<p>{track.description} {track.audience}</p>
		<div class="meta">
			<span>24 weeks</span>
			<span>15 hours / week</span>
			<span>Shared foundation</span>
		</div>
	</section>

	<nav class="week-nav" aria-label="Roadmap weeks">
		{scheduledModules.map((module, index) => (
			<a
				href={`#week-${index + 1}`}
				title={`Week ${index + 1}: ${module.title}`}
				class:list={{
					specialization: index === 8,
					capstone: index === 20,
				}}
			>
				{String(index + 1).padStart(2, "0")}
			</a>
		))}
	</nav>

	<section class="phase" id="foundation">
		<div class="phase-heading">
			<p class="eyebrow">Weeks 1–8</p>
			<h2>Shared engineering foundation</h2>
			<p>Every path begins with the same core. Track-specific weeks build on these stable module IDs without copying the foundation.</p>
		</div>
		<div class="weeks">
			{foundationModules.map((module, index) => <WeekCard module={module} week={index + 1} />)}
		</div>
	</section>

	<section class="phase" id="specialization">
		<div class="phase-heading">
			<p class="eyebrow">Weeks 9–20</p>
			<h2>{track.shortTitle} specialization</h2>
			<p>Twelve focused weeks connect selected course material to implementations, interview practice, and concrete weekly evidence.</p>
		</div>
		<div class="weeks">
			{specializationModules.map((module, index) => <WeekCard module={module} week={index + 9} />)}
		</div>
	</section>

	<section class="phase" id="capstone">
		<div class="phase-heading">
			<p class="eyebrow">Weeks 21–24</p>
			<h2>Capstone and interview evidence</h2>
			<p>Scope, build, evaluate, and explain one bounded project without exceeding the weekly budget.</p>
		</div>
		<div class="weeks">
			{capstoneModules.map((module, index) => <WeekCard module={module} week={index + 21} />)}
		</div>
	</section>

	<section class="adapt-plan">
		<p class="eyebrow">Adapt without expanding</p>
		<h2>Change the sequence, not the 15-hour budget</h2>
		<div>
			<article>
				<h3>Switch tracks</h3>
				<p>Keep completed foundation weeks. Start the new specialization at its first unmet prerequisite; do not complete both specializations in parallel.</p>
			</article>
			<article>
				<h3>Defer a week</h3>
				<p>Move its required deliverable into a future week by replacing equivalent work. Optional stretch work is dropped first, never carried as debt.</p>
			</article>
		</div>
	</section>

	<section class="switch-track">
		<p class="eyebrow">Compare paths</p>
		<h2>Choose a different specialization</h2>
		<p>The first eight weeks remain shared, so changing direction does not duplicate completed foundation work.</p>
		<TrackChooser activeTrackId={track.id} />
	</section>
</Layout>

<style>
	.breadcrumb {
		align-items: center;
		color: var(--muted);
		display: flex;
		font: var(--fs-fine) var(--font-sans);
		gap: 0.4rem;
		margin-top: 1rem;
	}

	.breadcrumb a {
		color: var(--muted);
	}

	.hero {
		max-width: 760px;
		padding: 2.8rem 0 2rem;
	}

	.eyebrow {
		color: var(--accent);
		font: 600 var(--fs-eyebrow) var(--font-sans);
		letter-spacing: 0.13em;
		margin: 0;
		text-transform: uppercase;
	}

	h1,
	h2 {
		font-family: var(--font-serif);
		font-weight: 600;
	}

	h1 {
		font-size: var(--fs-mega);
		line-height: 1;
		margin: 0.5rem 0 0.8rem;
	}

	.hero > p:not(.eyebrow),
	.phase-heading > p:last-child,
	.adapt-plan article p,
	.switch-track > p {
		color: var(--muted);
		font: var(--fs-base) / 1.65 var(--font-sans);
		margin: 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.meta span {
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		color: var(--muted);
		font: var(--fs-fine) var(--font-sans);
		padding: 0.25rem 0.65rem;
	}

	.week-nav {
		background: color-mix(in srgb, var(--glass-surface-strong) 92%, transparent);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-pill);
		display: flex;
		gap: 0.35rem;
		overflow-x: auto;
		padding: 0.45rem;
		position: sticky;
		scrollbar-width: none;
		top: 60px;
		z-index: 5;
	}

	.week-nav::-webkit-scrollbar {
		display: none;
	}

	.week-nav a {
		border-radius: var(--radius-pill);
		color: var(--muted);
		flex: 0 0 auto;
		font: 600 var(--fs-fine) var(--font-mono);
		padding: 0.35rem 0.65rem;
		text-decoration: none;
	}

	.week-nav a:hover,
	.week-nav a:focus-visible {
		background: var(--accent-soft);
		color: var(--accent);
	}

	.week-nav a.specialization,
	.week-nav a.capstone {
		margin-left: 0.55rem;
		position: relative;
	}

	.week-nav a.specialization::before,
	.week-nav a.capstone::before {
		background: var(--border);
		content: "";
		height: 1.4rem;
		left: -0.47rem;
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 1px;
	}

	.phase,
	.adapt-plan,
	.switch-track {
		margin-top: 3rem;
	}

	.phase-heading,
	.switch-track {
		max-width: 760px;
	}

	.phase-heading {
		margin-bottom: 1.2rem;
	}

	.phase-heading h2,
	.adapt-plan h2,
	.switch-track h2 {
		font-size: var(--fs-h2);
		margin: 0.35rem 0 0.45rem;
	}

	.phase-heading > p:last-child,
	.adapt-plan article p,
	.switch-track > p {
		font-size: var(--fs-sm);
	}

	.weeks {
		display: grid;
		gap: 1.25rem;
	}

	.adapt-plan {
		background: var(--glass-surface);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
		padding: 1.5rem;
	}

	.adapt-plan > div {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-top: 1rem;
	}

	.adapt-plan article {
		border-top: 1px solid var(--border);
		padding-top: 0.9rem;
	}

	.adapt-plan h3 {
		font: 600 var(--fs-xl) var(--font-serif);
		margin: 0 0 0.35rem;
	}

	.switch-track {
		max-width: none;
	}

	.switch-track > p {
		margin-bottom: 1.2rem;
		max-width: 720px;
	}

	@media (max-width: 620px) {
		.adapt-plan > div {
			grid-template-columns: 1fr;
		}
	}
</style>
