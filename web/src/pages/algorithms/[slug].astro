---
import { Code } from "astro:components";
import { problems } from "../../data/problems";
import TwoSumAnimation from "../../components/TwoSumAnimation.astro";
import SortColorsAnimation from "../../components/SortColorsAnimation.astro";
import LongestSubstringAnimation from "../../components/LongestSubstringAnimation.astro";
import BuySellStockAnimation from "../../components/BuySellStockAnimation.astro";
import RPNAnimation from "../../components/RPNAnimation.astro";
import TrappingRainWaterAnimation from "../../components/TrappingRainWaterAnimation.astro";
import ValidSudokuAnimation from "../../components/ValidSudokuAnimation.astro";
import ContainerWithMostWaterAnimation from "../../components/ContainerWithMostWaterAnimation.astro";
import ValidPalindromeAnimation from "../../components/ValidPalindromeAnimation.astro";
import ValidParenthesesAnimation from "../../components/ValidParenthesesAnimation.astro";
import ThreeSumAnimation from "../../components/ThreeSumAnimation.astro";
import MinStackAnimation from "../../components/MinStackAnimation.astro";
import TwoSumIIAnimation from "../../components/TwoSumIIAnimation.astro";
import ProductExceptSelfAnimation from "../../components/ProductExceptSelfAnimation.astro";
import CharacterReplacementAnimation from "../../components/CharacterReplacementAnimation.astro";
import PermutationInStringAnimation from "../../components/PermutationInStringAnimation.astro";
import ContainsDuplicateAnimation from "../../components/ContainsDuplicateAnimation.astro";
import ValidAnagramAnimation from "../../components/ValidAnagramAnimation.astro";
import ConcatenationOfArrayAnimation from "../../components/ConcatenationOfArrayAnimation.astro";
import LongestCommonPrefixAnimation from "../../components/LongestCommonPrefixAnimation.astro";
import MajorityElementAnimation from "../../components/MajorityElementAnimation.astro";
import MajorityElementIIAnimation from "../../components/MajorityElementIIAnimation.astro";
import GroupAnagramsAnimation from "../../components/GroupAnagramsAnimation.astro";
import LongestConsecutiveSequenceAnimation from "../../components/LongestConsecutiveSequenceAnimation.astro";
import EncodeDecodeStringsAnimation from "../../components/EncodeDecodeStringsAnimation.astro";
import TopKFrequentElementsAnimation from "../../components/TopKFrequentElementsAnimation.astro";
import RangeSumQuery2DImmutableAnimation from "../../components/RangeSumQuery2DImmutableAnimation.astro";
import SlidingWindowMaximumAnimation from "../../components/SlidingWindowMaximumAnimation.astro";
import MergeTwoSortedListsAnimation from "../../components/MergeTwoSortedListsAnimation.astro";
import DesignHashSetAnimation from "../../components/DesignHashSetAnimation.astro";
import DesignHashMapAnimation from "../../components/DesignHashMapAnimation.astro";
import SortAnArrayAnimation from "../../components/SortAnArrayAnimation.astro";
import RecallRating from "../../components/RecallRating.astro";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
	return problems.map((problem) => ({
		params: { slug: problem.slug },
		props: { problem },
	}));
}

const { problem } = Astro.props;
const hasJulia = problem.solutions.julia.trim().length > 0;
const animatedSlugs = new Set([
	"1-two-sum",
	"75-sort-colors",
	"3-longest-substring-without-repeating-characters",
	"121-best-time-to-buy-and-sell-stock",
	"150-evaluate-reverse-polish-notation",
	"36-valid-sudoku",
	"42-trapping-rain-water",
	"11-container-with-most-water",
	"125-valid-palindrome",
	"20-valid-parentheses",
	"15-3sum",
	"155-min-stack",
	"167-two-sum-ii-input-array-is-sorted",
	"238-product-of-array-except-self",
	"424-longest-repeating-character-replacement",
	"567-permutation-in-string",
	"217-contains-duplicate",
	"242-valid-anagram",
	"1929-concatenation-of-array",
	"14-longest-common-prefix",
	"169-majority-element",
	"229-majority-element-ii",
	"49-group-anagrams",
	"128-longest-consecutive-sequence",
	"271-encode-and-decode-strings",
	"304-range-sum-query-2d-immutable",
	"347-top-k-frequent-elements",
	"239-sliding-window-maximum",
	"21-merge-two-sorted-lists",
	"705-design-hashset",
	"706-design-hashmap",
	"912-sort-an-array",
]);
const hasAnimation = animatedSlugs.has(problem.slug);
---

<Layout title={`${problem.title} | Mental Gym`}>
	<nav class="breadcrumb">
		<a href="/problems">Problems</a>
		<span class="sep">›</span>
		<a href={`/problems#algo-${problem.group.toLowerCase().replace(/\s+&?\s*/g, "-")}`}
			>{problem.group}</a
		>
		<span class="sep">›</span>
		<span>{problem.title}</span>
	</nav>

	<section class="problem-header">
		<p class="meta">LeetCode #{problem.id}</p>
		<h1>{problem.title}</h1>
		<div class="tags">
			<span class={`badge ${problem.difficulty.toLowerCase()}`}>{problem.difficulty}</span>
			{problem.topics.map((topic: string) => <span class="tag">{topic}</span>)}
			<a class="lc-link" href={problem.sourceUrl} target="_blank" rel="noreferrer">
				View on LeetCode ↗
			</a>
		</div>
	</section>

	<section class="problem-statement">
		<h2 class="section-title">Problem</h2>
		<div class="description" set:html={problem.description} />
	</section>

	<section class="content-switcher">
		<div class="content-tabs" role="tablist" aria-label="Problem detail views">
			{hasAnimation && (
				<button
					class="content-tab active"
					type="button"
					data-view-tab="animation"
					role="tab"
					aria-selected="true"
				>
					Animation
				</button>
			)}
			<button
				class={`content-tab ${!hasAnimation ? "active" : ""}`}
				type="button"
				data-view-tab="solution"
				role="tab"
				aria-selected={hasAnimation ? "false" : "true"}
			>
				Solution
			</button>
		</div>

		{
			hasAnimation && (
				<div class="content-panel" data-view-panel="animation">
					{problem.slug === "1-two-sum" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<TwoSumAnimation />
						</section>
					)}

					{problem.slug === "75-sort-colors" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<SortColorsAnimation />
						</section>
					)}

					{problem.slug === "3-longest-substring-without-repeating-characters" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<LongestSubstringAnimation />
						</section>
					)}

					{problem.slug === "121-best-time-to-buy-and-sell-stock" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<BuySellStockAnimation />
						</section>
					)}

					{problem.slug === "150-evaluate-reverse-polish-notation" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<RPNAnimation />
						</section>
					)}

					{problem.slug === "36-valid-sudoku" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ValidSudokuAnimation />
						</section>
					)}

					{problem.slug === "42-trapping-rain-water" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<TrappingRainWaterAnimation />
						</section>
					)}

					{problem.slug === "11-container-with-most-water" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ContainerWithMostWaterAnimation />
						</section>
					)}

					{problem.slug === "125-valid-palindrome" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ValidPalindromeAnimation />
						</section>
					)}

					{problem.slug === "20-valid-parentheses" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ValidParenthesesAnimation />
						</section>
					)}

					{problem.slug === "15-3sum" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ThreeSumAnimation />
						</section>
					)}

					{problem.slug === "155-min-stack" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<MinStackAnimation />
						</section>
					)}

					{problem.slug === "167-two-sum-ii-input-array-is-sorted" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<TwoSumIIAnimation />
						</section>
					)}

					{problem.slug === "238-product-of-array-except-self" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ProductExceptSelfAnimation />
						</section>
					)}

					{problem.slug === "424-longest-repeating-character-replacement" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<CharacterReplacementAnimation />
						</section>
					)}

					{problem.slug === "567-permutation-in-string" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<PermutationInStringAnimation />
						</section>
					)}

					{problem.slug === "217-contains-duplicate" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ContainsDuplicateAnimation />
						</section>
					)}

					{problem.slug === "242-valid-anagram" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ValidAnagramAnimation />
						</section>
					)}

					{problem.slug === "1929-concatenation-of-array" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<ConcatenationOfArrayAnimation />
						</section>
					)}

					{problem.slug === "14-longest-common-prefix" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<LongestCommonPrefixAnimation />
						</section>
					)}

					{problem.slug === "169-majority-element" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<MajorityElementAnimation />
						</section>
					)}

					{problem.slug === "229-majority-element-ii" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<MajorityElementIIAnimation />
						</section>
					)}

					{problem.slug === "49-group-anagrams" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<GroupAnagramsAnimation />
						</section>
					)}

					{problem.slug === "128-longest-consecutive-sequence" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<LongestConsecutiveSequenceAnimation />
						</section>
					)}

					{problem.slug === "271-encode-and-decode-strings" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<EncodeDecodeStringsAnimation />
						</section>
					)}

					{problem.slug === "304-range-sum-query-2d-immutable" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<RangeSumQuery2DImmutableAnimation />
						</section>
					)}

					{problem.slug === "347-top-k-frequent-elements" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<TopKFrequentElementsAnimation />
						</section>
					)}

					{problem.slug === "239-sliding-window-maximum" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<SlidingWindowMaximumAnimation />
						</section>
					)}

					{problem.slug === "21-merge-two-sorted-lists" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<MergeTwoSortedListsAnimation />
						</section>
					)}

					{problem.slug === "705-design-hashset" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<DesignHashSetAnimation />
						</section>
					)}

					{problem.slug === "706-design-hashmap" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<DesignHashMapAnimation />
						</section>
					)}

					{problem.slug === "912-sort-an-array" && (
						<section class="animation-section">
							<div class="solutions-header">
								<h2 class="section-title">Animation</h2>
							</div>
							<SortAnArrayAnimation />
						</section>
					)}
				</div>
			)
		}

		<div class={`content-panel ${hasAnimation ? "hidden" : ""}`} data-view-panel="solution">
			<section class="solutions">
				<div class="solutions-header">
					<h2 class="section-title">Solutions</h2>
					<p class="blur-hint">Hover to reveal — gives you a moment to think first.</p>
				</div>

				{
					hasJulia && (
						<div class="lang-tab-bar">
							<button class="lang-tab active" data-lang="python">
								<span class="lang-icon lang-icon-python" aria-hidden="true"></span>
								<span>Python</span>
							</button>
							<button class="lang-tab" data-lang="julia">
								<span class="lang-icon lang-icon-julia" aria-hidden="true"></span>
								<span>Julia</span>
							</button>
						</div>
					)
				}

				<div class="code-panels">
					<div class="code-panel" data-lang-panel="python">
						<Code code={problem.solutions.python} lang="python" theme="github-dark" />
					</div>

					{
						hasJulia && (
							<div class="code-panel hidden" data-lang-panel="julia">
								<Code code={problem.solutions.julia} lang="julia" theme="github-dark" />
							</div>
						)
					}
				</div>
			</section>
		</div>
	</section>

	<RecallRating
		domain="algorithms"
		slug={problem.slug}
		title={problem.title}
		difficulty={problem.difficulty}
		group={problem.group}
	/>
</Layout>

<script>
	const viewTabs = document.querySelectorAll<HTMLButtonElement>("[data-view-tab]");
	const viewPanels = document.querySelectorAll<HTMLElement>("[data-view-panel]");

	viewTabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const view = tab.dataset.viewTab;

			viewTabs.forEach((t) => {
				const isActive = t === tab;
				t.classList.toggle("active", isActive);
				t.setAttribute("aria-selected", isActive ? "true" : "false");
			});

			viewPanels.forEach((panel) => {
				panel.classList.toggle("hidden", panel.dataset.viewPanel !== view);
			});
		});
	});

	const langTabs = document.querySelectorAll<HTMLButtonElement>(".lang-tab");
	langTabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const lang = tab.dataset.lang!;
			langTabs.forEach((t) => t.classList.toggle("active", t === tab));
			document.querySelectorAll<HTMLElement>("[data-lang-panel]").forEach((panel) => {
				panel.classList.toggle("hidden", panel.dataset.langPanel !== lang);
			});
		});
	});
</script>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8rem;
		color: var(--muted);
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
		font-family: Inter, system-ui, sans-serif;
		letter-spacing: 0.03em;
	}

	.breadcrumb a {
		color: var(--muted);
	}

	.breadcrumb a:hover {
		color: var(--accent);
	}

	.sep {
		opacity: 0.4;
	}

	.problem-header {
		display: grid;
		gap: 0.6rem;
		margin-bottom: 2rem;
	}

	.meta {
		margin: 0;
		color: var(--muted);
		font-size: 0.8rem;
		font-family: Inter, system-ui, sans-serif;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: 2rem;
		letter-spacing: 0.3px;
		font-family: var(--font-serif);
		font-weight: 600;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}

	.badge,
	.tag {
		font-size: 0.7rem;
		padding: 0.2rem 0.6rem;
		border-radius: 2px;
		border: 1px solid var(--border);
		font-family: Inter, system-ui, sans-serif;
		letter-spacing: 0.04em;
	}

	.easy { color: var(--status-easy); }
	.medium { color: var(--status-medium); }
	.hard { color: var(--status-hard); }

	.tag {
		color: var(--muted);
	}

	.lc-link {
		font-size: 0.78rem;
		color: var(--muted);
		margin-left: 0.25rem;
		font-family: Inter, system-ui, sans-serif;
	}

	.section-title {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--muted);
		font-weight: 600;
		margin: 0 0 1rem;
		font-family: Inter, system-ui, sans-serif;
	}

	.problem-statement {
		background: var(--glass-surface);
		border: 1px solid var(--glass-border);
		border-radius: 10px;
		padding: 1.5rem;
		backdrop-filter: blur(var(--glass-blur)) saturate(135%);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(135%);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
		margin-bottom: 2rem;
	}

	/* Style the raw LeetCode HTML */
	.description :global(p) {
		margin: 0 0 0.75rem;
		line-height: 1.65;
		color: var(--text);
		font-family: Inter, system-ui, sans-serif;
		font-size: 0.93rem;
	}

	.description :global(pre) {
		background: var(--surface-strong);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 0.85rem 1rem;
		overflow-x: auto;
		font-size: 0.85rem;
		line-height: 1.5;
		margin: 0.75rem 0;
	}

	.description :global(code) {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.88em;
		background: var(--accent-dim);
		padding: 0.1em 0.35em;
		border-radius: 2px;
	}

	.description :global(pre code) {
		background: none;
		padding: 0;
		font-size: inherit;
	}

	.description :global(ul),
	.description :global(ol) {
		padding-left: 1.5rem;
		margin: 0.5rem 0;
		font-family: Inter, system-ui, sans-serif;
		font-size: 0.93rem;
	}

	.description :global(li) {
		margin-bottom: 0.3rem;
		line-height: 1.6;
	}

	.description :global(strong) {
		color: var(--text);
		font-weight: 600;
	}

	.description :global(.example) {
		color: var(--accent);
	}

	.solutions {
		margin-bottom: 2rem;
	}

	.solutions-header {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.solutions-header .section-title {
		margin: 0;
	}

	.blur-hint {
		margin: 0;
		font-size: 0.78rem;
		color: var(--muted);
		font-style: italic;
		font-family: Inter, system-ui, sans-serif;
	}

	.code-panels {
		filter: blur(5px);
		transition: filter 0.2s ease;
	}

	.solutions:hover .code-panels {
		filter: blur(0);
	}

	.content-switcher {
		margin-bottom: 2rem;
	}

	.content-tabs,
	.lang-tab-bar {
		display: inline-flex;
		padding: 4px;
		margin-bottom: 1.25rem;
		background: rgba(0, 0, 0, 0.2);
		border-radius: 999px;
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		/* Inner shadow for depth, outer subtle bottom edge to catch light */
		box-shadow:
			inset 0 1px 4px rgba(0, 0, 0, 0.3),
			inset 0 0 0 1px rgba(255, 255, 255, 0.04),
			0 1px 0 rgba(255, 255, 255, 0.06);
	}

	.content-tab,
	.lang-tab {
		position: relative;
		background: transparent;
		border: none;
		color: var(--muted);
		padding: 0.4rem 1.25rem;
		border-radius: 999px;
		cursor: pointer;
		font-size: 0.8rem;
		font-family: Inter, system-ui, sans-serif;
		font-weight: 500;
		letter-spacing: 0.02em;
		transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
		z-index: 1;
	}

	.lang-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.lang-icon {
		width: 0.48rem;
		height: 0.48rem;
		border-radius: 999px;
		display: inline-block;
		flex-shrink: 0;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.22) inset;
	}

	.lang-icon-python {
