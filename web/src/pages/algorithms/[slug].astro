---
import { Code } from "astro:components";
import { problems } from "../../data/problems";
import { withBase } from "../../lib/url";
import TwoSumAnimation from "../../components/TwoSumAnimation.astro";
import SortColorsAnimation from "../../components/SortColorsAnimation.astro";
import LongestSubstringAnimation from "../../components/LongestSubstringAnimation.astro";
import BuySellStockAnimation from "../../components/BuySellStockAnimation.astro";
import RPNAnimation from "../../components/RPNAnimation.astro";
import TrappingRainWaterAnimation from "../../components/TrappingRainWaterAnimation.astro";
import ValidSudokuAnimation from "../../components/ValidSudokuAnimation.astro";
import ContainerWithMostWaterAnimation from "../../components/ContainerWithMostWaterAnimation.astro";
import ValidPalindromeAnimation from "../../components/ValidPalindromeAnimation.astro";
import ValidPalindrome2Animation from "../../components/ValidPalindrome2Animation.astro";
import ThreeSumAnimation from "../../components/ThreeSumAnimation.astro";
import MinStackAnimation from "../../components/MinStackAnimation.astro";
import TwoSumIIAnimation from "../../components/TwoSumIIAnimation.astro";
import ProductExceptSelfAnimation from "../../components/ProductExceptSelfAnimation.astro";
import CharacterReplacementAnimation from "../../components/CharacterReplacementAnimation.astro";
import PermutationInStringAnimation from "../../components/PermutationInStringAnimation.astro";
import ContainsDuplicateAnimation from "../../components/ContainsDuplicateAnimation.astro";
import ValidAnagramAnimation from "../../components/ValidAnagramAnimation.astro";
import ConcatenationOfArrayAnimation from "../../components/ConcatenationOfArrayAnimation.astro";
import LongestCommonPrefixAnimation from "../../components/LongestCommonPrefixAnimation.astro";
import MajorityElementAnimation from "../../components/MajorityElementAnimation.astro";
import MajorityElementIIAnimation from "../../components/MajorityElementIIAnimation.astro";
import GroupAnagramsAnimation from "../../components/GroupAnagramsAnimation.astro";
import LongestConsecutiveSequenceAnimation from "../../components/LongestConsecutiveSequenceAnimation.astro";
import EncodeDecodeStringsAnimation from "../../components/EncodeDecodeStringsAnimation.astro";
import TopKFrequentElementsAnimation from "../../components/TopKFrequentElementsAnimation.astro";
import RangeSumQuery2DImmutableAnimation from "../../components/RangeSumQuery2DImmutableAnimation.astro";
import SlidingWindowMaximumAnimation from "../../components/SlidingWindowMaximumAnimation.astro";
import MergeTwoSortedListsAnimation from "../../components/MergeTwoSortedListsAnimation.astro";
import DesignHashSetAnimation from "../../components/DesignHashSetAnimation.astro";
import DesignHashMapAnimation from "../../components/DesignHashMapAnimation.astro";
import SortAnArrayAnimation from "../../components/SortAnArrayAnimation.astro";
import MaximumSubarrayAnimation from "../../components/MaximumSubarrayAnimation.astro";
import MaximumSumCircularSubarrayAnimation from "../../components/MaximumSumCircularSubarrayAnimation.astro";
import SubarraySumAnimation from "../../components/notes/PrefixSumHashmapViz.astro";
import XorQueriesAnimation from "../../components/notes/PrefixXorViz.astro";
import RecallRating from "../../components/RecallRating.astro";
import LastVisited from "../../components/LastVisited.astro";
import Layout from "../../layouts/Layout.astro";
import { getGuide } from "../../data/algorithmGuides";

export function getStaticPaths() {
	return problems.map((problem) => ({
		params: { slug: problem.slug },
		props: { problem },
	}));
}

const { problem } = Astro.props;
const hasJulia = problem.solutions.julia.trim().length > 0;

// slug → animation component. Replaces the old animatedSlugs Set + ~35
// duplicated `{slug === "…" && <X/>}` branches with a single lookup.
const animationBySlug = {
	"1-two-sum": TwoSumAnimation,
	"75-sort-colors": SortColorsAnimation,
	"3-longest-substring-without-repeating-characters": LongestSubstringAnimation,
	"121-best-time-to-buy-and-sell-stock": BuySellStockAnimation,
	"150-evaluate-reverse-polish-notation": RPNAnimation,
	"36-valid-sudoku": ValidSudokuAnimation,
	"42-trapping-rain-water": TrappingRainWaterAnimation,
	"11-container-with-most-water": ContainerWithMostWaterAnimation,
	"125-valid-palindrome": ValidPalindromeAnimation,
	"680-valid-palindrome-ii": ValidPalindrome2Animation,
	"15-3sum": ThreeSumAnimation,
	"155-min-stack": MinStackAnimation,
	"167-two-sum-ii-input-array-is-sorted": TwoSumIIAnimation,
	"238-product-of-array-except-self": ProductExceptSelfAnimation,
	"424-longest-repeating-character-replacement": CharacterReplacementAnimation,
	"567-permutation-in-string": PermutationInStringAnimation,
	"217-contains-duplicate": ContainsDuplicateAnimation,
	"242-valid-anagram": ValidAnagramAnimation,
	"1929-concatenation-of-array": ConcatenationOfArrayAnimation,
	"14-longest-common-prefix": LongestCommonPrefixAnimation,
	"169-majority-element": MajorityElementAnimation,
	"229-majority-element-ii": MajorityElementIIAnimation,
	"49-group-anagrams": GroupAnagramsAnimation,
	"128-longest-consecutive-sequence": LongestConsecutiveSequenceAnimation,
	"271-encode-and-decode-strings": EncodeDecodeStringsAnimation,
	"304-range-sum-query-2d-immutable": RangeSumQuery2DImmutableAnimation,
	"347-top-k-frequent-elements": TopKFrequentElementsAnimation,
	"239-sliding-window-maximum": SlidingWindowMaximumAnimation,
	"21-merge-two-sorted-lists": MergeTwoSortedListsAnimation,
	"705-design-hashset": DesignHashSetAnimation,
	"706-design-hashmap": DesignHashMapAnimation,
	"912-sort-an-array": SortAnArrayAnimation,
	"53-maximum-subarray": MaximumSubarrayAnimation,
	"918-maximum-sum-circular-subarray": MaximumSumCircularSubarrayAnimation,
	"560-subarray-sum-equals-k": SubarraySumAnimation,
	"1310-xor-queries-of-a-subarray": XorQueriesAnimation,
} as const;

const Animation = animationBySlug[problem.slug as keyof typeof animationBySlug];
const hasAnimation = Boolean(Animation);

const guide = getGuide(problem.slug);
const hasGuide = Boolean(guide);

// Default tab priority: Guide (study material) → Animation → Solution.
const defaultView = hasGuide ? "guide" : hasAnimation ? "animation" : "solution";
---

<Layout title={`${problem.title} | Mental Gym`}>
	<nav class="breadcrumb">
		<a href={withBase("/problems")}>Problems</a>
		<span class="sep">›</span>
		<a href={withBase(`/problems#algo-${problem.group.toLowerCase().replace(/\s+&?\s*/g, "-")}`)}
			>{problem.group}</a
		>
		<span class="sep">›</span>
		<span>{problem.title}</span>
	</nav>

	<section class="problem-header">
		<p class="meta">LeetCode #{problem.id}</p>
		<h1>{problem.title}</h1>
		<div class="tags">
			<span class={`badge ${problem.difficulty.toLowerCase()}`}>{problem.difficulty}</span>
			{problem.topics.map((topic: string) => <span class="tag">{topic}</span>)}
			<a class="lc-link" href={problem.sourceUrl} target="_blank" rel="noreferrer">
				View on LeetCode ↗
			</a>
		</div>
	</section>

	<section class="problem-statement">
		<h2 class="section-title">Problem</h2>
		<div class="prose" set:html={problem.description} />
	</section>

	<section class="content-switcher">
		<div class="content-tabs" role="tablist" aria-label="Problem detail views">
			{hasGuide && (
				<button
					class={`content-tab ${defaultView === "guide" ? "active" : ""}`}
					type="button"
					data-view-tab="guide"
					role="tab"
					aria-selected={defaultView === "guide" ? "true" : "false"}
				>
					Guide
				</button>
			)}
			{hasAnimation && (
				<button
					class={`content-tab ${defaultView === "animation" ? "active" : ""}`}
					type="button"
					data-view-tab="animation"
					role="tab"
					aria-selected={defaultView === "animation" ? "true" : "false"}
				>
					Animation
				</button>
			)}
			<button
				class={`content-tab ${defaultView === "solution" ? "active" : ""}`}
				type="button"
				data-view-tab="solution"
				role="tab"
				aria-selected={defaultView === "solution" ? "true" : "false"}
			>
				Solution
			</button>
		</div>

		{
			hasGuide && guide && (
				<div
					class={`content-panel ${defaultView === "guide" ? "" : "hidden"}`}
					data-view-panel="guide"
				>
					<section class="guide">
						<aside class="guide-sidebar">
							<nav class="guide-toc" data-guide-toc>
								<span class="toc-label">Contents</span>
								<a href="#guide-dissection" class="toc-link active">Dissection</a>
								<a href="#guide-intuition" class="toc-link">Intuition</a>
								<a href="#guide-approach" class="toc-link">Approach</a>
								<a href="#guide-complexity" class="toc-link">Complexity</a>
								<a href="#guide-pitfalls" class="toc-link">Pitfalls</a>
								<a href="#guide-tests" class="toc-link">Tests</a>
								{guide.followUps.length > 0 && <a href="#guide-followups" class="toc-link">Follow-ups</a>}
							</nav>
						</aside>

						<div class="guide-content">
						<div class="guide-card guide-pattern">
							<h2 class="section-title">Pattern</h2>
							<p class="pattern-name">{guide.pattern}</p>
							<ul class="signal-list">
								{guide.recognitionSignals.map((signal) => (
									<li>{signal}</li>
								))}
							</ul>
						</div>

						<div class="guide-card guide-block" id="guide-dissection">
							<h3 class="guide-heading">Dissection</h3>
							<p class="guide-prose guide-prose-dissection">{guide.dissection}</p>
						</div>

						<div class="guide-card guide-block" id="guide-intuition">
							<h3 class="guide-heading">Intuition</h3>
							<p class="guide-prose">{guide.intuition}</p>
							<p class="guide-invariant">
								<span class="invariant-label">Invariant</span>
								{guide.invariant}
							</p>
						</div>

						<div class="guide-card guide-block" id="guide-approach">
							<h3 class="guide-heading">Approach</h3>
							<ol class="approach-list">
								{guide.approachSteps.map((step) => (
									<li><span class="step-text">{step}</span></li>
								))}
							</ol>
						</div>

						<div class="guide-card guide-block" id="guide-complexity">
							<h3 class="guide-heading">Complexity</h3>
							{guide.bruteForce && (
								<div class="complexity-rung complexity-rung-brute">
									<span class="rung-label">Brute force</span>
									<p class="guide-prose">{guide.bruteForce.approach}</p>
									<div class="complexity-row">
										<span class="complexity-chip">
											Time <code>{guide.bruteForce.complexity.time}</code>
										</span>
										<span class="complexity-chip">
											Space <code>{guide.bruteForce.complexity.space}</code>
										</span>
									</div>
									{guide.bruteForce.complexity.note && (
										<p class="complexity-note">{guide.bruteForce.complexity.note}</p>
									)}
								</div>
							)}
							<div class="complexity-rung complexity-rung-optimal">
								{guide.bruteForce && <span class="rung-label">Optimal</span>}
								<div class="complexity-row">
									<span class="complexity-chip">
										Time <code>{guide.complexity.time}</code>
									</span>
									<span class="complexity-chip">
										Space <code>{guide.complexity.space}</code>
									</span>
								</div>
								{guide.complexity.note && <p class="complexity-note">{guide.complexity.note}</p>}
							</div>
							{guide.constraintReasoning && (
								<p class="constraint-reasoning">
									<span class="constraint-label">Reading the constraints</span>
									{guide.constraintReasoning}
								</p>
							)}
						</div>

						<div class="guide-card guide-block" id="guide-pitfalls">
							<h3 class="guide-heading">Pitfalls</h3>
							<ul class="pitfall-list">
								{guide.pitfalls.map((pitfall) => (
									<li><span class="pitfall-icon" aria-hidden="true">!</span><span class="pitfall-text">{pitfall}</span></li>
								))}
							</ul>
						</div>

						<div class="guide-card guide-block" id="guide-tests">
							<h3 class="guide-heading">What to test</h3>
							<ul class="test-list">
								{guide.testCases.map((tc) => (
									<li class={`test-case test-${tc.kind}`}>
										<span class="test-kind">{tc.kind}</span>
										<div class="test-body">
											<div class="test-io-row">
												<code class="test-io">{tc.input} → {tc.expected}</code>
												<button class="copy-btn" data-copy-target={tc.input} type="button" aria-label="Copy input">Copy</button>
											</div>
											<span class="test-note">{tc.note}</span>
										</div>
									</li>
								))}
							</ul>
						</div>

						{guide.followUps.length > 0 && (
							<details class="guide-card guide-block collapsible" id="guide-followups" open>
								<summary class="collapsible-summary">
									<h3 class="guide-heading">Follow-ups</h3>
								</summary>
								<ul class="followup-list">
									{guide.followUps.map((f) => (
										<li>{f}</li>
									))}
								</ul>
							</details>
						)}

						{guide.relatedNotes.length > 0 && (
							<details class="guide-card guide-block collapsible">
								<summary class="collapsible-summary">
									<h3 class="guide-heading">Related notes</h3>
								</summary>
								<div class="related-notes">
									{guide.relatedNotes.map((noteId) => (
										<a class="note-link" href={withBase(`/notes/${noteId}`)}>
											{noteId.replace(/[-_]/g, " ")}
										</a>
									))}
								</div>
							</details>
						)}
						</div>
					</section>
				</div>
			)
		}

		{
			hasAnimation && Animation && (
				<div
					class={`content-panel ${defaultView === "animation" ? "" : "hidden"}`}
					data-view-panel="animation"
				>
					<section class="animation-section">
						<div class="solutions-header">
							<h2 class="section-title">Animation</h2>
						</div>
						<Animation />
					</section>
				</div>
			)
		}

		<div
			class={`content-panel ${defaultView === "solution" ? "" : "hidden"}`}
			data-view-panel="solution"
		>
			<section class="solutions">
				<div class="solutions-header">
					<h2 class="section-title">Solutions</h2>
					<p class="blur-hint">Hover to reveal — gives you a moment to think first.</p>
				</div>

				{
					hasJulia && (
						<div class="lang-tab-bar">
							<button class="lang-tab active" data-lang="python">
								<span class="lang-icon lang-icon-python" aria-hidden="true"></span>
								<span>Python</span>
							</button>
							<button class="lang-tab" data-lang="julia">
								<span class="lang-icon lang-icon-julia" aria-hidden="true"></span>
								<span>Julia</span>
							</button>
						</div>
					)
				}

				<div class="code-panels">
					<div class="code-panel" data-lang-panel="python">
						<Code code={problem.solutions.python} lang="python" theme="github-dark" />
					</div>

					{
						hasJulia && (
							<div class="code-panel hidden" data-lang-panel="julia">
								<Code code={problem.solutions.julia} lang="julia" theme="github-dark" />
							</div>
						)
					}
				</div>
			</section>
		</div>
	</section>

	<RecallRating
		domain="algorithms"
		slug={problem.slug}
		title={problem.title}
		difficulty={problem.difficulty}
		group={problem.group}
	/>
	<LastVisited title={problem.title} kind="Algorithms" />
</Layout>

<script>
	const viewTabs = document.querySelectorAll<HTMLButtonElement>("[data-view-tab]");
	const viewPanels = document.querySelectorAll<HTMLElement>("[data-view-panel]");

	viewTabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const view = tab.dataset.viewTab;

			viewTabs.forEach((t) => {
				const isActive = t === tab;
				t.classList.toggle("active", isActive);
				t.setAttribute("aria-selected", isActive ? "true" : "false");
			});

			viewPanels.forEach((panel) => {
				panel.classList.toggle("hidden", panel.dataset.viewPanel !== view);
			});
		});
	});

	const langTabs = document.querySelectorAll<HTMLButtonElement>(".lang-tab");
	langTabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const lang = tab.dataset.lang!;
			langTabs.forEach((t) => t.classList.toggle("active", t === tab));
			document.querySelectorAll<HTMLElement>("[data-lang-panel]").forEach((panel) => {
				panel.classList.toggle("hidden", panel.dataset.langPanel !== lang);
			});
		});
	});

	// ── Guide: TOC scrollspy ─────────────────────────────────
	const tocLinks = document.querySelectorAll<HTMLAnchorElement>("[data-guide-toc] .toc-link");
	const guideHeadings = document.querySelectorAll<HTMLElement>(".guide-block[id]");

	if (tocLinks.length > 0 && guideHeadings.length > 0) {
		const setActiveToc = (id: string) => {
			tocLinks.forEach((link) => {
				link.classList.toggle("active", link.getAttribute("href") === `#${id}`);
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActiveToc(entry.target.id);
					}
				});
			},
			{
				// Trigger when heading is in the top third of the viewport
				rootMargin: "-20% 0px -60% 0px",
				threshold: 0,
			}
		);

		guideHeadings.forEach((heading) => observer.observe(heading));
	}

	// ── Guide: copy-to-clipboard for test case inputs ────────
	const copyButtons = document.querySelectorAll<HTMLButtonElement>(".copy-btn[data-copy-target]");
	copyButtons.forEach((btn) => {
		btn.addEventListener("click", async () => {
			const text = btn.dataset.copyTarget || "";
			try {
				await navigator.clipboard.writeText(text);
				const originalText = btn.textContent;
				btn.textContent = "Copied!";
				btn.classList.add("copied");
				setTimeout(() => {
					btn.textContent = originalText;
					btn.classList.remove("copied");
				}, 1500);
			} catch {
				// Fallback for older browsers
				const textarea = document.createElement("textarea");
				textarea.value = text;
				textarea.style.position = "fixed";
				textarea.style.opacity = "0";
				document.body.appendChild(textarea);
				textarea.select();
				try {
					document.execCommand("copy");
					btn.textContent = "Copied!";
					btn.classList.add("copied");
					setTimeout(() => {
						btn.textContent = "Copy";
						btn.classList.remove("copied");
					}, 1500);
				} catch {
					// silently fail
				}
				document.body.removeChild(textarea);
			}
		});
	});
</script>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--fs-fine);
		color: var(--muted);
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
		font-family: var(--font-sans);
		letter-spacing: 0.03em;
	}

	.breadcrumb a {
		color: var(--muted);
	}

	.breadcrumb a:hover {
		color: var(--accent);
	}

	.sep {
		opacity: 0.4;
	}

	.problem-header {
		display: grid;
		gap: 0.6rem;
		margin-bottom: 2rem;
	}

	.meta {
		margin: 0;
		color: var(--muted);
		font-size: var(--fs-fine);
		font-family: var(--font-sans);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: var(--fs-h1);
		letter-spacing: 0.3px;
		font-family: var(--font-serif);
		font-weight: 600;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
	}

	.badge,
	.tag {
		font-size: var(--fs-eyebrow);
		padding: 0.2rem 0.7rem;
		border-radius: var(--radius-pill);
		border: 1px solid var(--border);
		font-family: var(--font-sans);
		letter-spacing: 0.04em;
	}

	.badge {
		font-weight: 600;
		text-transform: uppercase;
		font-size: var(--fs-micro);
	}
	.badge.easy {
		color: var(--status-easy);
		border-color: color-mix(in srgb, var(--status-easy) 45%, transparent);
		background: color-mix(in srgb, var(--status-easy) 12%, transparent);
	}
	.badge.medium {
		color: var(--status-medium);
		border-color: color-mix(in srgb, var(--status-medium) 45%, transparent);
		background: var(--accent-soft);
	}
	.badge.hard {
		color: var(--status-hard);
		border-color: color-mix(in srgb, var(--status-hard) 45%, transparent);
		background: color-mix(in srgb, var(--status-hard) 12%, transparent);
	}

	.tag {
		color: var(--muted);
	}

	.lc-link {
		font-size: var(--fs-eyebrow);
		color: var(--muted);
		margin-left: 0.25rem;
		font-family: var(--font-sans);
	}

	.section-title {
		font-size: var(--fs-eyebrow);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--muted);
		font-weight: 600;
		margin: 0 0 1rem;
		font-family: var(--font-sans);
	}

	.problem-statement {
		background: var(--glass-surface);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		padding: 1.5rem;
		backdrop-filter: blur(var(--glass-blur)) saturate(135%);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(135%);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
		margin-bottom: 2rem;
	}

	.solutions {
		margin-bottom: 2rem;
	}

	.solutions-header {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.solutions-header .section-title {
		margin: 0;
	}

	.blur-hint {
		margin: 0;
		font-size: var(--fs-eyebrow);
		color: var(--muted);
		font-style: italic;
		font-family: var(--font-sans);
	}

	.code-panels {
		filter: blur(5px);
		transition: filter 0.2s ease;
	}

	.solutions:hover .code-panels {
		filter: blur(0);
	}

	.content-switcher {
		margin-bottom: 2rem;
	}

	.content-tabs,
	.lang-tab-bar {
		display: inline-flex;
		padding: 4px;
		margin-bottom: 1.25rem;
		background: var(--glass-surface);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-pill);
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
	}

	.content-tab,
	.lang-tab {
		position: relative;
		background: transparent;
		border: none;
		color: var(--muted);
		padding: 0.4rem 1.25rem;
		border-radius: var(--radius-pill);
		cursor: pointer;
