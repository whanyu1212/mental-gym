---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const nums = [100, 4, 200, 1, 3, 2];

const steps = [
  {
    phase: 'init',
    active: -1,
    longest: 0,
    curr: 0,
    chain: [],
    action: 'write',
    exp: 'Insert all numbers into a hash set for O(1) membership checks.',
    reason: 'Consecutive detection depends on fast x-1 and x+1 lookups.',
    invariant: 'Set contains every input value exactly once.',
    formula: 'set.has(x)',
    decision: 'Initialize set and longest = 0.',
    targets: ['set-box', 'longest-box', 'rule-box'],
  },

  {
    phase: 'check',
    active: 100,
    longest: 0,
    curr: 0,
    chain: [],
    start: true,
    action: 'compare',
    exp: 'Check 100: 99 is not in set, so 100 is a sequence start.',
    reason: 'A number starts a sequence only when x-1 does not exist.',
    invariant: 'Only starts launch counting to avoid redundant scans.',
    formula: 'if !set.has(x-1) -> start',
    decision: 'Start counting from 100.',
    targets: ['set-100', 'rule-box'],
  },
  {
    phase: 'count',
    active: 100,
    longest: 1,
    curr: 1,
    chain: [100],
    action: 'expand',
    exp: 'Count sequence from 100: 101 missing, so length is 1.',
    reason: 'No next value means sequence ends immediately.',
    invariant: 'curr equals chain length while expanding.',
    formula: 'while set.has(x+len)',
    decision: 'Update longest to 1.',
    targets: ['set-100', 'chain-box', 'longest-box'],
  },

  {
    phase: 'check',
    active: 4,
    longest: 1,
    curr: 0,
    chain: [],
    start: false,
    action: 'discard',
    exp: 'Check 4: 3 exists, so 4 is not a start. Skip.',
    reason: 'Skipping non-starts avoids recounting same sequence.',
    invariant: 'Each sequence is counted exactly once from its smallest element.',
    formula: 'if set.has(x-1) -> skip',
    decision: 'Do not count from 4.',
    targets: ['set-4'],
  },

  {
    phase: 'check',
    active: 200,
    longest: 1,
    curr: 0,
    chain: [],
    start: true,
    action: 'compare',
    exp: 'Check 200: 199 missing, so 200 is a start.',
    reason: 'Predecessor absence confirms start.',
    invariant: 'Starts define unique sequence entry points.',
    formula: '!set.has(199)',
    decision: 'Start counting from 200.',
    targets: ['set-200'],
  },
  {
    phase: 'count',
    active: 200,
    longest: 1,
    curr: 1,
    chain: [200],
    action: 'expand',
    exp: 'Count from 200: 201 missing, sequence length is 1.',
    reason: 'Single element sequence.',
    invariant: 'Longest remains max(previous, curr).',
    formula: 'longest = max(longest, curr)',
    decision: 'Longest stays 1.',
    targets: ['set-200', 'chain-box', 'longest-box'],
  },

  {
    phase: 'check',
    active: 1,
    longest: 1,
    curr: 0,
    chain: [],
    start: true,
    action: 'compare',
    exp: 'Check 1: 0 missing, so 1 is a start.',
    reason: 'Potential beginning of a longer run.',
    invariant: 'Only start points trigger forward expansion.',
    formula: '!set.has(0)',
    decision: 'Start counting from 1.',
    targets: ['set-1'],
  },
  {
    phase: 'count',
    active: 1,
    longest: 1,
    curr: 1,
    chain: [1],
    action: 'expand',
    exp: 'Found 1. Next value 2 exists, continue.',
    reason: 'Consecutive successor found.',
    invariant: 'Chain stores contiguous values.',
    formula: 'set.has(1+1)',
    decision: 'Extend chain.',
    targets: ['set-1', 'chain-box'],
  },
  {
    phase: 'count',
    active: 2,
    longest: 1,
    curr: 2,
    chain: [1, 2],
    action: 'expand',
    exp: 'Found 2. Next value 3 exists, continue.',
    reason: 'Still consecutive.',
    invariant: 'curr increments by 1 per successful successor.',
    formula: 'set.has(2+1)',
    decision: 'Extend chain.',
    targets: ['set-2', 'chain-box'],
  },
  {
    phase: 'count',
    active: 3,
    longest: 1,
    curr: 3,
    chain: [1, 2, 3],
    action: 'expand',
    exp: 'Found 3. Next value 4 exists, continue.',
    reason: 'Run continues through 4.',
    invariant: 'Chain remains strictly increasing by 1.',
    formula: 'set.has(3+1)',
    decision: 'Extend chain.',
    targets: ['set-3', 'chain-box'],
  },
  {
    phase: 'count',
    active: 4,
    longest: 4,
    curr: 4,
    chain: [1, 2, 3, 4],
    action: 'confirm',
    exp: 'Found 4. Next value 5 missing, run ends at length 4.',
    reason: 'End of maximal consecutive chain from start 1.',
    invariant: 'longest tracks best chain length seen so far.',
    formula: 'longest = max(1, 4) = 4',
    decision: 'Update longest to 4.',
    targets: ['set-4', 'chain-box', 'longest-box'],
  },

  {
    phase: 'check',
    active: 3,
    longest: 4,
    curr: 0,
    chain: [],
    start: false,
    action: 'discard',
    exp: 'Check 3: 2 exists, so skip.',
    reason: 'Not a sequence start.',
    invariant: 'Non-start elements are never recounted.',
    formula: 'set.has(3-1)',
    decision: 'Skip 3.',
    targets: ['set-3'],
  },
  {
    phase: 'check',
    active: 2,
    longest: 4,
    curr: 0,
    chain: [],
    start: false,
    action: 'discard',
    exp: 'Check 2: 1 exists, so skip.',
    reason: 'Not a sequence start.',
    invariant: 'Only minimal value of sequence can start counting.',
    formula: 'set.has(2-1)',
    decision: 'Skip 2.',
    targets: ['set-2'],
  },

  {
    phase: 'done',
    active: -1,
    longest: 4,
    curr: 0,
    chain: [],
    action: 'confirm',
    exp: 'Done! Longest consecutive sequence length is 4.',
    reason: 'Best run found was [1,2,3,4].',
    invariant: 'Result equals maximum run length among all valid starts.',
    formula: 'answer = 4',
    decision: 'Return 4.',
    targets: ['longest-box', 'result-box'],
  },
];
---

<longest-consecutive-visuals>
  <AlgorithmPlayer title="nums = [100, 4, 200, 1, 3, 2]" steps={steps}>
    <div class="stats-row lcs-meta-row">
      <div class="stat-box lcs-rule-box" data-teach-target="rule-box">
        <span class="stat-label">Start Rule</span>
        <span class="stat-val">start if (x-1) not in set</span>
      </div>
      <div class="stat-box lcs-longest-box" data-teach-target="longest-box">
        <span class="stat-label">Longest Sequence</span>
        <span class="stat-val lcs-longest">0</span>
      </div>
      <div class="stat-box lcs-curr-box">
        <span class="stat-label">Current Sequence</span>
        <span class="stat-val lcs-curr">0</span>
      </div>
      <div class="stat-box lcs-result-box" data-teach-target="result-box">
        <span class="stat-label">Status</span>
        <span class="stat-val lcs-status">In Progress</span>
      </div>
    </div>

    <div class="anim-row lcs-chain-wrap">
      <p class="anim-label">Active Sequence Chain</p>
      <div class="array-row lcs-chain" data-teach-target="chain-box"></div>
    </div>

    <div class="anim-row lcs-set-wrap" data-teach-target="set-box">
      <p class="anim-label">Hash Set O(1) Lookups</p>
      <div class="hashmap-row lcs-set">
        {nums.map((num) => (
          <div class="array-cell lcs-set-cell" data-val={num} data-teach-target={`set-${num}`}>
            <span class="cell-val lcs-set-val">{num}</span>
          </div>
        ))}
      </div>
    </div>
  </AlgorithmPlayer>
</longest-consecutive-visuals>

<script>
  class LongestConsecutiveVisuals extends HTMLElement {
    connectedCallback() {
      this.longestEl = this.querySelector('.lcs-longest');
      this.currEl = this.querySelector('.lcs-curr');
      this.statusEl = this.querySelector('.lcs-status');
      this.chainEl = this.querySelector('.lcs-chain');
      this.setCells = Array.from(this.querySelectorAll('.lcs-set-cell'));
      this.resultBox = this.querySelector('.lcs-result-box');
      this.longestBox = this.querySelector('.lcs-longest-box');

      this.addEventListener('step-change', (e) => {
        const s = e.detail.step;

        if (this.longestEl) this.longestEl.textContent = String(s.longest);
        if (this.currEl) this.currEl.textContent = String(s.curr);
        if (this.statusEl) {
          this.statusEl.textContent = s.phase === 'done' ? 'Complete' : 'In Progress';
        }

        this.resultBox?.classList.remove('confirmed');
        this.longestBox?.classList.remove('highlight');
        if (s.phase === 'done') this.resultBox?.classList.add('confirmed');
        if (s.longest > 0) this.longestBox?.classList.add('highlight');

        if (this.chainEl) {
          if (!s.chain || s.chain.length === 0) {
            this.chainEl.innerHTML = "<span class='lcs-empty'>None</span>";
          } else {
            this.chainEl.innerHTML = s.chain
              .map((num, idx) => {
                return `
                  <div class="lcs-chain-node">
                    <div class="array-cell active-chain-cell">
                      <span class="cell-val lcs-chain-val">${num}</span>
                    </div>
                    ${idx < s.chain.length - 1 ? `<span class="lcs-chain-arrow">→</span>` : ''}
                  </div>
                `;
              })
              .join('');
          }
        }

        this.setCells.forEach((cell) => {
          const val = parseInt(cell.dataset.val, 10);
          const valSpan = cell.querySelector('.cell-val');
          if (!valSpan) return;

          valSpan.className = 'cell-val lcs-set-val';

          if (s.phase === 'check' && val === s.active) {
            if (s.start) valSpan.classList.add('active-start');
            else valSpan.classList.add('active-skip');
          } else if (s.phase === 'count' && s.chain.includes(val)) {
            valSpan.classList.add('success-val');
          }
        });
      });
    }
  }

  if (!customElements.get('longest-consecutive-visuals')) {
    customElements.define('longest-consecutive-visuals', LongestConsecutiveVisuals);
  }
</script>

<style>
  longest-consecutive-visuals {
    display: block;
  }

  .lcs-meta-row {
    margin-bottom: 2rem;
  }

  .lcs-rule-box .stat-val {
    color: var(--muted);
    font-size: var(--fs-eyebrow);
  }

  .lcs-curr-box {
    border-color: color-mix(in srgb, var(--status-info) 40%, transparent);
    background: color-mix(in srgb, var(--status-info) 8%, transparent);
  }

  .lcs-curr-box .stat-val {
    color: var(--status-info);
  }

  .lcs-longest-box.highlight {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .lcs-longest-box .stat-val {
    color: var(--accent);
  }

  .lcs-result-box.confirmed {
    border-color: color-mix(in srgb, var(--status-easy) 60%, transparent);
    background: color-mix(in srgb, var(--status-easy) 12%, transparent);
  }

  .lcs-chain-wrap {
    min-height: 4rem;
  }

  .lcs-empty {
    color: var(--muted);
    font-style: italic;
    opacity: 0.5;
  }

  .lcs-chain-node {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lcs-chain-val {
    border-color: var(--status-info);
    color: var(--status-info);
    background: color-mix(in srgb, var(--status-info) 15%, transparent);
    transform: translateY(0);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
  }

  .lcs-chain-arrow {
    color: var(--status-info);
  }

  .lcs-set-wrap {
    margin-top: 2rem;
  }

  .lcs-set {
    gap: 0.8rem;
  }

  .lcs-set-val {
    border-radius: 50%;
  }

  .cell-val.active-start {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    transform: translateY(-4px);
  }

  .cell-val.active-skip {
    border-color: var(--status-hard);
    color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 15%, transparent);
    transform: translateY(-4px);
  }

  .cell-val.success-val {
    border-color: var(--status-info);
    color: var(--status-info);
    background: color-mix(in srgb, var(--status-info) 15%, transparent);
  }

  .active-chain-cell {
    animation: pop-in 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes pop-in {
    from {
      transform: scale(0.9);
      opacity: 0.4;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
