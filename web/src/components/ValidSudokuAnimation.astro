---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const board = [
  ["5","3",".",".","7",".",".",".","."],
  ["6",".",".","1","9","5",".",".","."],
  [".","9","8",".",".",".",".","6","."],
  ["8",".",".",".","6",".",".",".","3"],
  ["4",".",".","8",".","3",".",".","1"],
  ["7",".",".",".","2",".",".",".","6"],
  [".","6",".",".",".",".","2","8","."],
  [".",".",".","4","1","9",".",".","5"],
  [".",".",".",".","8",".",".","7","9"]
];

const steps = [
  { r: 0, c: 0, val: "5", valid: true, rowSet: ["5"], colSet: ["5"], boxSet: ["5"], exp: "Start evaluating Row 0. First cell (0,0) is '5'. Add '5' to Row 0 Set, Col 0 Set, and Box 0 Set." },
  { r: 0, c: 1, val: "3", valid: true, rowSet: ["5","3"], colSet: ["3"], boxSet: ["5","3"], exp: "(0,1) is '3'. Not in any current set. Add '3'." },
  { r: 0, c: 2, val: ".", valid: true, rowSet: ["5","3"], colSet: [], boxSet: ["5","3"], exp: "(0,2) is '.' (empty). Skip it." },
  { r: 0, c: 4, val: "7", valid: true, rowSet: ["5","3","7"], colSet: ["7"], boxSet: ["7"], exp: "Skip to next number: (0,4) is '7'. This belongs to Box 1! Add '7'." },
  { r: 1, c: 0, val: "6", valid: true, rowSet: ["6"], colSet: ["5","6"], boxSet: ["5","3","6"], exp: "Fast forward to Row 1. (1,0) is '6'. Row 1 Set starts with '6'. Box 0 Set now has '5','3','6'." },
  { r: 1, c: 5, val: "5", valid: true, rowSet: ["6","1","9","5"], colSet: ["5"], boxSet: ["7","1","9","5"], exp: "(1,5) is '5'. Valid. But wait... what if we change the next cell to create an error?" },
  { r: 2, c: 2, val: "8", valid: true, rowSet: ["9","8"], colSet: ["8"], boxSet: ["5","3","6","9","8"], exp: "Now at (2,2) which is '8'. It is valid." },
  { r: 2, c: 2, val: "8", valid: false, rowSet: ["9","8"], colSet: ["8"], boxSet: ["5","3","6","9","8"], conflict: "box", exp: "Imagine if the board had an '8' at (0,2) instead of empty. It would conflict with the '8' already in the top-left 3x3 Box Set! Sudoku invalid." }
];
---

<valid-sudoku-visuals>
  <AlgorithmPlayer title="9x9 Sudoku Board" steps={steps}>
    <div class="anim-row" style="display: flex; gap: 2rem; flex-wrap: wrap;">

      <!-- Left: 9x9 Grid -->
      <div class="board-col">
        <p class="anim-label">Sudoku Board</p>
        <div class="sudoku-grid vs-grid">
          {board.map((row, r) => (
            row.map((cell, c) => (
              <div class="sudoku-cell vs-cell" data-r={r} data-c={c}>
                {cell !== '.' ? cell : ''}
              </div>
            ))
          ))}
        </div>
      </div>

      <!-- Right: Sets -->
      <div class="sets-col">
        <div class="set-group">
          <p class="anim-label">Current Row Set</p>
          <div class="hashmap-row vs-row-set"></div>
        </div>
        <div class="set-group">
          <p class="anim-label">Current Column Set</p>
          <div class="hashmap-row vs-col-set"></div>
        </div>
        <div class="set-group highlight">
          <p class="anim-label">Current 3x3 Box Set</p>
          <div class="hashmap-row vs-box-set"></div>
        </div>
      </div>
    </div>
  </AlgorithmPlayer>
</valid-sudoku-visuals>

<script>
  class ValidSudokuVisuals extends HTMLElement {
    connectedCallback() {
      this.cells = Array.from(this.querySelectorAll(".vs-cell"));
      this.rowSetEl = this.querySelector(".vs-row-set");
      this.colSetEl = this.querySelector(".vs-col-set");
      this.boxSetEl = this.querySelector(".vs-box-set");

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        // Board Highlight
        this.cells.forEach((cell: any) => {
          const r = parseInt(cell.dataset.r, 10);
          const c = parseInt(cell.dataset.c, 10);

          cell.className = "sudoku-cell vs-cell";

          if (r === s.r && c === s.c) {
            cell.classList.add("active");
            if (!s.valid) cell.classList.add("conflict");
          } else if (r === s.r) {
            cell.classList.add("hl-row");
          } else if (c === s.c) {
            cell.classList.add("hl-col");
          }

          // Check 3x3 Box
          const boxR = Math.floor(r / 3);
          const boxC = Math.floor(c / 3);
          const activeBoxR = Math.floor(s.r / 3);
          const activeBoxC = Math.floor(s.c / 3);

          if (boxR === activeBoxR && boxC === activeBoxC) {
            cell.classList.add("hl-box");
          }
        });

        // Sets
        const buildSetHTML = (arr: string[], conflict: boolean) => {
          if (!arr || arr.length === 0) return "<span class='hashmap-empty'>empty</span>";
          return arr.map((num: string) => {
            const isConflict = !s.valid && conflict && num === s.val;
            return `<span class='hashmap-entry ${isConflict ? 'conflict-entry' : ''}'>'${num}'</span>`;
          }).join("");
        };

        if (this.rowSetEl) this.rowSetEl.innerHTML = buildSetHTML(s.rowSet, s.conflict === "row");
        if (this.colSetEl) this.colSetEl.innerHTML = buildSetHTML(s.colSet, s.conflict === "col");
        if (this.boxSetEl) this.boxSetEl.innerHTML = buildSetHTML(s.boxSet, s.conflict === "box");
      });
    }
  }

  if (!customElements.get('valid-sudoku-visuals')) {
    customElements.define('valid-sudoku-visuals', ValidSudokuVisuals);
  }
</script>

<style>
  valid-sudoku-visuals {
    display: block;
  }

  .sudoku-grid {
    display: grid;
    grid-template-columns: repeat(9, 1.8rem);
    grid-template-rows: repeat(9, 1.8rem);
    border: 2px solid #555;
    background: #000;
    gap: 1px;
    width: fit-content;
  }

  .sudoku-cell {
    background: #151515;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-family: ui-monospace, monospace;
    color: var(--muted);
    transition: all 0.2s;
  }

  /* 3x3 Box Borders */
  .sudoku-cell:nth-child(3n) { border-right: 2px solid #555; }
  .sudoku-cell:nth-child(9n) { border-right: none; }
  .sudoku-grid > :nth-child(n+19):nth-child(-n+27),
  .sudoku-grid > :nth-child(n+46):nth-child(-n+54) {
    border-bottom: 2px solid #555;
  }

  /* Highlights */
  .sudoku-cell.hl-row { background: rgba(90, 130, 176, 0.1); }
  .sudoku-cell.hl-col { background: rgba(90, 130, 176, 0.1); }
  .sudoku-cell.hl-box { background: rgba(201, 168, 76, 0.15); color: #c9a84c; }

  .sudoku-cell.active {
    background: var(--accent);
    color: #000;
    font-weight: bold;
    box-shadow: 0 0 10px var(--accent);
    z-index: 10;
  }

  .sudoku-cell.conflict {
    background: #b05a5a;
    box-shadow: 0 0 10px #b05a5a;
  }

  .sets-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex-grow: 1;
  }

  .set-group {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: #0e0e0e;
  }

  .set-group.highlight {
    border-color: rgba(201, 168, 76, 0.3);
  }

  .conflict-entry {
    border-color: #b05a5a !important;
    color: #e09090 !important;
    background: rgba(176, 90, 90, 0.15) !important;
    animation: shake 0.4s ease-in-out;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }
</style>
