---
---

<sr-data-manager>
  <div class="sr-manager">
    <div class="sr-manager-row">
      <span class="sr-summary"></span>
      <div class="sr-actions">
        <button class="sr-btn sr-export">Export</button>
        <label class="sr-btn sr-import-label">
          Import
          <input type="file" accept=".json" class="sr-import-input" hidden />
        </label>
        <button class="sr-btn sr-reset">Reset</button>
      </div>
    </div>
    <p class="sr-backup-reminder" hidden></p>
    <p class="sr-feedback"></p>
  </div>

  <!-- Reset confirmation dialog -->
  <dialog class="sr-dialog">
    <div class="sr-dialog-body">
      <p class="sr-dialog-title">Reset all review progress?</p>
      <p class="sr-dialog-text">This will permanently delete all attempts, spaced repetition data, <strong>and every note highlight</strong>. This cannot be undone.</p>
      <div class="sr-dialog-actions">
        <button class="sr-btn sr-dialog-cancel">Cancel</button>
        <button class="sr-btn sr-dialog-confirm">Reset</button>
      </div>
    </div>
  </dialog>
</sr-data-manager>

<script>
  import {
    exportAll,
    getAllHighlightRecords,
    getAllAttemptEvents,
    getAllRecords,
    getAllReviewEvents,
    importAll,
    resetDatabase,
  } from "../scripts/sr-db";
  import {
    activityCount,
    needsBackup,
    readBackupSnapshot,
  } from "../scripts/backup-status";
  import { todayISO } from "../scripts/sr-scheduler";

  const BACKUP_SNAPSHOT_KEY = "mental-gym-last-export";

  class SRDataManagerElement extends HTMLElement {
    connectedCallback() {
      const summaryEl = this.querySelector(".sr-summary") as HTMLElement;
      const feedbackEl = this.querySelector(".sr-feedback") as HTMLElement;
      const backupReminderEl = this.querySelector(".sr-backup-reminder") as HTMLElement;
      const exportBtn = this.querySelector(".sr-export") as HTMLButtonElement;
      const importInput = this.querySelector(".sr-import-input") as HTMLInputElement;
      const resetBtn = this.querySelector(".sr-reset") as HTMLButtonElement;
      const dialog = this.querySelector(".sr-dialog") as HTMLDialogElement;
      const cancelBtn = this.querySelector(".sr-dialog-cancel") as HTMLButtonElement;
      const confirmBtn = this.querySelector(".sr-dialog-confirm") as HTMLButtonElement;

      const showFeedback = (msg: string) => {
        feedbackEl.textContent = msg;
        feedbackEl.classList.add("visible");
        setTimeout(() => feedbackEl.classList.remove("visible"), 3000);
      };

      const saveBackupSnapshot = (count: number) => {
        try {
          localStorage.setItem(
            BACKUP_SNAPSHOT_KEY,
            JSON.stringify({ exportedAt: new Date().toISOString(), activityCount: count })
          );
        } catch {
          // Browser storage can be unavailable without affecting exports.
        }
      };

      const updateSummary = async () => {
        const [records, events, highlights, attempts] = await Promise.all([
          getAllRecords(),
          getAllReviewEvents(),
          getAllHighlightRecords(),
          getAllAttemptEvents(),
        ]);
        const activity = activityCount(
          records.length,
          events.length,
          highlights.length,
          attempts.length
        );

        if (records.length === 0 && activity === 0) {
          summaryEl.textContent = "No progress data yet. Finish an attempt or rate a problem to start tracking.";
          backupReminderEl.hidden = true;
          return;
        }
        const today = todayISO();
        const due = records.filter((r) => r.dueDate <= today).length;
        summaryEl.textContent = `${records.length} problems tracked · ${attempts.length} attempts${due > 0 ? ` · ${due} due` : ""}`;

        let snapshot: ReturnType<typeof readBackupSnapshot>;
        try {
          snapshot = readBackupSnapshot(localStorage.getItem(BACKUP_SNAPSHOT_KEY));
        } catch {
          snapshot = undefined;
        }
        const showReminder = needsBackup(activity, snapshot);
        backupReminderEl.hidden = !showReminder;
        backupReminderEl.textContent = showReminder
          ? snapshot
            ? "Your progress has changed since an older export. Download a fresh backup."
            : "Your progress is only in this browser. Download a backup to keep it portable."
          : "";
      };

      updateSummary();

      // Export
      exportBtn.addEventListener("click", async () => {
        const [records, events, highlights, attempts] = await Promise.all([
          getAllRecords(),
          getAllReviewEvents(),
          getAllHighlightRecords(),
          getAllAttemptEvents(),
        ]);
        if (
          records.length === 0 &&
          events.length === 0 &&
          highlights.length === 0 &&
          attempts.length === 0
        ) {
          showFeedback("Nothing to export.");
          return;
        }
        const json = exportAll(records, events, highlights, attempts);
        const blob = new Blob([json], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `mental-gym-sr-${todayISO()}.json`;
        a.click();
        URL.revokeObjectURL(url);
        saveBackupSnapshot(
          activityCount(records.length, events.length, highlights.length, attempts.length)
        );
        showFeedback(
          `Exported ${records.length} records, ${events.length} review events, ${highlights.length} highlights, and ${attempts.length} attempts.`
        );
        await updateSummary();
      });

      // Import
      importInput.addEventListener("change", async () => {
        const file = importInput.files?.[0];
        if (!file) return;
        try {
          const text = await file.text();
          const result = await importAll(text);
          showFeedback(
            `Imported ${result.recordCount} records, ${result.eventCount} review events, ${result.highlightCount} highlights, and ${result.attemptCount} attempts.`
          );
          await updateSummary();
          window.dispatchEvent(new CustomEvent("mental-gym:progress-updated"));
        } catch (e: any) {
          showFeedback(`Import failed: ${e.message}`);
        }
        importInput.value = "";
      });

      // Reset
      resetBtn.addEventListener("click", () => {
        dialog.showModal();
      });

      cancelBtn.addEventListener("click", () => {
        dialog.close();
      });

      confirmBtn.addEventListener("click", async () => {
        await resetDatabase();
        try {
          localStorage.removeItem(BACKUP_SNAPSHOT_KEY);
        } catch {
          // Keep reset usable when local preference storage is unavailable.
        }
        dialog.close();
        showFeedback("All progress data cleared.");
        await updateSummary();
        window.dispatchEvent(new CustomEvent("mental-gym:progress-updated"));
      });
    }
  }

  if (!customElements.get("sr-data-manager")) {
    customElements.define("sr-data-manager", SRDataManagerElement);
  }
</script>

<style>
  sr-data-manager {
    display: block;
  }

  .sr-manager {
    margin-bottom: 1.5rem;
  }

  .sr-manager-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .sr-summary {
    font-size: var(--fs-eyebrow);
    color: var(--muted);
    font-family: var(--font-sans);
  }

  .sr-actions {
    display: flex;
    gap: 0.35rem;
  }

  .sr-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 0.3rem 0.7rem;
    font-size: var(--fs-eyebrow);
    font-family: var(--font-sans);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    letter-spacing: 0.03em;
  }

  .sr-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sr-import-label {
    display: inline-flex;
    align-items: center;
  }

  .sr-reset {
    color: var(--status-hard);
    border-color: color-mix(in srgb, var(--status-hard) 30%, transparent);
  }
  .sr-reset:hover {
    color: var(--status-hard);
    border-color: var(--status-hard);
  }

  .sr-feedback {
    margin: 0.5rem 0 0;
    font-size: var(--fs-eyebrow);
    color: var(--muted);
    font-family: var(--font-sans);
    opacity: 0;
    transition: opacity 0.2s;
    height: 1rem;
  }
  .sr-backup-reminder {
    color: var(--accent);
    font: var(--fs-fine) var(--font-sans);
    line-height: 1.5;
    margin: 0.65rem 0 0;
  }
  .sr-feedback.visible {
    opacity: 1;
  }

  /* Reset dialog */
  .sr-dialog {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    padding: 0;
    max-width: 400px;
    width: 90vw;
    color: var(--text);
  }

  .sr-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .sr-dialog-body {
    padding: 1.5rem;
  }

  .sr-dialog-title {
    margin: 0 0 0.5rem;
    font-size: var(--fs-base);
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .sr-dialog-text {
    margin: 0 0 1.25rem;
    font-size: var(--fs-sm);
    color: var(--muted);
    font-family: var(--font-sans);
    line-height: 1.5;
  }

  .sr-dialog-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  .sr-dialog-confirm {
    color: var(--status-hard);
    border-color: color-mix(in srgb, var(--status-hard) 40%, transparent);
    background: color-mix(in srgb, var(--status-hard) 10%, transparent);
  }
  .sr-dialog-confirm:hover {
    color: #fff;
    border-color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 30%, transparent);
  }
</style>
