---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';
import type { TeachingStep } from '../lib/teaching/types';

const s1 = "ab";
const s2 = "eidbaooo";

const steps: TeachingStep[] = [
  {
    id: 'build-initial-window',
    l: 0,
    r: 1,
    entering: 'i',
    leaving: null,
    s1Count: { a: 1, b: 1 },
    windowCount: { e: 1, i: 1 },
    matchedKeys: 0,
    windowText: 'ei',
    match: false,
    exp: "Build the first fixed-size window 'ei'. Its frequency map is our first candidate to compare against s1.",
    reason: 'We only need to inspect windows whose length equals len(s1), because a permutation must use exactly the same number of characters.',
    invariant: [
      'Window size always equals len(s1).',
      'A valid answer appears only when the window frequency map equals the target map.',
    ],
    action: 'compare',
    highlights: [
      { target: 'target-map', kind: 'focus' },
      { target: 'window-map', kind: 'write' },
      { target: 'window-status', kind: 'compare' },
      { target: 'window-track', kind: 'compare' },
      { target: 'window', kind: 'compare' },
      { target: 'char:0', kind: 'focus' },
      { target: 'char:1', kind: 'focus' },
      { target: 'match-count', kind: 'focus' },
    ],
  },
  {
    id: 'slide-to-id',
    l: 1,
    r: 2,
    entering: 'd',
    leaving: 'e',
    s1Count: { a: 1, b: 1 },
    windowCount: { i: 1, d: 1 },
    matchedKeys: 0,
    windowText: 'id',
    match: false,
    exp: "Slide one step right: remove 'e' and add 'd'. The window becomes 'id', but its counts still do not match s1.",
    reason: 'Sliding updates the window in O(1): one character leaves and one character enters, while the size stays fixed.',
    invariant: 'Each move preserves the same window length, so every comparison is against a valid permutation-sized substring.',
    action: 'compare',
    highlights: [
      { target: 'window-update', kind: 'focus' },
      { target: 'leaving-char', kind: 'discard' },
      { target: 'entering-char', kind: 'write' },
      { target: 'window-map', kind: 'compare' },
      { target: 'window', kind: 'compare' },
      { target: 'char:0', kind: 'discard' },
      { target: 'char:2', kind: 'write' },
      { target: 'pointer:l', kind: 'focus' },
      { target: 'pointer:r', kind: 'focus' },
    ],
  },
  {
    id: 'slide-to-db',
    l: 2,
    r: 3,
    entering: 'b',
    leaving: 'i',
    s1Count: { a: 1, b: 1 },
    windowCount: { d: 1, b: 1 },
    matchedKeys: 1,
    windowText: 'db',
    match: false,
    exp: "Slide again: remove 'i' and add 'b'. Now 'db' shares the letter 'b' with s1, but one matching letter is still not enough.",
    reason: "Permutation checking is exact: every character frequency must line up with s1's frequency map.",
    invariant: 'A mismatch in even one key means the whole window is invalid.',
    action: 'compare',
    highlights: [
      { target: 'target-map', kind: 'focus' },
      { target: 'window-map', kind: 'compare' },
      { target: 'match-count', kind: 'focus' },
      { target: 'window-status', kind: 'compare' },
      { target: 'char:1', kind: 'discard' },
      { target: 'char:3', kind: 'write' },
      { target: 'window', kind: 'compare' },
    ],
  },
  {
    id: 'match-found',
    l: 3,
    r: 4,
    entering: 'a',
    leaving: 'd',
    s1Count: { a: 1, b: 1 },
    windowCount: { b: 1, a: 1 },
    matchedKeys: 2,
    windowText: 'ba',
    match: true,
    exp: "Slide once more: remove 'd' and add 'a'. The window is now 'ba', and its frequency map matches s1 exactly.",
    reason: 'Equal maps mean both substrings contain the same multiset of letters, so the current window is a permutation.',
    invariant: 'When all target keys match, the fixed-size window is a valid answer.',
    action: 'confirm',
    highlights: [
      { target: 'target-map', kind: 'match' },
      { target: 'window-map', kind: 'match' },
      { target: 'window-status', kind: 'confirmed' },
      { target: 'match-count', kind: 'confirmed' },
      { target: 'window-update', kind: 'focus' },
      { target: 'window', kind: 'confirmed' },
      { target: 'char:3', kind: 'confirmed' },
      { target: 'char:4', kind: 'confirmed' },
      { target: 'pointer:l', kind: 'focus' },
      { target: 'pointer:r', kind: 'focus' },
    ],
  },
];

const s1Keys = Object.keys(steps[0].s1Count).sort();
---

<permutation-in-string-visuals>
  <AlgorithmPlayer title={`s1 = "${s1}", s2 = "${s2}"`} steps={steps}>
    <div class="stats-row pis-stats-row">
      <div class="stat-box" data-teach-target="window-status">
        <span class="stat-label">Current Window</span>
        <span class="stat-val pis-window-text">-</span>
      </div>
      <div class="stat-box" data-teach-target="match-count">
        <span class="stat-label">Matched Keys</span>
        <span class="stat-val pis-match-count">0 / {s1Keys.length}</span>
      </div>
      <div class="stat-box" data-teach-target="window-update">
        <span class="stat-label">Slide Update</span>
        <span class="stat-val pis-update-text">Initialize first window</span>
      </div>
    </div>

    <div class="pis-maps-row">
      <div>
        <p class="anim-label">Target Frequency (s1)</p>
        <div class="hashmap-row pis-target-map" data-teach-target="target-map">
          {s1Keys.map((key) => (
            <span class="hashmap-entry highlight-entry pis-target-entry">
              '{key}' : {steps[0].s1Count[key as keyof typeof steps[0]['s1Count']]}
            </span>
          ))}
        </div>
      </div>

      <div>
        <p class="anim-label">Window Frequency</p>
        <div class="hashmap-row pis-window-map" data-teach-target="window-map"></div>
      </div>
    </div>

    <div class="pis-flow-row">
      <div class="pis-flow-box" data-teach-target="leaving-char">
        <span class="pis-flow-label">Leaving</span>
        <span class="pis-flow-value pis-leaving-char">-</span>
      </div>
      <div class="pis-flow-arrow">→</div>
      <div class="pis-flow-box" data-teach-target="entering-char">
        <span class="pis-flow-label">Entering</span>
        <span class="pis-flow-value pis-entering-char">-</span>
      </div>
    </div>

    <div class="anim-row pis-string-row">
      <p class="anim-label">String s2 (Sliding Window)</p>
      <div class="string-container" data-teach-target="window-track">
        <div class="window-highlight pis-window" data-teach-target="window"></div>
        <div class="array-row pis-chars" style="position: relative; z-index: 1;">
          {s2.split("").map((char, i) => (
            <div class="array-col">
              <div class="array-cell pis-cell" data-idx={i} data-teach-target={`char:${i}`}>
                <span class="cell-val">{char}</span>
                <span class="cell-idx">{i}</span>
              </div>
              <div class="pointers-row pis-ptr-col" data-idx={i}>
                <span class="ptr ptr-l hidden" data-teach-target={i === 0 ? "pointer:l" : undefined}>L</span>
                <span class="ptr ptr-r hidden" data-teach-target={i === 0 ? "pointer:r" : undefined}>R</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </AlgorithmPlayer>
</permutation-in-string-visuals>

<script>
  class PermutationInStringVisuals extends HTMLElement {
    connectedCallback() {
      this.windowEl = this.querySelector(".pis-window");
      this.cells = Array.from(this.querySelectorAll(".pis-cell"));
      this.ptrs = Array.from(this.querySelectorAll(".pis-ptr-col"));
      this.windowMapEl = this.querySelector(".pis-window-map");
      this.windowTextEl = this.querySelector(".pis-window-text");
      this.matchCountEl = this.querySelector(".pis-match-count");
      this.updateTextEl = this.querySelector(".pis-update-text");
      this.leavingCharEl = this.querySelector(".pis-leaving-char");
      this.enteringCharEl = this.querySelector(".pis-entering-char");
      this.windowStatusBox = this.querySelector('[data-teach-target="window-status"]');
      this.matchCountBox = this.querySelector('[data-teach-target="match-count"]');

      let lastStep = null;

      this.updateHighlight = () => {
        if (!lastStep || !this.windowEl) return;

        if (lastStep.l <= lastStep.r && this.cells.length > 0) {
          const arrayRow = this.querySelector(".pis-chars");
          const leftCell = this.cells[lastStep.l];
          const rightCell = this.cells[lastStep.r];

          if (arrayRow && leftCell && rightCell) {
            const left = leftCell.offsetLeft - arrayRow.scrollLeft - 4;
            const width =
              rightCell.offsetLeft + rightCell.offsetWidth - leftCell.offsetLeft + 8;
            this.windowEl.style.left = `${left}px`;
            this.windowEl.style.width = `${width}px`;
            this.windowEl.style.opacity = "1";
            this.windowEl.classList.toggle("success-window", lastStep.match);
          }
        } else {
          this.windowEl.style.opacity = "0";
        }
      };

      window.addEventListener("resize", this.updateHighlight);

      this.addEventListener("step-change", (e) => {
        const step = e.detail.step;
        lastStep = step;

        if (this.windowTextEl) {
          this.windowTextEl.textContent = step.windowText ?? '-';
        }

        if (this.matchCountEl) {
          this.matchCountEl.textContent = `${step.matchedKeys ?? 0} / ${Object.keys(step.s1Count).length}`;
        }

        if (this.updateTextEl) {
          this.updateTextEl.textContent = step.leaving
            ? `${step.leaving} leaves, ${step.entering} enters`
            : 'Initialize first window';
        }

        if (this.leavingCharEl) {
          this.leavingCharEl.textContent = step.leaving ?? '-';
        }

        if (this.enteringCharEl) {
          this.enteringCharEl.textContent = step.entering ?? '-';
        }

        this.windowStatusBox?.classList.toggle('success-box', Boolean(step.match));
        this.matchCountBox?.classList.toggle(
          'success-box',
          (step.matchedKeys ?? 0) === Object.keys(step.s1Count).length
        );

        this.cells.forEach((cell, i) => {
          const valSpan = cell.querySelector(".cell-val");
          if (!valSpan) return;

          valSpan.className = "cell-val";
          if (i >= step.l && i <= step.r) {
            valSpan.classList.add("in-window");
            if (step.match) valSpan.classList.add("success-val");
          }
        });

        this.ptrs.forEach((col, i) => {
          const lPtr = col.querySelector(".ptr-l");
          const rPtr = col.querySelector(".ptr-r");

          if (lPtr) lPtr.className = `ptr ptr-l ${i === step.l ? "" : "hidden"}`;
          if (rPtr) rPtr.className = `ptr ptr-r ${i === step.r ? "" : "hidden"}`;
        });

        this.updateHighlight();

        if (this.windowMapEl) {
          const keys = Object.keys(step.windowCount).sort();
          if (keys.length === 0) {
            this.windowMapEl.innerHTML = "<span class='hashmap-empty'>empty</span>";
          } else {
            this.windowMapEl.innerHTML = keys
              .map((key) => {
                const matchesTarget = step.s1Count[key] === step.windowCount[key];
                return `<span class='hashmap-entry ${matchesTarget ? 'highlight-entry' : ''}'>'${key}' : ${step.windowCount[key]}</span>`;
              })
              .join("");
          }
        }
      });
    }

    disconnectedCallback() {
      if (this.updateHighlight) {
        window.removeEventListener("resize", this.updateHighlight);
      }
    }
  }

  if (!customElements.get('permutation-in-string-visuals')) {
    customElements.define('permutation-in-string-visuals', PermutationInStringVisuals);
  }
</script>

<style>
  permutation-in-string-visuals {
    display: block;
  }

  .pis-stats-row {
    margin-bottom: 1.5rem;
  }

  .stat-box.success-box {
    border-color: var(--status-easy) !important;
    background: color-mix(in srgb, var(--status-easy) 10%, transparent) !important;
  }

  .stat-box.success-box .stat-val {
    color: var(--status-easy) !important;
  }

  .pis-maps-row {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .pis-target-entry {
    opacity: 0.8;
  }

  .pis-flow-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .pis-flow-box {
    min-width: 8rem;
    padding: 0.85rem 1rem;
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--border-primary) 80%, transparent);
    background: color-mix(in srgb, var(--surface-secondary) 78%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-sm);
  }

  .pis-flow-label {
    display: block;
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  .pis-flow-value {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--text);
  }

  .pis-flow-arrow {
    font-size: var(--fs-lg);
    color: var(--muted);
  }

  .pis-string-row {
    margin-top: 2rem;
  }

  .string-container {
    position: relative;
    padding: 0.5rem 0;
  }

  .window-highlight {
    position: absolute;
    top: 0;
    bottom: 2rem;
    background: color-mix(in srgb, var(--status-info) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--status-info) 30%, transparent);
    border-radius: 10px;
    z-index: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .window-highlight.success-window {
    background: color-mix(in srgb, var(--status-easy) 10%, transparent);
    border-color: color-mix(in srgb, var(--status-easy) 40%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--status-easy) 20%, transparent);
  }

  .cell-val.in-window {
    color: var(--status-info);
    border-color: var(--status-info);
    background: color-mix(in srgb, var(--status-info) 15%, transparent);
  }

  .cell-val.success-val {
    color: var(--status-easy) !important;
    border-color: var(--status-easy) !important;
    background: color-mix(in srgb, var(--status-easy) 15%, transparent) !important;
  }

  .ptr-l {
    background: color-mix(in srgb, var(--status-info) 20%, transparent);
    color: var(--status-info);
  }

  .ptr-r {
    background: color-mix(in srgb, var(--status-easy) 20%, transparent);
    color: var(--status-easy);
  }

  .highlight-entry {
    border-color: var(--accent) !important;
    color: var(--accent) !important;
    background: var(--accent-dim) !important;
    box-shadow: var(--shadow-sm);
  }
</style>
