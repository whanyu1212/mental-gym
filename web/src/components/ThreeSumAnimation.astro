---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const nums = [-1, 0, 1, 2, -1, -4];
const sortedNums = [...nums].sort((a, b) => a - b); // [-4, -1, -1, 0, 1, 2]

const steps = [
  { i: 0, l: 1, r: 5, target: 4, sum: 1,  found: false, results: [], exp: "Array is sorted. Fix i=0 (val -4). We need a pair (L, R) that sums to 4. L=1 (val -1), R=5 (val 2). Sum = 1." },
  { i: 0, l: 2, r: 5, target: 4, sum: 1,  found: false, results: [], exp: "Sum (1) is less than target (4). We need a bigger number. Move L right." },
  { i: 0, l: 3, r: 5, target: 4, sum: 2,  found: false, results: [], exp: "L=3 (val 0), R=5 (val 2). Sum = 2. Still less than target. Move L right." },
  { i: 0, l: 4, r: 5, target: 4, sum: 3,  found: false, results: [], exp: "L=4 (val 1), R=5 (val 2). Sum = 3. Still less. L and R are adjacent. No pairs found for i=0." },

  { i: 1, l: 2, r: 5, target: 1, sum: 1,  found: true,  results: ["[-1, -1, 2]"], exp: "Advance i to 1 (val -1). Target is now 1. L=2 (val -1), R=5 (val 2). Sum = 1. Match found! Record [-1, -1, 2]." },
  { i: 1, l: 3, r: 4, target: 1, sum: 1,  found: true,  results: ["[-1, -1, 2]", "[-1, 0, 1]"], exp: "After match, shrink both L and R. L=3 (val 0), R=4 (val 1). Sum = 1. Another match! Record [-1, 0, 1]." },

  { i: 2, l: 3, r: 4, target: 1, sum: null, found: false, results: ["[-1, -1, 2]", "[-1, 0, 1]"], exp: "Advance i to 2 (val -1). But wait! This is the same value as i=1. We must skip duplicate i values to avoid duplicate triplets." },

  { i: 3, l: 4, r: 5, target: 0, sum: 3,  found: false, results: ["[-1, -1, 2]", "[-1, 0, 1]"], exp: "Advance i to 3 (val 0). Target is 0. L=4 (val 1), R=5 (val 2). Sum = 3." },
  { i: 3, l: 4, r: 4, target: 0, sum: null, found: false, results: ["[-1, -1, 2]", "[-1, 0, 1]"], exp: "Sum (3) > target (0). Move R left. L and R meet. Done." },

  { i: 4, l: 5, r: 5, target: -1, sum: null, found: false, results: ["[-1, -1, 2]", "[-1, 0, 1]"], exp: "Advance i to 4. L and R cannot form a valid window. We are finished! Two unique triplets found." },
];
---

<three-sum-visuals>
  <AlgorithmPlayer title="nums = [-1, 0, 1, 2, -1, -4]" steps={steps}>

    <div class="stats-row">
      <div class="stat-box">
        <span class="stat-label">Fixed i (Target)</span>
        <span class="stat-val ts-target">0</span>
      </div>
      <div class="stat-box highlight">
        <span class="stat-label">L + R Sum</span>
        <span class="stat-val ts-sum">-</span>
      </div>
    </div>

    <div class="anim-row">
      <p class="anim-label">Sorted Array & Pointers</p>
      <div class="array-row">
        {sortedNums.map((n, i) => (
          <div class="array-col">
            <div class="array-cell ts-cell" data-idx={i}>
              <span class="cell-val">{n}</span>
              <span class="cell-idx">{i}</span>
            </div>
            <div class="pointers-row ts-ptr-col" data-idx={i}>
              <span class="ptr ptr-i hidden">i</span>
              <span class="ptr ptr-l hidden">L</span>
              <span class="ptr ptr-r hidden">R</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="anim-row" style="margin-top: 2rem;">
      <p class="anim-label">Valid Triplets Found</p>
      <div class="hashmap-row ts-results">
        <span class='hashmap-empty'>none</span>
      </div>
    </div>
  </AlgorithmPlayer>
</three-sum-visuals>

<script>
  class ThreeSumVisuals extends HTMLElement {
    connectedCallback() {
      this.targetEl = this.querySelector(".ts-target");
      this.sumEl = this.querySelector(".ts-sum");
      this.resultsEl = this.querySelector(".ts-results");
      this.cells = Array.from(this.querySelectorAll(".ts-cell"));
      this.ptrCols = Array.from(this.querySelectorAll(".ts-ptr-col"));

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        // Stats
        if (this.targetEl) this.targetEl.textContent = s.target !== null ? s.target.toString() : "-";
        if (this.sumEl) {
          this.sumEl.textContent = s.sum !== null ? s.sum.toString() : "-";
          if (s.found) {
            this.sumEl.parentElement?.classList.add("success-box");
          } else {
            this.sumEl.parentElement?.classList.remove("success-box");
          }
        }

        // Cells
        this.cells.forEach((cell: any, i: number) => {
          const valSpan = cell.querySelector(".cell-val");
          if (valSpan) {
            valSpan.className = "cell-val";
            if (i < s.i) valSpan.classList.add("visited");
            if (i === s.i) valSpan.classList.add("active-i");
            if (i === s.l || i === s.r) {
              valSpan.classList.add("active-lr");
              if (s.found) valSpan.classList.add("found-lr");
            }
          }
        });

        // Pointers
        this.ptrCols.forEach((col: any, i: number) => {
          const ptrI = col.querySelector(".ptr-i");
          const ptrL = col.querySelector(".ptr-l");
          const ptrR = col.querySelector(".ptr-r");

          if (ptrI) ptrI.className = `ptr ptr-i ${i === s.i ? "" : "hidden"}`;
          if (ptrL) ptrL.className = `ptr ptr-l ${i === s.l ? "" : "hidden"}`;
          if (ptrR) ptrR.className = `ptr ptr-r ${i === s.r ? "" : "hidden"}`;
        });

        // Results
        if (this.resultsEl) {
          if (!s.results || s.results.length === 0) {
            this.resultsEl.innerHTML = "<span class='hashmap-empty'>none</span>";
          } else {
            this.resultsEl.innerHTML = s.results.map((res: string) =>
              `<span class='hashmap-entry result-entry'>${res}</span>`
            ).join("");
          }
        }
      });
    }
  }

  if (!customElements.get('three-sum-visuals')) {
    customElements.define('three-sum-visuals', ThreeSumVisuals);
  }
</script>

<style>
  three-sum-visuals {
    display: block;
  }

  .stat-box.highlight {
    border-color: rgba(201, 168, 76, 0.4);
    background: rgba(201, 168, 76, 0.05);
  }
  .stat-box.highlight .stat-val {
    color: var(--accent);
  }
  .stat-box.success-box {
    border-color: #7dab7d;
    background: rgba(125, 171, 125, 0.1);
  }
  .stat-box.success-box .stat-val {
    color: #7dab7d;
  }

  .cell-val.visited {
    opacity: 0.35;
  }

  .cell-val.active-i {
    border-color: #b05a5a;
    color: #e09090;
    background: rgba(176, 90, 90, 0.15);
    transform: translateY(-4px);
  }

  .cell-val.active-lr {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(201, 168, 76, 0.1);
    transform: translateY(-4px);
  }

  .cell-val.found-lr {
    border-color: #7dab7d !important;
    color: #7dab7d !important;
    background: rgba(125, 171, 125, 0.15) !important;
    box-shadow: 0 0 10px rgba(125, 171, 125, 0.2);
  }

  .ptr-i { background: rgba(176, 90, 90, 0.2); color: #b05a5a; }
  .ptr-l { background: rgba(90, 130, 176, 0.2); color: #5a82b0; }
  .ptr-r { background: rgba(125, 171, 125, 0.2); color: #7dab7d; }

  .result-entry {
    background: rgba(125, 171, 125, 0.1) !important;
    border-color: #7dab7d !important;
    color: #a0d0a0 !important;
  }
</style>
