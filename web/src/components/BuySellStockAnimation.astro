---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const prices = [7, 1, 5, 3, 6, 4];
const maxPrice = Math.max(...prices);

const steps = [
  { i: -1, min: null, maxP: 0, exp: "Initial state. We haven't seen any prices yet." },
  { i: 0, min: 7, maxP: 0, exp: "Day 1: Price is 7. This is our first price, so it becomes our minimum seen so far. Profit: 0." },
  { i: 1, min: 1, maxP: 0, exp: "Day 2: Price is 1. 1 < 7, so we found a new minimum! We'd rather buy here. Profit: 0." },
  { i: 2, min: 1, maxP: 4, exp: "Day 3: Price is 5. If we bought at our min (1) and sold today (5), profit is 4. New max profit!" },
  { i: 3, min: 1, maxP: 4, exp: "Day 4: Price is 3. Profit would be 3 - 1 = 2. 2 is less than our max profit of 4, so max profit stays 4." },
  { i: 4, min: 1, maxP: 5, exp: "Day 5: Price is 6. Profit would be 6 - 1 = 5. 5 > 4! New max profit!" },
  { i: 5, min: 1, maxP: 5, exp: "Day 6: Price is 4. Profit would be 4 - 1 = 3. Max profit stays 5." },
  { i: 5, min: 1, maxP: 5, exp: "Done! The maximum profit we can achieve is 5 (Buy at 1, Sell at 6)." }
];
---

<buy-sell-stock-visuals>
  <AlgorithmPlayer title="prices = [7, 1, 5, 3, 6, 4]" steps={steps}>
    <div class="stats-row">
      <div class="stat-box">
        <span class="stat-label">Min Price Seen</span>
        <span class="stat-val bss-min">-</span>
      </div>
      <div class="stat-box highlight">
        <span class="stat-label">Max Profit</span>
        <span class="stat-val bss-maxp">0</span>
      </div>
    </div>

    <div class="anim-row">
      <p class="anim-label">Price Chart</p>
      <div class="chart-container">
        <div class="min-line bss-min-line"></div>
        <div class="bars-row">
          {prices.map((p, idx) => (
            <div class="bar-col">
              <span class="bar-val">{p}</span>
              <div class="bar-wrapper">
                <div class="bar bss-bar" data-idx={idx} style={`height: ${(p / maxPrice) * 100}%`}></div>
              </div>
              <span class="bar-idx">Day {idx + 1}</span>
              <div class="pointer-container bss-ptr-col" data-idx={idx}>
                <span class="ptr ptr-up hidden">↑</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </AlgorithmPlayer>
</buy-sell-stock-visuals>

<script>
  class BuySellStockVisuals extends HTMLElement {
    connectedCallback() {
      this.minEl = this.querySelector(".bss-min");
      this.maxpEl = this.querySelector(".bss-maxp");
      this.minLine = this.querySelector(".bss-min-line") as HTMLElement;
      this.bars = Array.from(this.querySelectorAll(".bss-bar"));
      this.ptrs = Array.from(this.querySelectorAll(".bss-ptr-col"));

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        // Stats
        if (this.minEl) this.minEl.textContent = s.min !== null ? s.min : "-";
        if (this.maxpEl) this.maxpEl.textContent = s.maxP;

        // Min Line
        if (this.minLine) {
          if (s.min !== null) {
            this.minLine.style.bottom = `${(s.min / 7) * 100}%`;
            this.minLine.style.opacity = "1";
          } else {
            this.minLine.style.opacity = "0";
          }
        }

        // Bars & Pointers
        this.bars.forEach((bar: any, idx: number) => {
          bar.className = "bar bss-bar";
          if (idx === s.i) bar.classList.add("active");
          else if (idx < s.i) bar.classList.add("visited");
        });

        this.ptrs.forEach((col: any, idx: number) => {
          const ptr = col.querySelector(".ptr-up");
          if (ptr) ptr.className = `ptr ptr-up ${idx === s.i ? "" : "hidden"}`;
        });
      });
    }
  }

  if (!customElements.get('buy-sell-stock-visuals')) {
    customElements.define('buy-sell-stock-visuals', BuySellStockVisuals);
  }
</script>

<style>
  buy-sell-stock-visuals {
    display: block;
  }

  .stat-box.highlight {
    border-color: rgba(125, 171, 125, 0.4);
    background: rgba(125, 171, 125, 0.05);
  }
  .stat-box.highlight .stat-val {
    color: #7dab7d;
  }

  .chart-container {
    position: relative;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    border-left: 1px solid var(--border);
    height: 180px;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: flex-end;
  }

  .min-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(176, 90, 90, 0.5);
    border-top: 1px dashed #b05a5a;
    transition: bottom 0.3s ease, opacity 0.3s;
    z-index: 0;
  }
  .min-line::after {
    content: 'MIN';
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 0.6rem;
    color: #b05a5a;
    font-family: Inter, sans-serif;
  }

  .bars-row {
    display: flex;
    justify-content: space-around;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 1;
  }

  .bar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    width: 2.5rem;
    justify-content: flex-end;
  }

  .bar-val {
    font-size: 0.8rem;
    font-family: ui-monospace, monospace;
    color: var(--text);
    margin-bottom: 0.3rem;
  }

  .bar-wrapper {
    height: 100%;
    width: 100%;
    display: flex;
    align-items: flex-end;
  }

  .bar {
    width: 100%;
    background: #1a1a1a;
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: 2px 2px 0 0;
    transition: all 0.3s ease;
  }

  .bar.visited {
    background: rgba(255, 255, 255, 0.05);
  }
  .bar.active {
    background: rgba(201, 168, 76, 0.2);
    border-color: var(--accent);
    box-shadow: 0 0 10px rgba(201, 168, 76, 0.2);
  }

  .bar-idx {
    font-size: 0.6rem;
    color: var(--muted);
    margin-top: 0.5rem;
    font-family: Inter, sans-serif;
  }

  .pointer-container {
    height: 1.5rem;
    margin-top: 0.2rem;
  }

  .ptr-up {
    color: var(--accent);
    font-weight: bold;
    font-size: 1.2rem;
    transition: opacity 0.2s;
  }
  .ptr-up.hidden {
    opacity: 0;
  }
</style>
