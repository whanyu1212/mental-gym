---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const tokens = ["2", "1", "+", "3", "*"];

const steps = [
  { i: -1, stack: [], exp: "Initial state. We start with an empty stack." },
  { i: 0, stack: [2], exp: "Token '2' is a number. Push it onto the stack." },
  { i: 1, stack: [2, 1], exp: "Token '1' is a number. Push it onto the stack." },
  { i: 2, stack: [3], exp: "Token '+' is an operator! Pop the top two numbers (1 and 2). Calculate 2 + 1 = 3, and push the result 3 back onto the stack." },
  { i: 3, stack: [3, 3], exp: "Token '3' is a number. Push it onto the stack." },
  { i: 4, stack: [9], exp: "Token '*' is an operator! Pop the top two numbers (3 and 3). Calculate 3 * 3 = 9, and push the result 9 back onto the stack." },
  { i: 4, stack: [9], exp: "Done! The final result is the only number remaining on the stack: 9." }
];
---

<rpn-visuals>
  <AlgorithmPlayer title='tokens = ["2", "1", "+", "3", "*"]' steps={steps}>
    <div class="anim-row" style="display: flex; gap: 4rem; justify-content: center; min-height: 200px;">

      <!-- Left Col: Tokens Array -->
      <div style="flex: 1; max-width: 400px;">
        <p class="anim-label">Tokens Array</p>
        <div class="array-row">
          {tokens.map((t, idx) => (
            <div class="array-col">
              <div class="array-cell rpn-cell" data-idx={idx}>
                <span class="cell-val">{t}</span>
              </div>
              <div class="pointers-row rpn-ptr-col" data-idx={idx}>
                <span class="ptr ptr-up hidden">↑</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Col: Stack Visualization -->
      <div style="width: 120px; display: flex; flex-direction: column; align-items: center;">
        <p class="anim-label">Stack</p>
        <div class="stack-container rpn-stack">
          <!-- Stack elements dynamically rendered here -->
        </div>
        <div class="stack-base"></div>
      </div>
    </div>
  </AlgorithmPlayer>
</rpn-visuals>

<script>
  class RPNVisuals extends HTMLElement {
    connectedCallback() {
      this.stackEl = this.querySelector(".rpn-stack");
      this.cells = Array.from(this.querySelectorAll(".rpn-cell"));
      this.ptrs = Array.from(this.querySelectorAll(".rpn-ptr-col"));

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        // Tokens Array
        this.cells.forEach((cell: any, idx: number) => {
          cell.className = "array-cell rpn-cell";
          if (idx === s.i) cell.classList.add("active");
          else if (idx < s.i) cell.classList.add("visited");
        });

        this.ptrs.forEach((col: any, idx: number) => {
          const ptr = col.querySelector(".ptr-up");
          if (ptr) ptr.className = `ptr ptr-up ${idx === s.i ? "" : "hidden"}`;
        });

        // Stack Container
        if (this.stackEl) {
          if (s.stack.length === 0) {
            this.stackEl.innerHTML = "<span class='stack-empty'>Empty</span>";
          } else {
            // Reverse so top of stack renders at the top
            const reversed = [...s.stack].reverse();
            this.stackEl.innerHTML = reversed.map((num: number, idx: number) => {
              const isTop = idx === 0;
              return `<div class='stack-item ${isTop ? 'stack-top' : ''}'>${num}</div>`;
            }).join("");
          }
        }
      });
    }
  }

  if (!customElements.get('rpn-visuals')) {
    customElements.define('rpn-visuals', RPNVisuals);
  }
</script>

<style>
  rpn-visuals {
    display: block;
  }

  .array-cell.visited {
    opacity: 0.4;
  }

  .array-cell.active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(201, 168, 76, 0.08);
    transform: translateY(-4px);
  }

  .ptr-up {
    color: var(--accent);
    font-weight: bold;
    font-size: 1.2rem;
    transition: opacity 0.2s;
  }

  /* Stack Styles */
  .stack-container {
    width: 100px;
    height: 150px;
    border-left: 2px solid var(--border);
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    background: #0a0a0a;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 0.5rem;
    gap: 0.25rem;
    border-radius: 0 0 4px 4px;
    position: relative;
    overflow: hidden;
  }

  .stack-base {
    width: 120px;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    margin-top: 2px;
  }

  .stack-item {
    width: 100%;
    height: 2rem;
    min-height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 2px;
    font-family: ui-monospace, monospace;
    font-size: 1rem;
    color: var(--text);
    animation: drop-in 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .stack-top {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(201, 168, 76, 0.1);
    box-shadow: 0 0 8px rgba(201, 168, 76, 0.2);
  }

  .stack-empty {
    font-size: 0.8rem;
    color: var(--muted);
    font-style: italic;
    opacity: 0.5;
    margin-bottom: 1rem;
  }

  @keyframes drop-in {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>
