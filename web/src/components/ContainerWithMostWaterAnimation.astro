---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const heights = [1,8,6,2,5,4,8,3,7];
const maxH = Math.max(...heights);

const steps = [
  { l: 0, r: 8, maxArea: 0, w: 8, h: 1, area: 8, exp: "Start with L at the beginning, R at the end. Width = 8. Height is bounded by L (1). Area = 1 * 8 = 8. maxArea = 8." },
  { l: 1, r: 8, maxArea: 8, w: 7, h: 7, area: 49, exp: "height[L] < height[R], so move L to find a taller line. L=1 (height 8). Width = 7. Height bounded by R (7). Area = 7 * 7 = 49. maxArea = 49." },
  { l: 1, r: 7, maxArea: 49, w: 6, h: 3, area: 18, exp: "height[L] >= height[R], so move R. R=7 (height 3). Width = 6. Height = 3. Area = 18." },
  { l: 1, r: 6, maxArea: 49, w: 5, h: 8, area: 40, exp: "height[R] < height[L], move R. R=6 (height 8). Width = 5. Height = 8. Area = 40." },
  { l: 2, r: 6, maxArea: 49, w: 4, h: 6, area: 24, exp: "height[L] == height[R], move L. L=2 (height 6). Width = 4. Height = 6. Area = 24." },
  { l: 3, r: 6, maxArea: 49, w: 3, h: 2, area: 6, exp: "height[L] < height[R], move L. L=3 (height 2). Width = 3. Height = 2. Area = 6." },
  { l: 4, r: 6, maxArea: 49, w: 2, h: 5, area: 10, exp: "height[L] < height[R], move L. L=4 (height 5). Width = 2. Height = 5. Area = 10." },
  { l: 5, r: 6, maxArea: 49, w: 1, h: 4, area: 4, exp: "height[L] < height[R], move L. L=5 (height 4). Width = 1. Height = 4. Area = 4." },
  { l: 6, r: 6, maxArea: 49, w: 0, h: 0, area: 0, exp: "L meets R. The maximum area found is 49." },
];
---

<container-water-visuals>
  <AlgorithmPlayer title="heights = [1,8,6,2,5,4,8,3,7]" steps={steps}>
    <div class="stats-row">
      <div class="stat-box">
        <span class="stat-label">Current Area</span>
        <span class="stat-val cw-current-area">0</span>
      </div>
      <div class="stat-box highlight">
        <span class="stat-label">Max Area</span>
        <span class="stat-val cw-max-area">0</span>
      </div>
    </div>

    <div class="anim-row">
      <p class="anim-label">Bar Chart (Two Pointers)</p>
      <div class="chart-container">
        <div class="water-overlay cw-water-overlay"></div>
        <div class="bars-row">
          {heights.map((height, idx) => (
            <div class="bar-col">
              <div class="bar-wrapper">
                <div class="solid-block cw-block" data-idx={idx} style={`height: ${(height / maxH) * 100}%`}></div>
              </div>
              <span class="bar-idx">{height}</span>
              <div class="pointer-container cw-ptr-col" data-idx={idx}>
                <span class="ptr ptr-l hidden">L</span>
                <span class="ptr ptr-r hidden">R</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </AlgorithmPlayer>
</container-water-visuals>

<script>
  class ContainerWaterVisuals extends HTMLElement {
    connectedCallback() {
      this.currentAreaEl = this.querySelector(".cw-current-area");
      this.maxAreaEl = this.querySelector(".cw-max-area");
      this.waterOverlay = this.querySelector(".cw-water-overlay") as HTMLElement;
      this.blocks = Array.from(this.querySelectorAll(".cw-block"));
      this.ptrs = Array.from(this.querySelectorAll(".cw-ptr-col"));

      let lastStep: any = null;

      this._updateHighlight = () => {
        if (!lastStep) return;
        const s = lastStep;

        if (this.waterOverlay && this.blocks.length > 0) {
          if (s.l < s.r) {
            const chartContainer = this.querySelector(".bars-row");
            const leftBlock = this.blocks[s.l] as HTMLElement;
            const rightBlock = this.blocks[s.r] as HTMLElement;

            if (chartContainer && leftBlock && rightBlock) {
              const leftParent = leftBlock.closest('.bar-col') as HTMLElement;
              const rightParent = rightBlock.closest('.bar-col') as HTMLElement;

              if (leftParent && rightParent) {
                const left = leftParent.offsetLeft + leftParent.offsetWidth / 2;
                const width = rightParent.offsetLeft + rightParent.offsetWidth / 2 - left;

                // Max height of the current water level
                const maxH = 8; // Max value in the array
                const percentHeight = (s.h / maxH) * 100;

                this.waterOverlay.style.left = `${left}px`;
                this.waterOverlay.style.width = `${width}px`;
                this.waterOverlay.style.height = `${percentHeight}%`;
                this.waterOverlay.style.opacity = "1";
              }
            }
          } else {
            this.waterOverlay.style.opacity = "0";
          }
        }
      };

      window.addEventListener('resize', this._updateHighlight);

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;
        lastStep = s;

        if (this.currentAreaEl) this.currentAreaEl.textContent = s.area;
        if (this.maxAreaEl) this.maxAreaEl.textContent = s.maxArea;

        this.blocks.forEach((block: any, idx: number) => {
          if (idx === s.l || idx === s.r) {
            block.classList.add("active-block");
          } else {
            block.classList.remove("active-block");
          }
        });

        this.ptrs.forEach((col: any, idx: number) => {
          const l = col.querySelector(".ptr-l");
          const r = col.querySelector(".ptr-r");

          if (l) l.className = `ptr ptr-l ${idx === s.l ? "" : "hidden"}`;
          if (r) r.className = `ptr ptr-r ${idx === s.r ? "" : "hidden"}`;
        });

        // Use timeout to allow DOM to settle before calculating positions
        setTimeout(() => this._updateHighlight(), 10);
      });
    }

    disconnectedCallback() {
      window.removeEventListener('resize', this._updateHighlight);
    }
  }

  if (!customElements.get('container-water-visuals')) {
    customElements.define('container-water-visuals', ContainerWaterVisuals);
  }
</script>

<style>
  container-water-visuals {
    display: block;
  }

  .stat-box.highlight {
    border-color: rgba(90, 130, 176, 0.4);
    background: rgba(90, 130, 176, 0.05);
  }
  .stat-box.highlight .stat-val {
    color: #5a82b0;
  }

  .chart-container {
    position: relative;
    padding: 1rem 0 0 0;
    border-bottom: 1px solid var(--border);
    height: 180px;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: flex-end;
  }

  .water-overlay {
    position: absolute;
    bottom: 0;
    background: rgba(90, 130, 176, 0.3);
    border: 1px solid rgba(90, 130, 176, 0.6);
    border-bottom: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
    pointer-events: none;
  }

  .bars-row {
    display: flex;
    justify-content: space-around;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .bar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    width: 2rem;
    justify-content: flex-end;
  }

  .bar-wrapper {
    height: 100%;
    width: 100%;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .solid-block {
    width: 60%;
    background: #2a2a2a;
    border: 1px solid #444;
    border-bottom: none;
    border-radius: 2px 2px 0 0;
    transition: background 0.2s, border-color 0.2s;
  }

  .solid-block.active-block {
    background: #c9a84c;
    border-color: #e0bc5c;
    box-shadow: 0 0 10px rgba(201, 168, 76, 0.3);
  }

  .bar-idx {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.4rem;
    font-family: ui-monospace, monospace;
    font-weight: 600;
  }

  .pointer-container {
    height: 1.2rem;
    margin-top: 0.2rem;
    display: flex;
    gap: 0.2rem;
  }

  .ptr-l { background: rgba(90, 130, 176, 0.2); color: #5a82b0; }
  .ptr-r { background: rgba(125, 171, 125, 0.2); color: #7dab7d; }
</style>
