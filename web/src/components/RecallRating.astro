---
interface Props {
  domain: "algorithms" | "ml";
  slug: string;
  title: string;
  difficulty: string;
  group: string;
}
const { domain, slug, title, difficulty, group } = Astro.props;
---

<recall-rating
  data-domain={domain}
  data-slug={slug}
  data-title={title}
  data-difficulty={difficulty}
  data-group={group}
>
  <div class="recall-panel">
    <div class="recall-header">
      <h3 class="recall-heading">Spaced Repetition</h3>
      <span class="recall-status-badge sr-badge"></span>
    </div>

    <p class="recall-prompt">How well did you recall the solution?</p>

    <div class="recall-buttons">
      <button class="recall-btn again" data-quality="0">
        <span class="btn-label">Again</span>
        <span class="btn-hint">No clue</span>
      </button>
      <button class="recall-btn hard" data-quality="1">
        <span class="btn-label">Hard</span>
        <span class="btn-hint">Struggled</span>
      </button>
      <button class="recall-btn good" data-quality="2">
        <span class="btn-label">Good</span>
        <span class="btn-hint">Some effort</span>
      </button>
      <button class="recall-btn easy" data-quality="3">
        <span class="btn-label">Easy</span>
        <span class="btn-hint">Instant</span>
      </button>
    </div>

    <p class="recall-result sr-result"></p>
  </div>
</recall-rating>

<script>
  import { getRecord, putRecord } from "../scripts/sr-db";
  import {
    createNewRecord,
    schedule,
    statusOf,
    daysUntilDue,
  } from "../scripts/sr-scheduler";
  import type { ReviewQuality } from "../scripts/sr-types";

  class RecallRatingElement extends HTMLElement {
    connectedCallback() {
      const domain = this.dataset.domain as "algorithms" | "ml";
      const slug = this.dataset.slug!;
      const title = this.dataset.title!;
      const difficulty = this.dataset.difficulty!;
      const group = this.dataset.group!;
      const key = `${domain}:${slug}`;

      const badge = this.querySelector(".sr-badge") as HTMLElement;
      const resultEl = this.querySelector(".sr-result") as HTMLElement;
      const buttons = this.querySelectorAll<HTMLButtonElement>(".recall-btn");

      // Show current status
      getRecord(key).then((record) => {
        if (record) {
          const status = statusOf(record);
          const days = daysUntilDue(record);
          badge.textContent =
            status === "overdue"
              ? `Overdue by ${Math.abs(days)}d`
              : status === "due"
                ? "Due today"
                : status === "upcoming"
                  ? `Next: ${days}d`
                  : "";
          badge.className = `recall-status-badge sr-badge status-${status}`;
        }
      });

      buttons.forEach((btn) => {
        btn.addEventListener("click", async () => {
          const quality = Number(btn.dataset.quality) as ReviewQuality;

          let record = await getRecord(key);
          if (!record) {
            record = createNewRecord(domain, slug, title, difficulty, group);
          }

          const updated = schedule(record, quality);
          await putRecord(updated);

          // Disable buttons, show result
          buttons.forEach((b) => (b.disabled = true));
          btn.classList.add("selected");

          const days = daysUntilDue(updated);
          if (days === 0) {
            resultEl.textContent = "Review again today.";
          } else if (days === 1) {
            resultEl.textContent = "Next review: tomorrow.";
          } else {
            resultEl.textContent = `Next review: in ${days} days.`;
          }
          resultEl.classList.add("visible");

          badge.textContent = days === 0 ? "Due today" : `Next: ${days}d`;
          badge.className = `recall-status-badge sr-badge status-${days === 0 ? "due" : "upcoming"}`;
        });
      });
    }
  }

  if (!customElements.get("recall-rating")) {
    customElements.define("recall-rating", RecallRatingElement);
  }
</script>

<style>
  recall-rating {
    display: block;
  }

  .recall-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .recall-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .recall-heading {
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    font-weight: 600;
    margin: 0;
    font-family: var(--font-sans);
  }

  .recall-status-badge {
    font-size: var(--fs-micro);
    font-family: var(--font-sans);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-xs);
    letter-spacing: 0.03em;
  }
  .recall-status-badge:empty {
    display: none;
  }
  .recall-status-badge.status-overdue {
    color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--status-hard) 30%, transparent);
  }
  .recall-status-badge.status-due {
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid color-mix(in srgb, var(--status-medium) 30%, transparent);
  }
  .recall-status-badge.status-upcoming {
    color: var(--status-easy);
    background: color-mix(in srgb, var(--status-easy) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--status-easy) 30%, transparent);
  }

  .recall-prompt {
    margin: 0 0 1rem;
    font-size: var(--fs-sm);
    color: var(--text);
    font-family: var(--font-sans);
  }

  .recall-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .recall-btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.65rem 0.5rem;
    background: var(--surface-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, opacity 0.15s;
  }

  .recall-btn:hover:not(:disabled) {
    border-color: var(--accent);
  }

  .recall-btn:disabled {
    opacity: var(--dim-soft);
    cursor: default;
  }
  .recall-btn:disabled.selected {
    opacity: 1;
  }

  .btn-label {
    font-size: var(--fs-fine);
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: 0.03em;
  }

  .btn-hint {
    font-size: var(--fs-micro);
    color: var(--muted);
    font-family: var(--font-sans);
  }

  .again .btn-label { color: var(--status-hard); }
  .again.selected { border-color: var(--status-hard); background: color-mix(in srgb, var(--status-hard) 12%, transparent); }

  .hard .btn-label { color: var(--status-medium); }
  .hard.selected { border-color: var(--status-medium); background: color-mix(in srgb, var(--status-medium) 12%, transparent); }

  .good .btn-label { color: var(--status-easy); }
  .good.selected { border-color: var(--status-easy); background: color-mix(in srgb, var(--status-easy) 12%, transparent); }

  .easy .btn-label { color: var(--status-info); }
  .easy.selected { border-color: var(--status-info); background: color-mix(in srgb, var(--status-info) 12%, transparent); }

  .recall-result {
    margin: 0.75rem 0 0;
    font-size: var(--fs-fine);
    color: var(--muted);
    font-family: var(--font-sans);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .recall-result.visible {
    opacity: 1;
  }
</style>
