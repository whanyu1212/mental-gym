---
import AlgorithmPlayer from '../framework/AlgorithmPlayer.astro';
import type { TeachingStep } from '../../lib/teaching/types';

const initialNums = [3, 4, -1, 1];

const steps: TeachingStep[] = [
  {
    id: 'init',
    phase: 'init',
    array: [3, 4, -1, 1],
    activeIdx: -1,
    targetSlot: -1,
    answer: -1,
    exp: 'First Missing Positive: the answer must be in [1, n+1]. Values in [1, n] should live at index val−1. Use the array itself as a hash table.',
    reason: 'No extra space: encode "number v is present" by placing v at index v-1.',
    invariant: 'After the placement phase, if nums[i] ≠ i+1, then i+1 is missing.',
    formula: 'while nums[i] in [1,n] and nums[i] ≠ nums[nums[i]-1]: swap(nums[i], nums[nums[i]-1])',
    highlights: [
      { target: 'answer-box', kind: 'focus' },
    ],
  },
  {
    id: 'i0-swap1',
    phase: 'swap',
    array: [-1, 4, 3, 1],
    activeIdx: 0,
    targetSlot: 2,
    answer: -1,
    exp: 'i=0, nums[0]=3: belongs at index 2. nums[2] is -1 ≠ 3, so swap → array becomes [-1, 4, 3, 1].',
    reason: 'Moving 3 to index 2 satisfies its "home" invariant in one operation.',
    invariant: 'nums[2]=3 is now correctly placed at index 2.',
    formula: 'swap(nums[0], nums[2]): [3,4,-1,1] → [-1,4,3,1]',
    highlights: [
      { target: 'cell:0', kind: 'compare' },
      { target: 'cell:2', kind: 'write' },
      { target: 'target-slot', kind: 'focus' },
    ],
  },
  {
    id: 'i0-skip',
    phase: 'skip',
    array: [-1, 4, 3, 1],
    activeIdx: 0,
    targetSlot: -1,
    answer: -1,
    exp: 'i=0 again: nums[0]=-1 is out of range [1, 4]. Cannot place it. Advance i to 1.',
    reason: 'Out-of-range values can never be placed; move on.',
    invariant: 'Index 0 has -1 — not 1, so 1 may still be missing.',
    formula: 'nums[0] = -1 ∉ [1,4] → i++',
    highlights: [
      { target: 'cell:0', kind: 'discard' },
    ],
  },
  {
    id: 'i1-double-swap',
    phase: 'swap',
    array: [1, -1, 3, 4],
    activeIdx: 1,
    targetSlot: 0,
    answer: -1,
    exp: 'i=1, nums[1]=4: belongs at index 3. Swap → [-1,1,3,4]. Now nums[1]=1: belongs at index 0. Swap again → [1,-1,3,4].',
    reason: 'After each swap the new value at position i must be checked — loop until it is in-place or out-of-range.',
    invariant: 'nums[0]=1 and nums[2]=3 and nums[3]=4 are all correctly placed.',
    formula: 'swap(1,3): [-1,4,3,1]→[-1,1,3,4]; swap(1,0): →[1,-1,3,4]',
    highlights: [
      { target: 'cell:1', kind: 'compare' },
      { target: 'cell:0', kind: 'write' },
      { target: 'cell:3', kind: 'write' },
      { target: 'target-slot', kind: 'focus' },
    ],
  },
  {
    id: 'i1-skip',
    phase: 'skip',
    array: [1, -1, 3, 4],
    activeIdx: 1,
    targetSlot: -1,
    answer: -1,
    exp: 'i=1: nums[1]=-1 is out of range. Advance i to 2. nums[2]=3 is already at index 2 ✓. Advance i to 3. nums[3]=4 is already at index 3 ✓.',
    reason: 'Already-placed and out-of-range values both allow advancing i.',
    invariant: 'Placement phase complete: [1,-1,3,4].',
    formula: 'nums[1]=-1 → i++; nums[2]=3=2+1 ✓ → i++; nums[3]=4=3+1 ✓ → i++',
    highlights: [
      { target: 'cell:1', kind: 'discard' },
      { target: 'cell:2', kind: 'confirmed' },
      { target: 'cell:3', kind: 'confirmed' },
    ],
  },
  {
    id: 'scan-done',
    phase: 'done',
    array: [1, -1, 3, 4],
    activeIdx: 1,
    targetSlot: -1,
    answer: 2,
    exp: 'Scan: index 0 has 1 ✓. Index 1 has -1 ≠ 2 → first missing positive is 2.',
    reason: 'The first index i where nums[i] ≠ i+1 reveals the missing number.',
    invariant: 'Every index before 1 is correctly filled; index 1 is not → answer = 2.',
    formula: 'for i in range(n): if nums[i] ≠ i+1: return i+1; return n+1',
    highlights: [
      { target: 'cell:0', kind: 'confirmed' },
      { target: 'cell:1', kind: 'match' },
      { target: 'answer-box', kind: 'confirmed' },
    ],
  },
];
---

<index-hash-viz>
  <AlgorithmPlayer title="First Missing Positive — nums=[3,4,-1,1]" steps={steps}>
    <div class="stats-row">
      <div class="stat-box" data-teach-target="answer-box">
        <span class="stat-label">Answer</span>
        <span class="stat-val ih-answer">—</span>
      </div>
    </div>

    <div class="anim-row">
      <p class="anim-label">Array (index as hash)</p>
      <div class="array-region">
        <div class="index-labels">
          {initialNums.map((_, i) => (
            <div class="idx-label-cell" data-teach-target={`slot-label:${i}`}>
              <span class="slot-target">→ {i + 1}</span>
            </div>
          ))}
        </div>
        <div class="array-row">
          {initialNums.map((n, i) => (
            <div class="array-cell ih-cell" data-idx={i} data-teach-target={`cell:${i}`}>
              <span class="cell-val ih-val">{n}</span>
              <span class="cell-idx">{i}</span>
            </div>
          ))}
        </div>
        <div class="target-row">
          <span class="target-indicator" data-teach-target="target-slot">target slot</span>
        </div>
      </div>
    </div>
  </AlgorithmPlayer>
</index-hash-viz>

<script>
  class IndexHashViz extends HTMLElement {
    connectedCallback() {
      this.cells = Array.from(this.querySelectorAll('.ih-cell'));
      this.answerEl = this.querySelector('.ih-answer');
      this.answerBox = this.querySelector('[data-teach-target="answer-box"]');
      this.targetSlotEl = this.querySelector('[data-teach-target="target-slot"]');
      this.slotLabels = Array.from(this.querySelectorAll('[data-teach-target^="slot-label:"]'));

      this.addEventListener('step-change', (e) => {
        const step = e.detail.step;

        // Update cell values from step array
        if (step.array) {
          this.cells.forEach((cell) => {
            const i = parseInt(cell.dataset.idx ?? '0', 10);
            const valEl = cell.querySelector('.ih-val');
            if (valEl) valEl.textContent = step.array[i];
          });
        }

        // Reset cell state classes
        this.cells.forEach((cell) => {
          cell.className = 'array-cell ih-cell';
          const i = parseInt(cell.dataset.idx ?? '0', 10);
          if (step.array) {
            // Mark correctly placed values
            if (step.array[i] === i + 1) cell.classList.add('placed');
          }
        });

        // Active and target slot highlights
        if (step.activeIdx >= 0) {
          const activeCell = this.cells[step.activeIdx];
          if (activeCell) {
            if (step.array && step.array[step.activeIdx] === step.activeIdx + 1) {
              activeCell.classList.add('placed');
            } else {
              activeCell.classList.add('active');
            }
          }
        }

        if (step.targetSlot >= 0) {
          const targetCell = this.cells[step.targetSlot];
          if (targetCell) targetCell.classList.add('target');
        }

        // Update target slot indicator
        if (this.targetSlotEl) {
          if (step.targetSlot >= 0) {
            this.targetSlotEl.textContent = `target: index ${step.targetSlot} (for value ${step.targetSlot + 1})`;
            this.targetSlotEl.classList.add('visible');
          } else {
            this.targetSlotEl.textContent = 'target slot';
            this.targetSlotEl.classList.remove('visible');
          }
        }

        // Update answer
        if (this.answerEl) {
          this.answerEl.textContent = step.answer > 0 ? step.answer : '—';
        }

        if (this.answerBox) {
          this.answerBox.classList.toggle('success-box', step.phase === 'done');
        }
      });
    }
  }

  if (!customElements.get('index-hash-viz')) {
    customElements.define('index-hash-viz', IndexHashViz);
  }
</script>

<style>
  index-hash-viz { display: block; }

  .array-region {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .index-labels {
    display: flex;
    gap: 8px;
  }

  .idx-label-cell {
    width: 48px;
    min-width: 48px;
    text-align: center;
  }

  .slot-target {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    color: var(--muted);
  }

  .target-row {
    min-height: 20px;
    display: flex;
    align-items: center;
    margin-top: 2px;
  }

  .target-indicator {
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    color: var(--muted);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px dashed transparent;
    transition: all 0.25s;
  }

  .target-indicator.visible {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  /* Cell states */
  .ih-cell.placed .cell-val {
    border-color: var(--status-easy);
    color: var(--status-easy);
    background: color-mix(in srgb, var(--status-easy) 10%, transparent);
  }

  .ih-cell.active {
    transform: translateY(-4px);
  }
  .ih-cell.active .cell-val {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .ih-cell.target .cell-val {
    border-color: var(--status-hard);
    color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 10%, transparent);
  }

  .stat-box.success-box {
    border-color: var(--status-easy) !important;
    background: color-mix(in srgb, var(--status-easy) 10%, transparent) !important;
  }
  .stat-box.success-box .stat-val {
    color: var(--status-easy) !important;
  }
</style>
