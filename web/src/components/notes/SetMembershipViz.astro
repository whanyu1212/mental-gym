---
import AlgorithmPlayer from '../framework/AlgorithmPlayer.astro';
import type { TeachingStep } from '../../lib/teaching/types';

const nums = [100, 4, 200, 1, 3, 2];

const steps: TeachingStep[] = [
  {
    id: 'init',
    phase: 'build-set',
    active: -1,
    longest: 0,
    seqValues: [],
    skipVal: null,
    exp: 'Insert all values into a hash set. Set membership tests are O(1), so we can later check "is x-1 in set?" instantly for any value.',
    reason: 'A set de-duplicates and enables constant-time predecessor checks.',
    invariant: 'The set contains every input value exactly once.',
    formula: 'num_set = set(nums)',
    highlights: [
      { target: 'set-display', kind: 'write' },
      { target: 'array-row', kind: 'focus' },
    ],
  },
  {
    id: 'check-100',
    phase: 'check-start',
    active: 0,
    longest: 0,
    seqValues: [],
    skipVal: null,
    exp: 'Check 100: predecessor 99 is NOT in set → 100 is a sequence start. Expand forward: 101 missing, so length = 1.',
    reason: 'Only sequence starts trigger counting. If x-1 existed, we would count the same sequence redundantly.',
    invariant: 'A number starts a sequence iff its predecessor is absent from the set.',
    formula: '99 not in set → start; while (100+len) in set: len++',
    highlights: [
      { target: 'cell:0', kind: 'compare' },
      { target: 'set-display', kind: 'compare' },
      { target: 'seq-box', kind: 'write' },
      { target: 'longest-box', kind: 'write' },
    ],
  },
  {
    id: 'check-4',
    phase: 'skip',
    active: 1,
    longest: 1,
    seqValues: [],
    skipVal: 4,
    exp: 'Check 4: predecessor 3 IS in set → 4 is not a sequence start. Skip entirely — this avoids re-scanning [1,2,3,4] starting from 4.',
    reason: 'Skipping non-starts is the key O(n) insight: every element is visited at most twice total.',
    invariant: 'Only the smallest element of each run triggers the expansion loop.',
    formula: '3 in set → skip',
    highlights: [
      { target: 'cell:1', kind: 'discard' },
      { target: 'set-display', kind: 'compare' },
    ],
  },
  {
    id: 'check-1',
    phase: 'check-start',
    active: 3,
    longest: 4,
    seqValues: [1, 2, 3, 4],
    skipVal: null,
    exp: 'Check 1: predecessor 0 is NOT in set → sequence start. Expand forward: 2, 3, 4 all in set, 5 missing. Length = 4. Update longest to 4.',
    reason: 'Starting from 1 and walking forward finds the full [1,2,3,4] run in O(length) steps.',
    invariant: 'longest = max(longest, current run length) after each start.',
    formula: '0 not in set → start; 2,3,4 in set → len=4; longest=max(1,4)=4',
    highlights: [
      { target: 'cell:3', kind: 'compare' },
      { target: 'set-display', kind: 'compare' },
      { target: 'seq-box', kind: 'confirmed' },
      { target: 'longest-box', kind: 'confirmed' },
    ],
  },
  {
    id: 'result',
    phase: 'done',
    active: -1,
    longest: 4,
    seqValues: [1, 2, 3, 4],
    skipVal: null,
    exp: 'All values scanned. Longest consecutive sequence is [1, 2, 3, 4] with length 4. Total work: O(n) — each value is a start at most once and a successor at most once.',
    reason: 'The set-membership check eliminates all redundant re-scans, achieving overall linear time.',
    invariant: 'Answer = maximum chain length found across all valid starts.',
    formula: 'return 4',
    highlights: [
      { target: 'result-box', kind: 'confirmed' },
      { target: 'longest-box', kind: 'confirmed' },
      { target: 'seq-box', kind: 'confirmed' },
    ],
  },
];
---

<set-viz>
  <AlgorithmPlayer title="Set Membership — Longest Consecutive Sequence, nums=[100,4,200,1,3,2]" steps={steps}>
    <div class="stats-row">
      <div class="stat-box" data-teach-target="longest-box">
        <span class="stat-label">Longest</span>
        <span class="stat-val sv-longest">0</span>
      </div>
      <div class="stat-box sv-seq-stat" data-teach-target="seq-box">
        <span class="stat-label">Current Sequence</span>
        <span class="stat-val sv-seq-val">—</span>
      </div>
      <div class="stat-box sv-result-stat" data-teach-target="result-box">
        <span class="stat-label">Status</span>
        <span class="stat-val sv-status-val">In Progress</span>
      </div>
    </div>

    <div class="anim-row">
      <p class="anim-label">Array</p>
      <div class="array-row sv-array" data-teach-target="array-row">
        {nums.map((n, i) => (
          <div class="array-cell sv-cell" data-idx={i} data-val={n} data-teach-target={`cell:${i}`}>
            <span class="cell-val sv-cell-val">{n}</span>
            <span class="cell-idx">{i}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="anim-row">
      <p class="anim-label">Hash Set — O(1) membership</p>
      <div class="hashmap-row sv-set-row" data-teach-target="set-display">
        {nums.map((n) => (
          <span class="sv-set-pill" data-val={n}>{n}</span>
        ))}
      </div>
    </div>
  </AlgorithmPlayer>
</set-viz>

<script>
  class SetViz extends HTMLElement {
    connectedCallback() {
      this.cells = Array.from(this.querySelectorAll('.sv-cell'));
      this.setPills = Array.from(this.querySelectorAll('.sv-set-pill'));
      this.longestEl = this.querySelector('.sv-longest');
      this.seqValEl = this.querySelector('.sv-seq-val');
      this.statusEl = this.querySelector('.sv-status-val');
      this.resultStat = this.querySelector('.sv-result-stat');
      this.seqStat = this.querySelector('.sv-seq-stat');

      this.addEventListener('step-change', (e) => {
        const s = e.detail.step;

        if (this.longestEl) this.longestEl.textContent = String(s.longest);

        if (this.seqValEl) {
          this.seqValEl.textContent =
            s.seqValues && s.seqValues.length > 0
              ? `[${s.seqValues.join(', ')}]`
              : '—';
        }

        if (this.statusEl) {
          this.statusEl.textContent = s.phase === 'done' ? 'Complete' : 'In Progress';
        }

        this.resultStat?.classList.toggle('sv-done', s.phase === 'done');

        this.cells.forEach((cell) => {
          const i = parseInt(cell.dataset.idx ?? '0', 10);
          const v = parseInt(cell.dataset.val ?? '0', 10);
          const valSpan = cell.querySelector('.sv-cell-val');
          if (!valSpan) return;

          valSpan.className = 'cell-val sv-cell-val';

          if (s.phase === 'done') {
            if (s.seqValues?.includes(v)) valSpan.classList.add('sv-in-seq');
          } else if (i === s.active) {
            if (s.phase === 'skip') valSpan.classList.add('sv-skip');
            else valSpan.classList.add('sv-active-start');
          } else if (s.seqValues?.includes(v) && s.phase === 'check-start') {
            valSpan.classList.add('sv-in-seq');
          }
        });

        this.setPills.forEach((pill) => {
          const v = parseInt(pill.dataset.val ?? '0', 10);
          pill.className = 'sv-set-pill';

          if (s.skipVal !== null && v === s.skipVal - 1) {
            pill.classList.add('sv-pred-found');
          } else if (s.seqValues?.includes(v) && s.phase !== 'init') {
            pill.classList.add('sv-seq-member');
          }
        });
      });
    }
  }

  if (!customElements.get('set-viz')) {
    customElements.define('set-viz', SetViz);
  }
</script>

<style>
  set-viz { display: block; }

  .sv-cell-val {
    transition: border-color 0.2s, color 0.2s, background 0.2s, transform 0.2s;
  }

  .sv-cell-val.sv-active-start {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    transform: translateY(-4px);
  }

  .sv-cell-val.sv-skip {
    border-color: var(--status-hard);
    color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 10%, transparent);
    opacity: 0.7;
  }

  .sv-cell-val.sv-in-seq {
    border-color: var(--status-easy);
    color: var(--status-easy);
    background: color-mix(in srgb, var(--status-easy) 12%, transparent);
  }

  .sv-set-row {
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sv-set-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: var(--fs-fine);
    color: var(--text);
    background: var(--panel);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .sv-set-pill.sv-pred-found {
    border-color: var(--status-hard);
    color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 15%, transparent);
  }

  .sv-set-pill.sv-seq-member {
    border-color: var(--status-easy);
    color: var(--status-easy);
    background: color-mix(in srgb, var(--status-easy) 12%, transparent);
  }

  .sv-result-stat.sv-done {
    border-color: color-mix(in srgb, var(--status-easy) 55%, transparent);
    background: color-mix(in srgb, var(--status-easy) 10%, transparent);
  }

  .sv-result-stat.sv-done .stat-val {
    color: var(--status-easy);
  }

  .sv-seq-stat .stat-val {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }
</style>
