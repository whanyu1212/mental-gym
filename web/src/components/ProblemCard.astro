---
import type { Problem } from "../data/problems";

interface Props {
	problem: Problem;
}

const { problem } = Astro.props;
---

<article class="card">
	<div class="card-head">
		<p class="meta">#{problem.id}</p>
		<span class={`difficulty ${problem.difficulty.toLowerCase()}`}>
			{problem.difficulty}
		</span>
	</div>
	<h2>
		<a href={`/problems/${problem.slug}/`}>{problem.title}</a>
	</h2>
	<p class="statement">{problem.statement}</p>
	<div class="topics">
		{problem.topics.map((topic) => <span class="topic">{topic}</span>)}
	</div>
</article>

<style>
	.card {
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1rem;
		display: grid;
		gap: 0.75rem;
	}

	.card-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}

	.meta {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	h2 {
		margin: 0;
		font-size: 1.1rem;
	}

	.statement {
		margin: 0;
		color: var(--muted);
		line-height: 1.4;
	}

	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.topic,
	.difficulty {
		font-size: 0.78rem;
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--border);
	}

	.easy {
		color: #7fffc4;
	}

	.medium {
		color: #ffd280;
	}

	.hard {
		color: #ff9f9f;
	}
</style>
