---
import { courses, exerciseHref, totalHours, type RoadmapModule } from "../../data/roadmap";
import { withBase } from "../../lib/url";

interface Props {
	module: RoadmapModule;
	week: number;
}

const { module, week } = Astro.props;
const courseById = new Map(courses.map((course) => [course.id, course]));
---

<article class="week-card" id={`week-${week}`}>
	<header>
		<div>
			<p class="eyebrow">Week {String(week).padStart(2, "0")} · {module.phase}</p>
			<h2>{module.title}</h2>
			<p class="summary">{module.summary}</p>
		</div>
		<span class="hours">{totalHours(module.hours)}h</span>
	</header>

	<dl class="allocation" aria-label={`Week ${week} time allocation`}>
		<div><dt>Study</dt><dd>{module.hours.study}h</dd></div>
		<div><dt>Implement</dt><dd>{module.hours.implementation}h</dd></div>
		<div><dt>Interview</dt><dd>{module.hours.interview}h</dd></div>
		<div><dt>Language</dt><dd>{module.hours.language}h</dd></div>
	</dl>

	<div class="week-grid">
		<section>
			<h3>Learn</h3>
			<ul>
				{module.resources.map((resource) => {
					const course = courseById.get(resource.courseId);
					return course && (
						<li>
							<a href={course.url}>{course.code}: {resource.selection}</a>
							<small>{course.offering}</small>
						</li>
					);
				})}
			</ul>
		</section>

		<section>
			<h3>Practice</h3>
			<ul>
				{module.exercises.map((exercise) => (
					<li><a href={withBase(exerciseHref(exercise))}>{exercise.label}</a></li>
				))}
			</ul>
		</section>
	</div>

	<section class="deliverable">
		<h3>Deliverable</h3>
		<p>{module.deliverable}</p>
		<p class="evidence"><strong>Evidence:</strong> {module.evidence.join(" · ")}</p>
	</section>

	{module.stretch && module.stretch.length > 0 && (
		<details>
			<summary>Optional stretch</summary>
			<ul>{module.stretch.map((item) => <li>{item}</li>)}</ul>
		</details>
	)}
</article>

<style>
	.week-card {
		background: color-mix(in srgb, var(--glass-surface-strong) 94%, transparent);
		border: 1px solid var(--glass-border-strong);
		border-radius: var(--radius-lg);
		box-shadow: inset 0 1px 0 var(--glass-highlight-strong), var(--shadow-sm);
		padding: 1.5rem;
		scroll-margin-top: 130px;
	}

	header {
		align-items: start;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
	}

	.eyebrow,
	h3,
	dt {
		color: var(--accent);
		font: 600 var(--fs-eyebrow) var(--font-sans);
		letter-spacing: 0.11em;
		margin: 0;
		text-transform: uppercase;
	}

	h2 {
		font: 600 var(--fs-display) var(--font-serif);
		margin: 0.4rem 0;
	}

	.summary,
	.deliverable p {
		color: var(--muted);
		font: var(--fs-sm) / var(--lh-normal) var(--font-sans);
		margin: 0;
		max-width: 720px;
	}

	.hours {
		background: var(--accent-soft);
		border: 1px solid var(--accent-ring);
		border-radius: var(--radius-pill);
		color: var(--accent);
		flex: 0 0 auto;
		font: 600 var(--fs-sm) var(--font-mono);
		padding: 0.35rem 0.7rem;
	}

	.allocation {
		display: grid;
		gap: 0.5rem;
		grid-template-columns: repeat(4, 1fr);
		margin: 1.25rem 0;
	}

	.allocation div {
		background: var(--glass-surface);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-sm);
		padding: 0.65rem;
	}

	dd {
		color: var(--text);
		font: 600 var(--fs-lg) var(--font-serif);
		margin: 0.25rem 0 0;
	}

	.week-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	h3 {
		margin-bottom: 0.55rem;
	}

	ul {
		margin: 0;
		padding-left: 1.2rem;
	}

	li {
		color: var(--muted);
		font: var(--fs-sm) / 1.55 var(--font-sans);
		margin-bottom: 0.4rem;
	}

	a {
		color: var(--text);
	}

	a:hover {
		color: var(--accent);
	}

	small {
		color: var(--muted);
		display: block;
		font-size: var(--fs-fine);
	}

	.deliverable {
		border-top: 1px solid var(--border);
		margin-top: 1.2rem;
		padding-top: 1rem;
	}

	.deliverable p {
		color: var(--text);
	}

	.deliverable .evidence {
		color: var(--muted);
		font-size: var(--fs-fine);
		margin-top: 0.45rem;
	}

	details {
		border-top: 1px solid var(--border);
		color: var(--muted);
		font: var(--fs-sm) var(--font-sans);
		margin-top: 1rem;
		padding-top: 0.8rem;
	}

	summary {
		color: var(--accent);
		cursor: pointer;
		font-weight: 600;
	}

	details ul {
		margin-top: 0.6rem;
	}

	@media (max-width: 620px) {
		.week-card {
			padding: 1.1rem;
		}

		.allocation,
		.week-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 420px) {
		.week-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
