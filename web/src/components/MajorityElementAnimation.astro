---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const nums = [2, 2, 1, 1, 1, 2, 2];

const steps = [
  { i: -1, candidate: null, count: 0, exp: "Initial state. Set candidate to null and count to 0." },
  { i: 0, candidate: 2, count: 1, exp: "count is 0. Set candidate to nums[0] (2). count becomes 1." },
  { i: 1, candidate: 2, count: 2, exp: "nums[1] is 2. It matches candidate! count increments to 2." },
  { i: 2, candidate: 2, count: 1, exp: "nums[2] is 1. Doesn't match candidate (2). count decrements to 1." },
  { i: 3, candidate: 2, count: 0, exp: "nums[3] is 1. Doesn't match candidate. count decrements to 0." },
  { i: 4, candidate: 1, count: 1, exp: "count is 0! Set candidate to nums[4] (1). count becomes 1." },
  { i: 5, candidate: 1, count: 0, exp: "nums[5] is 2. Doesn't match candidate (1). count decrements to 0." },
  { i: 6, candidate: 2, count: 1, exp: "count is 0! Set candidate to nums[6] (2). count becomes 1." },
  { i: -1, candidate: 2, count: 1, exp: "Finished array. The remaining candidate is 2, which is the majority element!" },
];
---

<majority-element-visuals>
  <AlgorithmPlayer title="nums = [2, 2, 1, 1, 1, 2, 2]" steps={steps}>

    <div class="stats-row" style="margin-bottom: 2rem;">
      <div class="stat-box highlight">
        <span class="stat-label">Candidate</span>
        <span class="stat-val me-candidate">-</span>
      </div>
      <div class="stat-box" style="border-color: rgba(90, 130, 176, 0.4); background: rgba(90, 130, 176, 0.05);">
        <span class="stat-label">Count (Votes)</span>
        <span class="stat-val me-count" style="color: #5a82b0;">0</span>
      </div>
    </div>

    <!-- Array -->
    <div class="anim-row">
      <p class="anim-label">Array (Boyer-Moore Voting)</p>
      <div class="array-row me-array">
        {nums.map((n, i) => (
          <div class="array-col">
            <div class="array-cell me-cell" data-idx={i}>
              <span class="cell-val">{n}</span>
              <span class="cell-idx">{i}</span>
            </div>
            <div class="pointers-row me-ptr-col" data-idx={i}>
              <span class="ptr ptr-up hidden">i</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </AlgorithmPlayer>
</majority-element-visuals>

<script>
  class MajorityElementVisuals extends HTMLElement {
    connectedCallback() {
      this.cells = Array.from(this.querySelectorAll(".me-cell"));
      this.ptrs = Array.from(this.querySelectorAll(".me-ptr-col"));
      this.candEl = this.querySelector(".me-candidate");
      this.countEl = this.querySelector(".me-count");

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        // Stats
        if (this.candEl) this.candEl.textContent = s.candidate !== null ? s.candidate : "-";
        if (this.countEl) this.countEl.textContent = s.count;

        // Cells
        this.cells.forEach((cell: any, i: number) => {
          const valSpan = cell.querySelector(".cell-val");
          if (valSpan) {
            valSpan.className = "cell-val";
            if (i < s.i) valSpan.classList.add("visited");
            if (i === s.i) {
               // Determine match vs mismatch visually
               if (s.count === 0) {
                 // Dec to 0
                 valSpan.classList.add("conflict");
               } else if (s.count === 1 && e.detail.index > 0 && this.cells[i-1] && this.cells[i-1].querySelector('.cell-val')?.classList.contains('conflict')) {
                 // Just swapped candidate
                 valSpan.classList.add("active-new");
               } else {
                 valSpan.classList.add("active-eval");
               }
            } else if (s.i === -1 && e.detail.index > 0) {
               // End
               valSpan.classList.add("visited");
            }
          }
        });

        // Pointer
        this.ptrs.forEach((col: any, i: number) => {
          const ptr = col.querySelector(".ptr-up");
          if (ptr) ptr.className = `ptr ptr-up ${i === s.i ? "" : "hidden"}`;
        });
      });
    }
  }

  if (!customElements.get('majority-element-visuals')) {
    customElements.define('majority-element-visuals', MajorityElementVisuals);
  }
</script>

<style>
  majority-element-visuals {
    display: block;
  }

  .stat-box.highlight {
    border-color: rgba(201, 168, 76, 0.4);
    background: rgba(201, 168, 76, 0.05);
  }
  .stat-box.highlight .stat-val {
    color: var(--accent);
  }

  .cell-val.visited {
    opacity: 0.4;
  }

  .cell-val.active-eval {
    border-color: #7dab7d;
    color: #a0d0a0;
    background: rgba(125, 171, 125, 0.15);
    transform: translateY(-4px);
  }

  .cell-val.active-new {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(201, 168, 76, 0.15);
    transform: translateY(-4px);
  }

  .cell-val.conflict {
    border-color: #b05a5a !important;
    color: #e09090 !important;
    background: rgba(176, 90, 90, 0.15) !important;
    transform: translateY(-4px);
  }

  .ptr-up {
    color: var(--accent);
    font-weight: bold;
    font-size: 1.2rem;
    transition: opacity 0.2s;
  }
</style>
