---
interface Props {
	language: "Python" | "Julia";
	code: string;
}

const { language, code } = Astro.props;
---

<section class="solution" data-revealed="false">
	<div class="solution-head">
		<h3>{language} Solution</h3>
		<button type="button" class="toggle" data-solution-toggle>
			Tap to reveal
		</button>
	</div>
	<pre class="solution-code" tabindex="0"><code>{code}</code></pre>
</section>

<script>
	document.querySelectorAll("[data-solution-toggle]").forEach((button) => {
		button.addEventListener("click", () => {
			const container = button.closest(".solution");
			if (!container) return;

			const next = container.getAttribute("data-revealed") !== "true";
			container.setAttribute("data-revealed", String(next));
			button.textContent = next ? "Hide again" : "Tap to reveal";
		});
	});
</script>

<style>
	.solution {
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1rem;
	}

	.solution-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	h3 {
		margin: 0;
		font-size: 1rem;
	}

	.toggle {
		background: transparent;
		border: 1px solid var(--border);
		color: var(--text);
		border-radius: 8px;
		padding: 0.4rem 0.7rem;
		cursor: pointer;
	}

	.solution-code {
		margin: 0;
		padding: 0.9rem;
		background: #0a0f1d;
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow-x: auto;
		filter: blur(7px);
		transition: filter 0.2s ease;
	}

	.solution[data-revealed="true"] .solution-code,
	.solution:hover .solution-code,
	.solution:focus-within .solution-code {
		filter: blur(0);
	}

	code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
			"Courier New", monospace;
		font-size: 0.9rem;
		line-height: 1.5;
	}
</style>
