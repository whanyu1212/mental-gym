---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const s = "()[]{}".split("");

const steps = [
  { i: 0, char: '(', stack: ['('], valid: true, exp: "Read '('. It's an opening bracket, push to stack." },
  { i: 1, char: ')', stack: [], valid: true, exp: "Read ')'. Matches top of stack '('. Pop from stack." },
  { i: 2, char: '[', stack: ['['], valid: true, exp: "Read '['. It's an opening bracket, push to stack." },
  { i: 3, char: ']', stack: [], valid: true, exp: "Read ']'. Matches top of stack '['. Pop from stack." },
  { i: 4, char: '{', stack: ['{'], valid: true, exp: "Read '{'. It's an opening bracket, push to stack." },
  { i: 5, char: '}', stack: [], valid: true, exp: "Read '}'. Matches top of stack '{'. Pop from stack." },
  { i: 6, char: '', stack: [], valid: true, exp: "End of string. Stack is empty. Valid parentheses!" },
];
---

<valid-parentheses-visuals>
  <AlgorithmPlayer title="s = '()[]{}'" steps={steps}>
    <div class="anim-row" style="display: flex; gap: 3rem; align-items: flex-end; min-height: 200px;">

      <!-- Left: String Array -->
      <div style="flex: 1;">
        <p class="anim-label">String</p>
        <div class="array-row vp-string-row">
          {s.map((char, i) => (
            <div class="array-col">
              <div class="array-cell vp-char-cell" data-idx={i}>
                <span class="cell-val">{char}</span>
                <span class="cell-idx">{i}</span>
              </div>
              <div class="pointers-row vp-ptr-col" data-idx={i}>
                <span class="ptr ptr-l hidden">i</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Stack -->
      <div style="width: 120px; display: flex; flex-direction: column; align-items: center;">
        <p class="anim-label">Stack</p>
        <div class="stack-container vp-stack">
          <!-- Stack elements dynamically rendered here -->
        </div>
        <div class="stack-base"></div>
      </div>
    </div>
  </AlgorithmPlayer>
</valid-parentheses-visuals>

<script>
  class ValidParenthesesVisuals extends HTMLElement {
    connectedCallback() {
      this.charCells = Array.from(this.querySelectorAll(".vp-char-cell"));
      this.ptrCols = Array.from(this.querySelectorAll(".vp-ptr-col"));
      this.stackEl = this.querySelector(".vp-stack");

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        // String Highlights
        this.charCells.forEach((cell: any, i: number) => {
          const valSpan = cell.querySelector(".cell-val");
          if (valSpan) {
            valSpan.classList.remove("active-eval", "visited", "conflict");
            if (i < s.i) valSpan.classList.add("visited");
            if (i === s.i) {
              valSpan.classList.add("active-eval");
              if (!s.valid) valSpan.classList.add("conflict");
            }
          }
        });

        // Pointer
        this.ptrCols.forEach((col: any, i: number) => {
          const ptr = col.querySelector(".ptr-l");
          if (ptr) ptr.className = `ptr ptr-l ${i === s.i ? "" : "hidden"}`;
        });

        // Stack Render
        if (this.stackEl) {
          const stackItems = s.stack.map((char: string, idx: number) => {
            const isTop = idx === s.stack.length - 1;
            return `<div class="stack-item ${isTop ? 'stack-top' : ''}">${char}</div>`;
          });

          // Add placeholders to keep height consistent (optional, or let flex-end handle it)
          this.stackEl.innerHTML = stackItems.reverse().join(""); // visually top element first

          if (s.stack.length === 0) {
            this.stackEl.innerHTML = `<span class="stack-empty">Empty</span>`;
          }
        }
      });
    }
  }

  if (!customElements.get('valid-parentheses-visuals')) {
    customElements.define('valid-parentheses-visuals', ValidParenthesesVisuals);
  }
</script>

<style>
  valid-parentheses-visuals {
    display: block;
  }

  .vp-string-row {
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .cell-val.active-eval {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(201, 168, 76, 0.15);
    transform: translateY(-4px);
  }

  .cell-val.conflict {
    border-color: #b05a5a !important;
    color: #e09090 !important;
    background: rgba(176, 90, 90, 0.15) !important;
    animation: shake 0.4s ease-in-out;
  }

  .cell-val.visited {
    opacity: 0.3;
  }

  .ptr-l { background: rgba(201, 168, 76, 0.2); color: #c9a84c; }

  /* Stack Styles */
  .stack-container {
    width: 100px;
    height: 150px;
    border-left: 2px solid var(--border);
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    background: #0a0a0a;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 0.5rem;
    gap: 0.25rem;
    border-radius: 0 0 4px 4px;
    position: relative;
    overflow: hidden;
  }

  .stack-base {
    width: 120px;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    margin-top: 2px;
  }

  .stack-item {
    width: 100%;
    height: 2rem;
    min-height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 2px;
    font-family: ui-monospace, monospace;
    font-size: 1rem;
    color: var(--text);
    animation: slide-down 0.2s ease-out forwards;
  }

  .stack-top {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(201, 168, 76, 0.1);
    box-shadow: 0 0 8px rgba(201, 168, 76, 0.2);
  }

  .stack-empty {
    font-size: 0.8rem;
    color: var(--muted);
    font-style: italic;
    opacity: 0.5;
    margin-bottom: 1rem;
  }

  @keyframes slide-down {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0) translateY(-4px); }
    25% { transform: translateX(-4px) translateY(-4px); }
    75% { transform: translateX(4px) translateY(-4px); }
  }
</style>
