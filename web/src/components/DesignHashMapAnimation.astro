---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const operations = [
  { op: 'put', key: 1, val: 1 },
  { op: 'put', key: 2, val: 2 },
  { op: 'get', key: 1 },
  { op: 'get', key: 3 },
  { op: 'put', key: 2, val: 1 },
  { op: 'get', key: 2 },
  { op: 'remove', key: 2 },
  { op: 'get', key: 2 }
];

const steps = [
  { p: -1, op: 'init', key: null, val: null, hash: null, map: [[], [], [], []], exp: "Initialize HashMap with 4 buckets. Each bucket contains a list of Key-Value pairs to handle collisions." },
  { p: 0, op: 'put', key: 1, val: 1, hash: 1, map: [[], [{k:1, v:1}], [], []], exp: "put(1, 1). Hash = 1 % 4 = 1. Bucket 1 is empty, append [1, 1]." },
  { p: 1, op: 'put', key: 2, val: 2, hash: 2, map: [[], [{k:1, v:1}], [{k:2, v:2}], []], exp: "put(2, 2). Hash = 2 % 4 = 2. Bucket 2 is empty, append [2, 2]." },
  { p: 2, op: 'get', key: 1, val: null, hash: 1, map: [[], [{k:1, v:1}], [{k:2, v:2}], []], exp: "get(1). Hash = 1 % 4 = 1. Look in bucket 1. Found key 1! Return its value: 1." },
  { p: 3, op: 'get', key: 3, val: null, hash: 3, map: [[], [{k:1, v:1}], [{k:2, v:2}], []], exp: "get(3). Hash = 3 % 4 = 3. Look in bucket 3. It's empty. Return -1." },
  { p: 4, op: 'put', key: 2, val: 1, hash: 2, map: [[], [{k:1, v:1}], [{k:2, v:1}], []], exp: "put(2, 1). Hash = 2. Look in bucket 2. Key 2 already exists! Update its value to 1." },
  { p: 5, op: 'get', key: 2, val: null, hash: 2, map: [[], [{k:1, v:1}], [{k:2, v:1}], []], exp: "get(2). Hash = 2. Look in bucket 2. Found key 2! Return its new value: 1." },
  { p: 6, op: 'remove', key: 2, val: null, hash: 2, map: [[], [{k:1, v:1}], [], []], exp: "remove(2). Hash = 2. Look in bucket 2. Key 2 is there, remove the entire pair." },
  { p: 7, op: 'get', key: 2, val: null, hash: 2, map: [[], [{k:1, v:1}], [], []], exp: "get(2). Hash = 2. Look in bucket 2. It's empty. Return -1." }
];

const emptyBuckets = [[], [], [], []];
---

<design-hashmap-visuals>
  <AlgorithmPlayer title="Design HashMap (Buckets = 4)" steps={steps}>

    <div class="stats-row" style="margin-bottom: 2rem; justify-content: center;">
      <div class="stat-box">
        <span class="stat-label">Operation</span>
        <span class="stat-val hm-op" style="font-size: 1rem; color: #90b0e0;">-</span>
      </div>
      <div style="display: flex; align-items: center; color: var(--muted); font-size: 1.5rem;">→</div>
      <div class="stat-box highlight">
        <span class="stat-label">Hash Function</span>
        <span class="stat-val hm-hash" style="font-size: 1rem; font-family: ui-monospace, monospace;">-</span>
      </div>
    </div>

    <!-- Buckets Array -->
    <div class="anim-row" style="display: flex; flex-direction: column; align-items: center;">
      <p class="anim-label">Underlying Array of Lists (Chaining Pairs)</p>

      <div class="array-row hm-buckets" style="gap: 1.5rem; padding: 1rem 0;">
        {emptyBuckets.map((_, i) => (
          <div class="array-col" style="align-items: center; min-width: 5rem;">
            <div class="array-cell hm-bucket-cell" data-idx={i} style="min-height: 4rem; width: 100%; justify-content: flex-start; padding: 0.5rem; background: #0a0a0a; border: 2px solid var(--border); border-top: none; border-radius: 0 0 4px 4px;">
              <!-- Dynamic pairs -->
            </div>
            <span class="cell-idx" style="margin-top: 0.5rem; font-weight: bold;">Bucket {i}</span>
          </div>
        ))}
      </div>
    </div>

  </AlgorithmPlayer>
</design-hashmap-visuals>

<script>
  class DesignHashMapVisuals extends HTMLElement {
    connectedCallback() {
      this.opEl = this.querySelector(".hm-op");
      this.hashEl = this.querySelector(".hm-hash");
      this.bucketCells = Array.from(this.querySelectorAll(".hm-bucket-cell"));

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        // Stats
        if (this.opEl) {
           if (s.op === 'init') this.opEl.textContent = 'Init';
           else if (s.op === 'put') this.opEl.textContent = `put(${s.key}, ${s.val})`;
           else this.opEl.textContent = `${s.op}(${s.key})`;

           if (s.op === 'put') this.opEl.style.color = '#7dab7d';
           else if (s.op === 'remove') this.opEl.style.color = '#e09090';
           else if (s.op === 'get') this.opEl.style.color = '#90b0e0';
           else this.opEl.style.color = 'var(--text)';
        }

        if (this.hashEl) {
           if (s.hash !== null) {
              this.hashEl.textContent = `${s.key} % 4 = ${s.hash}`;
           } else {
              this.hashEl.textContent = "-";
           }
        }

        // Buckets
        this.bucketCells.forEach((cell: any, i: number) => {
          const arr = s.map[i];
          if (arr && arr.length > 0) {
            cell.innerHTML = arr.map((pair: any) => `
              <div style="background: rgba(201, 168, 76, 0.1); border: 1px solid var(--accent); border-radius: 2px; padding: 0.3rem 0.5rem; margin-bottom: 0.4rem; color: var(--text); font-family: ui-monospace, monospace; font-size: 0.85rem; display: flex; justify-content: space-between; gap: 0.5rem; animation: pop-in 0.2s;">
                <span style="color: var(--accent); font-weight: bold;">K:${pair.k}</span>
                <span style="color: var(--muted);">|</span>
                <span style="color: #7dab7d;">V:${pair.v}</span>
              </div>
            `).join("");
          } else {
            cell.innerHTML = "";
          }

          // Highlight active bucket
          if (s.hash === i) {
             cell.style.borderColor = "var(--accent)";
             cell.style.background = "rgba(201, 168, 76, 0.05)";
             cell.style.boxShadow = "0 0 10px rgba(201, 168, 76, 0.2)";
          } else {
             cell.style.borderColor = "var(--border)";
             cell.style.background = "#0a0a0a";
             cell.style.boxShadow = "none";
          }
        });

      });
    }
  }

  if (!customElements.get('design-hashmap-visuals')) {
    customElements.define('design-hashmap-visuals', DesignHashMapVisuals);
  }
</script>

<style>
  design-hashmap-visuals {
    display: block;
  }

  .stat-box.highlight {
    border-color: rgba(201, 168, 76, 0.4);
    background: rgba(201, 168, 76, 0.05);
  }
</style>
