---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const nums = [5, 2, 3, 1];

const steps = [
  {
    phase: 'init',
    arrFull: [5, 2, 3, 1],
    segment: [],
    l: -1,
    r: -1,
    action: 'write',
    exp: 'Start Merge Sort. Recursively split until single elements, then merge back in order.',
    reason: 'Divide-and-conquer reduces sorting into smaller sorted merges.',
    invariant: 'After each merge, the merged range is sorted.',
    formula: 'T(n) = 2T(n/2) + O(n)',
    decision: 'Begin with full range [0..3].',
    targets: ['phase-box', 'main-box', 'focus-box', 'rule-box'],
  },

  {
    phase: 'split',
    arrFull: [5, 2, 3, 1],
    segment: [5, 2],
    l: 0,
    r: 1,
    action: 'shrink',
    exp: 'Split left half: [5, 2].',
    reason: 'First recursion step divides the array into two halves.',
    invariant: 'Split preserves element order within each segment.',
    formula: 'mid = (l+r)//2',
    decision: 'Recurse on left half.',
    targets: ['main-0', 'main-1', 'focus-box'],
  },
  {
    phase: 'split',
    arrFull: [5, 2, 3, 1],
    segment: [5],
    l: 0,
    r: 0,
    action: 'shrink',
    exp: 'Split left again: [5].',
    reason: 'Single element segment is already sorted.',
    invariant: 'Base case size 1 needs no sorting.',
    formula: 'if l == r -> return',
    decision: 'Left base case reached.',
    targets: ['main-0', 'focus-box'],
  },
  {
    phase: 'split',
    arrFull: [5, 2, 3, 1],
    segment: [2],
    l: 1,
    r: 1,
    action: 'shrink',
    exp: 'Split right of left half: [2].',
    reason: 'Second base case for left branch.',
    invariant: 'Both children are now individually sorted.',
    formula: 'size 1 is sorted',
    decision: 'Ready to merge [5] and [2].',
    targets: ['main-1', 'focus-box'],
  },

  {
    phase: 'merge',
    arrFull: [2, 5, 3, 1],
    segment: [2, 5],
    l: 0,
    r: 1,
    action: 'expand',
    exp: 'Merge [5] and [2] -> [2, 5].',
    reason: 'Pick smaller head first while merging two sorted lists.',
    invariant: 'Merged range [0..1] is sorted after this step.',
    formula: 'merge two sorted arrays in O(k)',
    decision: 'Update indices 0..1 to [2,5].',
    targets: ['main-0', 'main-1', 'focus-box'],
  },

  {
    phase: 'split',
    arrFull: [2, 5, 3, 1],
    segment: [3, 1],
    l: 2,
    r: 3,
    action: 'shrink',
    exp: 'Split right half: [3, 1].',
    reason: 'Process the other half recursively.',
    invariant: 'Unprocessed ranges keep original relative order.',
    formula: 'recurse on right half',
    decision: 'Split [2..3].',
    targets: ['main-2', 'main-3', 'focus-box'],
  },
  {
    phase: 'split',
    arrFull: [2, 5, 3, 1],
    segment: [3],
    l: 2,
    r: 2,
    action: 'shrink',
    exp: 'Split left of right half: [3].',
    reason: 'Base case reached for index 2.',
    invariant: 'Single item is sorted.',
    formula: 'size 1',
    decision: 'Hold [3].',
    targets: ['main-2', 'focus-box'],
  },
  {
    phase: 'split',
    arrFull: [2, 5, 3, 1],
    segment: [1],
    l: 3,
    r: 3,
    action: 'shrink',
    exp: 'Split right of right half: [1].',
    reason: 'Base case reached for index 3.',
    invariant: 'Both subsegments ready to merge.',
    formula: 'size 1',
    decision: 'Prepare merge [3] and [1].',
    targets: ['main-3', 'focus-box'],
  },

  {
    phase: 'merge',
    arrFull: [2, 5, 1, 3],
    segment: [1, 3],
    l: 2,
    r: 3,
    action: 'expand',
    exp: 'Merge [3] and [1] -> [1, 3].',
    reason: 'Sorted merge places 1 before 3.',
    invariant: 'Range [2..3] is now sorted.',
    formula: 'merge([3],[1]) = [1,3]',
    decision: 'Update indices 2..3 to [1,3].',
    targets: ['main-2', 'main-3', 'focus-box'],
  },

  {
    phase: 'merge',
    arrFull: [1, 2, 3, 5],
    segment: [1, 2, 3, 5],
    l: 0,
    r: 3,
    action: 'expand',
    exp: 'Final merge: [2, 5] and [1, 3] -> [1, 2, 3, 5].',
    reason: 'Merging two sorted halves gives globally sorted array.',
    invariant: 'Whole range [0..3] becomes sorted.',
    formula: 'merge([2,5],[1,3]) = [1,2,3,5]',
    decision: 'Finish global merge.',
    targets: ['main-0', 'main-1', 'main-2', 'main-3', 'focus-box', 'main-box'],
  },
  {
    phase: 'done',
    arrFull: [1, 2, 3, 5],
    segment: [],
    l: -1,
    r: -1,
    action: 'confirm',
    exp: 'Array is fully sorted.',
    reason: 'All recursive merges completed.',
    invariant: 'Final array is non-decreasing.',
    formula: '[1,2,3,5]',
    decision: 'Return sorted array.',
    targets: ['main-box', 'result-box'],
  },
];
---

<sort-array-visuals>
  <AlgorithmPlayer title="Merge Sort (O(N log N))" steps={steps}>
    <div class="stats-row sa-meta-row">
      <div class="stat-box sa-phase-box" data-teach-target="phase-box">
        <span class="stat-label">Phase</span>
        <span class="stat-val sa-phase-val">init</span>
      </div>
      <div class="stat-box sa-rule-box" data-teach-target="rule-box">
        <span class="stat-label">Rule</span>
        <span class="stat-val">split to size 1, then merge sorted halves</span>
      </div>
      <div class="stat-box sa-result-box" data-teach-target="result-box">
        <span class="stat-label">Status</span>
        <span class="stat-val sa-status-val">In Progress</span>
      </div>
    </div>

    <div class="anim-row sa-layout">
      <div class="sa-main-wrap" data-teach-target="main-box">
        <p class="anim-label">Current Array State</p>
        <div class="array-row sa-main-array">
          {nums.map((num, i) => (
            <div class="array-col">
              <div class="array-cell sa-cell" data-idx={i} data-teach-target={`main-${i}`}>
                <span class="cell-val">{num}</span>
                <span class="cell-idx">{i}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="sa-focus-wrap">
        <p class="anim-label sa-action-label">Focus Segment</p>
        <div class="array-row sa-focus-array" data-teach-target="focus-box"></div>
      </div>
    </div>
  </AlgorithmPlayer>
</sort-array-visuals>

<script>
  class SortArrayVisuals extends HTMLElement {
    connectedCallback() {
      this.mainCells = Array.from(this.querySelectorAll('.sa-cell'));
      this.focusArray = this.querySelector('.sa-focus-array');
      this.actionLabel = this.querySelector('.sa-action-label');
      this.phaseVal = this.querySelector('.sa-phase-val');
      this.statusVal = this.querySelector('.sa-status-val');
      this.phaseBox = this.querySelector('.sa-phase-box');
      this.resultBox = this.querySelector('.sa-result-box');

      this.addEventListener('step-change', (e) => {
        const s = e.detail.step;

        if (this.phaseVal) this.phaseVal.textContent = s.phase;
        if (this.statusVal) {
          this.statusVal.textContent = s.phase === 'done' ? 'Complete' : 'In Progress';
        }

        this.phaseBox?.classList.remove('split', 'merge', 'done');
        if (s.phase === 'split') this.phaseBox?.classList.add('split');
        if (s.phase === 'merge') this.phaseBox?.classList.add('merge');
        if (s.phase === 'done') this.phaseBox?.classList.add('done');

        this.resultBox?.classList.remove('confirmed');
        if (s.phase === 'done') this.resultBox?.classList.add('confirmed');

        this.mainCells.forEach((cell, i) => {
          const valSpan = cell.querySelector('.cell-val');
          if (!valSpan) return;

          valSpan.textContent = String(s.arrFull[i]);
          valSpan.className = 'cell-val';

          if (s.phase === 'done') {
            valSpan.classList.add('success-val');
          } else if (s.l !== -1 && i >= s.l && i <= s.r) {
            if (s.phase === 'split') valSpan.classList.add('active-split');
            if (s.phase === 'merge') valSpan.classList.add('active-merge');
          } else {
            valSpan.classList.add('visited');
          }
        });

        if (!this.focusArray || !this.actionLabel) return;

        if (s.phase === 'init' || s.phase === 'done' || !s.segment || s.segment.length === 0) {
          this.focusArray.innerHTML = "<span class='sa-empty'>None</span>";
          this.actionLabel.textContent = s.phase === 'done' ? 'Done!' : 'Starting...';
          this.actionLabel.classList.remove('split', 'merge');
          if (s.phase === 'done') this.actionLabel.classList.add('done');
          else this.actionLabel.classList.remove('done');
          this.focusArray.classList.remove('split', 'merge');
        } else {
          this.actionLabel.textContent = s.phase === 'split' ? 'Splitting' : 'Merging';
          this.actionLabel.classList.remove('done');
          this.actionLabel.classList.toggle('split', s.phase === 'split');
          this.actionLabel.classList.toggle('merge', s.phase === 'merge');

          this.focusArray.classList.toggle('split', s.phase === 'split');
          this.focusArray.classList.toggle('merge', s.phase === 'merge');

          this.focusArray.innerHTML = s.segment
            .map((num) => {
              return `
                <div class="array-cell">
                  <span class="cell-val ${s.phase === 'split' ? 'focus-split' : 'focus-merge'}">${num}</span>
                </div>
              `;
            })
            .join('');
        }
      });
    }
  }

  if (!customElements.get('sort-array-visuals')) {
    customElements.define('sort-array-visuals', SortArrayVisuals);
  }
</script>

<style>
  sort-array-visuals {
    display: block;
  }

  .sa-meta-row {
    margin-bottom: 1rem;
  }

  .sa-rule-box .stat-val {
    color: var(--muted);
    font-size: var(--fs-eyebrow);
  }

  .sa-phase-box.split {
    border-color: color-mix(in srgb, var(--status-hard) 55%, transparent);
  }

  .sa-phase-box.merge {
    border-color: color-mix(in srgb, var(--status-info) 55%, transparent);
  }

  .sa-phase-box.done {
    border-color: color-mix(in srgb, var(--status-easy) 60%, transparent);
    background: color-mix(in srgb, var(--status-easy) 12%, transparent);
  }

  .sa-result-box.confirmed {
    border-color: color-mix(in srgb, var(--status-easy) 60%, transparent);
    background: color-mix(in srgb, var(--status-easy) 12%, transparent);
  }

  .sa-layout {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .sa-main-wrap,
  .sa-focus-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sa-focus-wrap {
    min-height: 100px;
  }

  .sa-action-label {
    color: var(--accent);
    transition: color 0.3s;
  }

  .sa-action-label.split {
    color: var(--status-hard);
  }

  .sa-action-label.merge {
    color: var(--status-info);
  }

  .sa-action-label.done {
    color: var(--status-easy);
  }

  .sa-focus-array {
    padding: 1rem;
    background: var(--surface-strong);
    border: 1px dashed var(--border);
    border-radius: 4px;
    min-width: 150px;
    justify-content: center;
    min-height: 4rem;
  }

  .sa-focus-array.split {
    border-color: var(--status-hard);
  }

  .sa-focus-array.merge {
    border-color: var(--status-info);
  }

  .sa-empty {
    color: var(--muted);
    opacity: 0.5;
    font-style: italic;
  }

  .focus-split {
    border-color: var(--status-hard);
    color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 15%, transparent);
    animation: pop-in 0.2s;
  }

  .focus-merge {
    border-color: var(--status-info);
    color: var(--status-info);
    background: color-mix(in srgb, var(--status-info) 15%, transparent);
    animation: pop-in 0.2s;
  }

  .cell-val.visited {
    opacity: var(--dim-hard);
  }

  .cell-val.active-split {
    border-color: var(--status-hard);
    color: var(--status-hard);
    background: color-mix(in srgb, var(--status-hard) 10%, transparent);
    transform: translateY(-4px);
  }

  .cell-val.active-merge {
    border-color: var(--status-info);
    color: var(--status-info);
    background: color-mix(in srgb, var(--status-info) 10%, transparent);
    transform: translateY(4px);
  }

  .cell-val.success-val {
    border-color: var(--status-easy) !important;
    color: var(--status-easy) !important;
    background: color-mix(in srgb, var(--status-easy) 15%, transparent) !important;
  }

  @keyframes pop-in {
    from {
      transform: scale(0.94);
      opacity: var(--dim-soft);
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
