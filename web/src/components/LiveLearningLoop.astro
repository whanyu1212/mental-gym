---
import { withBase } from "../lib/url";

// `delay` is when the comet reaches the node on its 9s orbit (the node's
// arc-length position along the loop path), so the halo and the caption light
// up as the comet arrives. Practice is followed by the longest stretch of
// path, so its caption stays up longer.
const steps = [
	{ id: "learn", label: "Learn", detail: "Build the model", summary: "Patterns, invariants, and complexity in the notes.", href: "/notes", x: 320, y: 62, delay: "0s" },
	{ id: "implement", label: "Implement", detail: "Make it concrete", summary: "ML models and algorithms written from first principles.", href: "/machine-learning", x: 505, y: 158, delay: "1.74s" },
	{ id: "practice", label: "Practice", detail: "Work unaided", summary: "DSA, ML coding, and system-design prompts.", href: "/problems", x: 455, y: 342, delay: "3.38s", long: true },
	{ id: "review", label: "Review", detail: "Retrieve later", summary: "Return to solved work on a spaced schedule.", href: "/#review", x: 185, y: 342, delay: "5.62s" },
	{ id: "retain", label: "Retain", detail: "Keep it durable", summary: "See what is sticking in your local progress.", href: "/progress", x: 135, y: 158, delay: "7.26s" },
];
---

<nav class="learning-loop" aria-label="Mental Gym learning loop">
	<svg viewBox="0 0 640 420" aria-labelledby="loop-title loop-description">
		<title id="loop-title">The Mental Gym learning loop</title>
		<desc id="loop-description">
			Learn, implement, practice, review, and retain. Each stage links to the relevant area of Mental Gym.
		</desc>

		<defs>
			<filter id="comet-glow" x="-300%" y="-300%" width="700%" height="700%">
				<feGaussianBlur stdDeviation="5" result="blur" />
				<feMerge>
					<feMergeNode in="blur" />
					<feMergeNode in="SourceGraphic" />
				</feMerge>
			</filter>
		</defs>

		<path
			class="loop-track"
			d="M 320 62 C 405 62 475 96 505 158 C 535 220 515 300 455 342 C 390 388 250 388 185 342 C 125 300 105 220 135 158 C 165 96 235 62 320 62 Z"
		/>
		<path
			class="loop-flow"
			d="M 320 62 C 405 62 475 96 505 158 C 535 220 515 300 455 342 C 390 388 250 388 185 342 C 125 300 105 220 135 158 C 165 96 235 62 320 62 Z"
		/>

		<circle class="comet" r="4" cx="0" cy="0" filter="url(#comet-glow)" />

		<g class="loop-core" aria-hidden="true">
			<circle cx="320" cy="220" r="79" />
			<circle class="core-ring" cx="320" cy="220" r="63" />
			<text class="core-kicker" x="320" y="211">Build</text>
			<text class="core-title" x="320" y="238">Durable fluency</text>
		</g>

		{steps.map((step, index) => (
			<a
				class="loop-node"
				href={withBase(step.href)}
				aria-label={`${step.label}: ${step.detail}. ${step.summary}`}
				data-stage={step.id}
				style={`--node-delay: ${step.delay}`}
			>
				<circle class="node-halo" cx={step.x} cy={step.y} r="45" />
				<circle class="node-surface" cx={step.x} cy={step.y} r="38" />
				<text class="node-index" x={step.x} y={step.y - 8}>
					{String(index + 1).padStart(2, "0")}
				</text>
				<text class="node-label" x={step.x} y={step.y + 13}>{step.label}</text>
			</a>
		))}
	</svg>
	<div class="stage-captions" aria-hidden="true">
		{steps.map((step, index) => (
			<p
				class:list={["stage-caption", { long: step.long }]}
				data-stage={step.id}
				style={`--node-delay: ${step.delay}`}
			>
				<span class="caption-index">{String(index + 1).padStart(2, "0")}</span>
				<strong>{step.label}</strong> · {step.detail}.
				<span class="caption-summary">{step.summary}</span>
			</p>
		))}
	</div>
	<p class="loop-caption">Select a stage to open it.</p>
</nav>

<style>
	.learning-loop {
		position: relative;
		width: 100%;
		min-width: 0;
	}

	svg {
		display: block;
		height: auto;
		overflow: visible;
		width: 100%;
	}

	.loop-track,
	.loop-flow {
		fill: none;
		stroke-linecap: round;
	}

	.loop-track {
		stroke: var(--glass-border-strong);
		stroke-width: 2;
	}

	.loop-flow {
		animation: flow 9s linear infinite;
		stroke: var(--accent);
		stroke-dasharray: 2 15;
		stroke-width: 1.5;
		opacity: 0.45;
	}

	.comet {
		animation: orbit 9s linear infinite;
		fill: var(--accent);
		offset-path: path("M 320 62 C 405 62 475 96 505 158 C 535 220 515 300 455 342 C 390 388 250 388 185 342 C 125 300 105 220 135 158 C 165 96 235 62 320 62 Z");
		transform-box: fill-box;
		transform-origin: center;
	}

	.loop-core circle {
		fill: var(--glass-surface);
		stroke: var(--glass-border);
		stroke-width: 1;
	}

	.loop-core .core-ring {
		fill: none;
		stroke: var(--accent-ring);
		stroke-dasharray: 1 7;
		stroke-linecap: round;
	}

	.loop-core text,
	.loop-node text {
		pointer-events: none;
		text-anchor: middle;
	}

	.core-kicker,
	.node-index {
		fill: var(--accent);
		font: 600 var(--fs-micro) var(--font-sans);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.core-title {
		fill: var(--text);
		font: 600 var(--fs-xl) var(--font-serif);
	}

	.loop-node {
		outline: none;
	}

	.node-halo {
		animation: breathe 9s var(--ease-out) infinite;
		animation-delay: var(--node-delay);
		fill: var(--accent-glow);
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
	}

	.node-surface {
		fill: color-mix(in srgb, var(--glass-surface-strong) 94%, transparent);
		stroke: var(--glass-border-strong);
		stroke-width: 1.5;
		transition: fill var(--dur-mid), stroke var(--dur-mid), transform var(--dur-mid);
		transform-box: fill-box;
		transform-origin: center;
	}

	.node-label {
		fill: var(--text);
		font: 600 var(--fs-sm) var(--font-sans);
		letter-spacing: 0.02em;
		text-transform: capitalize;
	}

	.loop-node:hover .node-surface,
	.loop-node:focus-visible .node-surface {
		fill: var(--accent-soft);
		stroke: var(--accent);
		transform: scale(1.08);
	}

	.loop-node:hover .node-halo,
	.loop-node:focus-visible .node-halo {
		animation: none;
		opacity: 1;
		transform: scale(1.12);
	}

	.loop-node:focus-visible .node-surface {
		stroke-width: 3;
	}

	/* Captions share one grid cell, so the block is as tall as the longest one. */
	.stage-captions {
		display: grid;
		margin: -0.25rem auto 0;
		max-width: 30rem;
		text-align: center;
	}

	.stage-caption {
		animation: caption 9s linear infinite;
		animation-delay: var(--node-delay);
		color: var(--muted);
		font: var(--fs-sm) / 1.5 var(--font-sans);
		grid-area: 1 / 1;
		margin: 0;
		opacity: 0;
	}

	.stage-caption.long {
		animation-name: caption-long;
	}

	.stage-caption strong {
		color: var(--text);
		font-weight: 600;
	}

	.caption-index {
		color: var(--accent);
		font: 600 var(--fs-micro) var(--font-sans);
		letter-spacing: 0.14em;
		margin-right: 0.35rem;
	}

	.caption-summary {
		display: block;
	}

	/* Hovering or focusing a stage pins its caption and hides the cycle. */
	.learning-loop:has(.loop-node:hover, .loop-node:focus-visible) .stage-caption {
		animation: none;
		opacity: 0;
	}

	.learning-loop:has([data-stage="learn"]:is(:hover, :focus-visible)) .stage-caption[data-stage="learn"],
	.learning-loop:has([data-stage="implement"]:is(:hover, :focus-visible)) .stage-caption[data-stage="implement"],
	.learning-loop:has([data-stage="practice"]:is(:hover, :focus-visible)) .stage-caption[data-stage="practice"],
	.learning-loop:has([data-stage="review"]:is(:hover, :focus-visible)) .stage-caption[data-stage="review"],
	.learning-loop:has([data-stage="retain"]:is(:hover, :focus-visible)) .stage-caption[data-stage="retain"] {
		opacity: 1;
	}

	.loop-caption {
		color: var(--muted);
		font: var(--fs-fine) var(--font-sans);
		letter-spacing: 0.03em;
		margin: 0.4rem 0 0;
		opacity: 0.8;
		text-align: center;
	}

	@keyframes flow {
		to {
			stroke-dashoffset: -68;
		}
	}

	@keyframes orbit {
		from {
			offset-distance: 0%;
		}
		to {
			offset-distance: 100%;
		}
	}

	/* 9s cycles, offset per node by --node-delay. The shortest stretch between
	   nodes is 18.2% of the loop, so each window closes before the next opens. */
	@keyframes breathe {
		0%,
		18%,
		100% {
			opacity: 0;
			transform: scale(0.82);
		}
		3%,
		12% {
			opacity: 0.8;
			transform: scale(1.12);
		}
	}

	@keyframes caption {
		0%,
		18.2%,
		100% {
			opacity: 0;
		}
		1.5%,
		16.5% {
			opacity: 1;
		}
	}

	@keyframes caption-long {
		0%,
		24.9%,
		100% {
			opacity: 0;
		}
		1.5%,
		23.2% {
			opacity: 1;
		}
	}

	@media (max-width: 700px) {
		.learning-loop {
			margin-inline: auto;
			max-width: 560px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.loop-flow,
		.comet,
		.node-halo,
		.stage-caption {
			animation: none;
		}

		.loop-flow {
			stroke-dasharray: 2 15;
		}

		.comet {
			display: none;
		}
	}
</style>
