---
import { withBase } from "../lib/url";

// One stage is lit at a time for STEP seconds, top to bottom, then the marker
// sweeps back to Learn and the cycle repeats.
const STEP = 2.5;

const stages = [
	{ id: "learn", label: "Learn", summary: "Patterns, invariants, and complexity, in the notes.", href: "/notes" },
	{ id: "implement", label: "Implement", summary: "Models and algorithms, written from first principles.", href: "/machine-learning" },
	{ id: "practice", label: "Practice", summary: "DSA, ML coding, and system design, worked unaided.", href: "/problems" },
	{ id: "review", label: "Review", summary: "Solved work comes back on a spaced schedule.", href: "/#review" },
	{ id: "retain", label: "Retain", summary: "Your progress shows what is sticking.", href: "/progress" },
];
---

<nav class="learning-loop" aria-label="Mental Gym learning loop" style={`--cycle: ${STEP * stages.length}s`}>
	<div class="stack">
		<span class="marker" aria-hidden="true"></span>
		<ol class="stages">
			{stages.map((stage, index) => (
				<li class="stage" data-stage={stage.id} style={`--at: ${index * STEP}s`}>
					<a class="stage-word" href={withBase(stage.href)} aria-label={`${stage.label}: ${stage.summary}`}>
						{stage.label}
					</a>
					<p class:list={["stage-caption"]} aria-hidden="true">{stage.summary}</p>
				</li>
			))}
		</ol>
	</div>
	<p class="loop-hint">The cycle repeats. Select a stage to open it.</p>
</nav>

<style>
	.learning-loop {
		/* 50% keeps the resting words above 3:1 contrast for large text in both themes. */
		--dim: color-mix(in srgb, var(--text) 50%, var(--bg));

		container-type: inline-size;
		min-width: 0;
		padding-left: clamp(0rem, 3vw, 2.5rem);
		width: 100%;
	}

	/* Sized by the component's own width (see the container queries below). */
	.stack {
		--word-size: 3rem;
		--row: calc(var(--word-size) * 1.16);

		padding-left: 1.4rem;
		position: relative;
	}

	/* The rule the marker rides on. */
	.stack::before {
		background: var(--border);
		bottom: 0;
		content: "";
		left: 0;
		position: absolute;
		top: 0;
		width: 1px;
	}

	.marker {
		background: var(--accent);
		border-radius: 2px;
		height: var(--row);
		left: -1px;
		position: absolute;
		top: 0;
		width: 3px;
	}

	.stages {
		display: grid;
		grid-auto-rows: var(--row);
		grid-template-columns: max-content minmax(0, 1fr);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.stage {
		align-items: center;
		column-gap: 1.6rem;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
	}

	.stage-word {
		color: var(--dim);
		font: 600 var(--word-size) / 1 var(--font-serif);
		letter-spacing: -0.01em;
		text-decoration: none;
		transition: color var(--dur-mid);
	}

	.stage-word:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.stage-word:focus-visible {
		border-radius: var(--radius-xs);
		color: var(--accent);
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.stage-caption {
		color: var(--muted);
		font: var(--fs-sm) / 1.45 var(--font-sans);
		margin: 0;
		max-width: 17rem;
		opacity: 0;
		pointer-events: none;
	}

	.loop-hint {
		color: var(--muted);
		font: var(--fs-fine) var(--font-sans);
		margin: 1rem 0 0 1.4rem;
		opacity: 0.8;
	}

	/* One stage at a time: the word lights, its sentence appears beside it, the marker follows. */
	@media (prefers-reduced-motion: no-preference) {
		.marker {
			animation: marker var(--cycle) cubic-bezier(0.65, 0, 0.35, 1) infinite;
		}

		.stage-word {
			animation: word var(--cycle) linear var(--at) infinite;
		}

		.stage-caption {
			animation: caption var(--cycle) linear var(--at) infinite;
		}

		/* Hovering or focusing a stage stops the cycle on that stage. */
		.learning-loop:has(.stage-word:hover, .stage-word:focus-visible) :is(.marker, .stage-word, .stage-caption) {
			animation: none;
		}

		.learning-loop:has(.stage-word:hover, .stage-word:focus-visible) .stage-caption {
			opacity: 0;
		}

		.stage:has(.stage-word:hover, .stage-word:focus-visible) .stage-caption {
			opacity: 1;
		}

		.learning-loop:has([data-stage="implement"] .stage-word:is(:hover, :focus-visible)) .marker {
			transform: translateY(100%);
		}

		.learning-loop:has([data-stage="practice"] .stage-word:is(:hover, :focus-visible)) .marker {
			transform: translateY(200%);
		}

		.learning-loop:has([data-stage="review"] .stage-word:is(:hover, :focus-visible)) .marker {
			transform: translateY(300%);
		}

		.learning-loop:has([data-stage="retain"] .stage-word:is(:hover, :focus-visible)) .marker {
			transform: translateY(400%);
		}
	}

	@keyframes marker {
		0%,
		17% {
			transform: translateY(0);
		}
		20%,
		37% {
			transform: translateY(100%);
		}
		40%,
		57% {
			transform: translateY(200%);
		}
		60%,
		77% {
			transform: translateY(300%);
		}
		80%,
		97% {
			transform: translateY(400%);
		}
		100% {
			transform: translateY(0);
		}
	}

	@keyframes word {
		0% {
			color: var(--dim);
		}
		2%,
		18% {
			color: var(--text);
		}
		21%,
		100% {
			color: var(--dim);
		}
	}

	@keyframes caption {
		0% {
			opacity: 0;
			transform: translateX(-6px);
		}
		2.5%,
		18% {
			opacity: 1;
			transform: none;
		}
		20.5%,
		100% {
			opacity: 0;
		}
	}

	@container (max-width: 460px) {
		.stack {
			--word-size: 2.6rem;
		}

		.stage {
			column-gap: 1.1rem;
		}

		.stage-caption {
			font-size: var(--fs-fine);
		}
	}

	@container (max-width: 360px) {
		.stack {
			--word-size: 2.2rem;
		}
	}

	@media (max-width: 700px) {
		.learning-loop {
			margin-inline: auto;
			max-width: 560px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		/* Without the cycle, every stage and its sentence show as a still list. */
		.marker {
			display: none;
		}

		/* No marker to line up with, so rows can grow to fit wrapped sentences. */
		.stages {
			grid-auto-rows: auto;
			row-gap: 0.55rem;
		}

		.stage-word {
			color: var(--text);
		}

		.stage-caption {
			animation: none;
			opacity: 1;
		}
	}
</style>
