---
import DecisionBar from './DecisionBar.astro';
import InvariantBar from './InvariantBar.astro';
import TeachingFormula from './TeachingFormula.astro';
import type { TeachingStep } from '../../lib/teaching/types';

interface Props {
  title: string;
  steps: TeachingStep[];
}

const { title, steps } = Astro.props;
const stepsJson = JSON.stringify(steps);
---

<algo-player data-steps={stepsJson} class="animation" tabindex="0">
  <div class="anim-header">
    <span class="anim-title">{title}</span>
    <div class="anim-controls">
      <button class="anim-btn player-prev" disabled>Prev</button>
      <span class="anim-step player-step">Step 1 / {steps.length}</span>
      <button class="anim-btn player-next">Next</button>
    </div>
  </div>

  <div class="teaching-content">
    <div class="anim-row">
      <p class="anim-label">Step</p>
      <p class="anim-explanation player-explanation"></p>
    </div>

    <InvariantBar />
    <DecisionBar />
    <TeachingFormula />
  </div>

  <div class="anim-visuals">
    <slot />
  </div>
</algo-player>

<script>
  import { applyTeachingHighlights, clearTeachingHighlights } from "../../lib/teaching/highlight";

  class AlgoPlayer extends HTMLElement {
    connectedCallback() {
      const stepsData = this.dataset.steps;
      if (!stepsData) return;

      this.steps = JSON.parse(stepsData);
      this.current = 0;

      this.prevBtn = this.querySelector(".player-prev");
      this.nextBtn = this.querySelector(".player-next");
      this.stepEl = this.querySelector(".player-step");
      this.explanationEl = this.querySelector(".player-explanation");
      this.invariantPanel = this.querySelector("[data-invariant-panel]");
      this.invariantList = this.querySelector("[data-invariant-list]");
      this.decisionPanel = this.querySelector("[data-decision-panel]");
      this.decisionTitle = this.querySelector("[data-decision-title]");
      this.decisionBody = this.querySelector("[data-decision-body]");
      this.formulaPanel = this.querySelector("[data-formula-panel]");
      this.formulaText = this.querySelector("[data-formula-text]");

      if (this.prevBtn) {
        this.prevBtn.addEventListener("click", () => {
          if (this.current > 0) {
            this.current--;
            this.update();
          }
        });
      }

      if (this.nextBtn) {
        this.nextBtn.addEventListener("click", () => {
          if (this.current < this.steps.length - 1) {
            this.current++;
            this.update();
          }
        });
      }

      this.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft" && this.prevBtn && !this.prevBtn.disabled) {
          this.prevBtn.click();
        }

        if (e.key === "ArrowRight" && this.nextBtn && !this.nextBtn.disabled) {
          this.nextBtn.click();
        }
      });

      setTimeout(() => this.update(), 0);
    }

    setPanelVisibility(panel, isVisible) {
      if (!panel) return;
      panel.classList.toggle("is-hidden", !isVisible);
    }

    getInvariantLines(step) {
      if (!step?.invariant) return [];
      return Array.isArray(step.invariant) ? step.invariant : [step.invariant];
    }

    getDecision(step) {
      const title =
        step?.callout?.title ??
        (step?.action
          ? `${step.action.charAt(0).toUpperCase()}${step.action.slice(1)}`
          : "Decision");
      const body = step?.reason ?? step?.callout?.body ?? "";
      const tone = step?.callout?.tone ?? "info";
      return { title, body, tone };
    }

    getFormulaText(step) {
      if (!step?.formula) return "";

      if (typeof step.formula === "string") {
        return step.formula;
      }

      if (step.formula.latex) {
        return step.formula.latex;
      }

      if (Array.isArray(step.formula.tokens) && step.formula.tokens.length > 0) {
        return step.formula.tokens.map((token) => token.text).join(" ");
      }

      return "";
    }

    renderInvariant(step) {
      const invariantLines = this.getInvariantLines(step);

      if (!this.invariantList || !this.invariantPanel) return;

      if (invariantLines.length === 0) {
        this.invariantList.innerHTML = "";
        this.setPanelVisibility(this.invariantPanel, false);
        return;
      }

      this.invariantList.innerHTML = invariantLines
        .map((line) => `<li>${line}</li>`)
        .join("");
      this.setPanelVisibility(this.invariantPanel, true);
    }

    renderDecision(step) {
      if (!this.decisionPanel || !this.decisionTitle || !this.decisionBody) return;

      const { title, body, tone } = this.getDecision(step);

      if (!body) {
        this.decisionTitle.textContent = "";
        this.decisionBody.textContent = "";
        this.decisionPanel.removeAttribute("data-tone");
        this.setPanelVisibility(this.decisionPanel, false);
        return;
      }

      this.decisionTitle.textContent = title;
      this.decisionBody.textContent = body;
      this.decisionPanel.setAttribute("data-tone", tone);
      this.setPanelVisibility(this.decisionPanel, true);
    }

    renderFormula(step) {
      if (!this.formulaPanel || !this.formulaText) return;

      const formulaText = this.getFormulaText(step);

      if (!formulaText) {
        this.formulaText.textContent = "";
        this.setPanelVisibility(this.formulaPanel, false);
        return;
      }

      this.formulaText.textContent = formulaText;
      this.setPanelVisibility(this.formulaPanel, true);
    }

    update() {
      if (!this.steps || this.steps.length === 0) return;
      const step = this.steps[this.current];

      if (this.stepEl) {
        this.stepEl.textContent = `Step ${this.current + 1} / ${this.steps.length}`;
      }

      if (this.prevBtn) this.prevBtn.disabled = this.current === 0;
      if (this.nextBtn) this.nextBtn.disabled = this.current === this.steps.length - 1;

      if (this.explanationEl) {
        this.explanationEl.textContent = step.explanation || step.exp || "";
      }

      this.renderInvariant(step);
      this.renderDecision(step);
      this.renderFormula(step);

      if (Array.isArray(step.highlights) && step.highlights.length > 0) {
        applyTeachingHighlights(this, step.highlights);
      } else {
        clearTeachingHighlights(this);
      }

      this.dispatchEvent(
        new CustomEvent("step-change", {
          detail: { step, index: this.current },
          bubbles: true,
        }),
      );
    }
  }

  if (!customElements.get("algo-player")) {
    customElements.define("algo-player", AlgoPlayer);
  }
</script>

<style is:global>
  /* Common player styles */
  algo-player {
    display: block;
    outline: none;
    max-width: 100%;
    box-sizing: border-box;
  }
  algo-player:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }
  algo-player .animation {
    background: var(--glass-surface);
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    backdrop-filter: blur(var(--glass-blur)) saturate(135%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(135%);
    box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-lg);
  }
  algo-player .anim-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  algo-player .anim-title {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--muted);
  }
  algo-player .anim-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  algo-player .anim-btn {
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.4rem 1.1rem;
    font-size: 0.82rem;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  algo-player .player-next {
    background: var(--accent);
    color: var(--bg);
  }
  algo-player .anim-btn:hover:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-1px);
    box-shadow: 0 3px 10px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  algo-player .anim-btn:active:not(:disabled) {
    transform: scale(0.96);
  }
  algo-player .anim-btn:disabled {
    opacity: 0.25;
    cursor: default;
  }
  algo-player .anim-step {
    font-size: 0.72rem;
    color: var(--muted);
    font-family: var(--font-sans);
    min-width: 5rem;
    text-align: center;
  }
  algo-player .teaching-content {
    margin-bottom: 1.5rem;
  }
  algo-player .anim-visuals {
    margin-bottom: 1.25rem;
  }
  algo-player .anim-row {
    margin-bottom: 1.25rem;
  }
  algo-player .anim-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-family: var(--font-sans);
    font-weight: 600;
    margin: 0 0 0.6rem;
  }
  algo-player .anim-explanation {
    margin: 0;
    font-size: 0.88rem;
    font-family: var(--font-sans);
    color: var(--text);
    line-height: 1.65;
    min-height: 4.5rem;
  }

  /* Teaching panels */
  algo-player .teaching-panel.is-hidden {
    display: none;
  }
  algo-player .teaching-panel-body {
    background: color-mix(in srgb, var(--surface-strong) 85%, transparent);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }
  algo-player .invariant-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text);
    font-size: 0.84rem;
    font-family: var(--font-sans);
    line-height: 1.6;
  }
  algo-player .invariant-list li + li {
    margin-top: 0.3rem;
  }
  algo-player .decision-panel-body[data-tone="success"],
  algo-player [data-decision-panel][data-tone="success"] .decision-panel-body {
    border-color: color-mix(in srgb, var(--status-easy) 35%, var(--glass-border));
  }
  algo-player [data-decision-panel][data-tone="warning"] .decision-panel-body {
    border-color: color-mix(in srgb, var(--status-medium) 35%, var(--glass-border));
  }
  algo-player [data-decision-panel][data-tone="danger"] .decision-panel-body {
    border-color: color-mix(in srgb, var(--status-hard) 35%, var(--glass-border));
  }
  algo-player .decision-title {
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text);
    font-family: var(--font-sans);
  }
  algo-player .decision-body {
    margin: 0;
    color: var(--text);
    font-size: 0.84rem;
    font-family: var(--font-sans);
    line-height: 1.6;
  }
  algo-player .formula-panel-body {
    overflow-x: auto;
  }
  algo-player .formula-text {
    margin: 0;
    white-space: pre-wrap;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  /* Shared teaching highlights */
  algo-player [data-teach-target] {
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  algo-player .teach-focus {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
    transform: translateY(-1px);
  }
  algo-player .teach-compare {
    border-color: var(--status-info) !important;
    background: color-mix(in srgb, var(--status-info) 15%, transparent) !important;
    color: var(--status-info) !important;
  }
  algo-player .teach-write {
    border-color: var(--accent) !important;
    background: color-mix(in srgb, var(--status-medium) 20%, transparent) !important;
    color: var(--accent) !important;
    box-shadow: var(--shadow-sm);
  }
  algo-player .teach-discard {
    opacity: var(--dim-soft);
  }
  algo-player .teach-match,
  algo-player .teach-confirmed {
    border-color: var(--status-easy) !important;
    background: color-mix(in srgb, var(--status-easy) 15%, transparent) !important;
    color: var(--status-easy) !important;
  }
  algo-player .teach-region-add {
    border-color: var(--status-info) !important;
    background: color-mix(in srgb, var(--status-info) 15%, transparent) !important;
    color: var(--status-info) !important;
  }
  algo-player .teach-region-subtract {
    border-color: var(--status-hard) !important;
    background: color-mix(in srgb, var(--status-hard) 15%, transparent) !important;
    color: var(--status-hard) !important;
  }

  /* Shared Data Structure Visuals (Available to all renderers) */

  /* Arrays */
  algo-player .array-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  algo-player .array-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 3rem; /* 48px */
  }
  algo-player .array-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.15s;
  }
  algo-player .cell-val {
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text);
    background: var(--surface-base);
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  algo-player .cell-idx {
    font-size: 0.65rem;
    color: var(--muted);
    opacity: 0.5;
    font-family: var(--font-sans);
  }

  /* Pointers */
  algo-player .pointers-row {
    display: flex;
    gap: 0.2rem;
    height: 1.2rem;
    justify-content: center;
  }
  algo-player .ptr {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: bold;
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-xs);
    transition: opacity 0.2s;
  }
  algo-player .ptr.hidden {
    opacity: 0;
  }

  /* Hash Maps / Sets */
  algo-player .hashmap-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 2rem;
    align-items: center;
  }
  algo-player .hashmap-empty {
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.4;
    font-family: var(--font-mono);
    font-style: italic;
  }
  algo-player .hashmap-entry {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--text);
    background: var(--surface-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    padding: 0.25rem 0.6rem;
    animation: pop-in 0.2s ease;
  }
  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Stats / Info Boxes */
  algo-player .stats-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  algo-player .stat-box {
    background: var(--surface-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    padding: 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 6rem;
    transition: border-color 0.2s;
  }
  algo-player .stat-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-family: var(--font-sans);
    margin-bottom: 0.2rem;
  }
  algo-player .stat-val {
    font-size: 1.25rem;
    font-family: var(--font-mono);
    color: var(--text);
    font-weight: bold;
  }
</style>
