---
interface Props {
  title: string;
  steps: any[];
}
const { title, steps } = Astro.props;
const stepsJson = JSON.stringify(steps);
---

<algo-player data-steps={stepsJson} class="animation" tabindex="0">
  <div class="anim-header">
    <span class="anim-title">{title}</span>
    <div class="anim-controls">
      <button class="anim-btn player-prev" disabled>Prev</button>
      <span class="anim-step player-step">Step 1 / {steps.length}</span>
      <button class="anim-btn player-next">Next</button>
    </div>
  </div>

  <div class="anim-visuals">
    <slot />
  </div>

  <div class="anim-row">
    <p class="anim-label">Step</p>
    <p class="anim-explanation player-explanation"></p>
  </div>
</algo-player>

<script>
  class AlgoPlayer extends HTMLElement {
    connectedCallback() {
      const stepsData = this.dataset.steps;
      if (!stepsData) return;

      this.steps = JSON.parse(stepsData);
      this.current = 0;

      this.prevBtn = this.querySelector(".player-prev");
      this.nextBtn = this.querySelector(".player-next");
      this.stepEl = this.querySelector(".player-step");
      this.explanationEl = this.querySelector(".player-explanation");

      if (this.prevBtn) {
        this.prevBtn.addEventListener("click", () => {
          if (this.current > 0) { this.current--; this.update(); }
        });
      }

      if (this.nextBtn) {
        this.nextBtn.addEventListener("click", () => {
          if (this.current < this.steps.length - 1) { this.current++; this.update(); }
        });
      }

      this.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' && this.prevBtn && !this.prevBtn.disabled) this.prevBtn.click();
        if (e.key === 'ArrowRight' && this.nextBtn && !this.nextBtn.disabled) this.nextBtn.click();
      });

      // Fire the initial render tick
      setTimeout(() => this.update(), 0);
    }

    update() {
      if (!this.steps || this.steps.length === 0) return;
      const s = this.steps[this.current];

      if (this.stepEl) {
        this.stepEl.textContent = `Step ${this.current + 1} / ${this.steps.length}`;
      }

      if (this.prevBtn) this.prevBtn.disabled = this.current === 0;
      if (this.nextBtn) this.nextBtn.disabled = this.current === this.steps.length - 1;

      if (this.explanationEl) {
        this.explanationEl.textContent = s.explanation || s.exp || "";
      }

      this.dispatchEvent(new CustomEvent('step-change', {
        detail: { step: s, index: this.current },
        bubbles: true
      }));
    }
  }

  if (!customElements.get('algo-player')) {
    customElements.define('algo-player', AlgoPlayer);
  }
</script>

<style is:global>
  /* Common player styles */
  algo-player {
    display: block;
    outline: none;
  }
  algo-player:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  algo-player .animation {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  algo-player .anim-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  algo-player .anim-title {
    font-size: 0.78rem;
    font-family: ui-monospace, monospace;
    color: var(--muted);
  }
  algo-player .anim-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  algo-player .anim-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 0.3rem 0.75rem;
    font-size: 0.78rem;
    font-family: Inter, sans-serif;
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  algo-player .anim-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  algo-player .anim-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  algo-player .anim-step {
    font-size: 0.72rem;
    color: var(--muted);
    font-family: Inter, sans-serif;
    min-width: 5rem;
    text-align: center;
  }
  algo-player .anim-visuals {
    margin-bottom: 1.25rem;
  }
  algo-player .anim-row {
    margin-bottom: 1.25rem;
  }
  algo-player .anim-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-family: Inter, sans-serif;
    font-weight: 600;
    margin: 0 0 0.6rem;
  }
  algo-player .anim-explanation {
    margin: 0;
    font-size: 0.88rem;
    font-family: Inter, sans-serif;
    color: var(--text);
    line-height: 1.65;
    min-height: 2.5rem;
  }

  /* Shared Data Structure Visuals (Available to all renderers) */

  /* Arrays */
  algo-player .array-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  algo-player .array-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 3rem; /* 48px */
  }
  algo-player .array-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.15s;
  }
  algo-player .cell-val {
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 2px;
    font-size: 1rem;
    font-family: ui-monospace, monospace;
    color: var(--text);
    background: #0e0e0e;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  algo-player .cell-idx {
    font-size: 0.65rem;
    color: var(--muted);
    opacity: 0.5;
    font-family: Inter, sans-serif;
  }

  /* Pointers */
  algo-player .pointers-row {
    display: flex;
    gap: 0.2rem;
    height: 1.2rem;
    justify-content: center;
  }
  algo-player .ptr {
    font-size: 0.65rem;
    font-family: ui-monospace, monospace;
    font-weight: bold;
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
    transition: opacity 0.2s;
  }
  algo-player .ptr.hidden {
    opacity: 0;
  }

  /* Hash Maps / Sets */
  algo-player .hashmap-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 2rem;
    align-items: center;
  }
  algo-player .hashmap-empty {
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.4;
    font-family: ui-monospace, monospace;
    font-style: italic;
  }
  algo-player .hashmap-entry {
    font-size: 0.82rem;
    font-family: ui-monospace, monospace;
    color: var(--text);
    background: #0e0e0e;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.25rem 0.6rem;
    animation: pop-in 0.2s ease;
  }
  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Stats / Info Boxes */
  algo-player .stats-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  algo-player .stat-box {
    background: #0e0e0e;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 6rem;
    transition: border-color 0.2s;
  }
  algo-player .stat-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-family: Inter, sans-serif;
    margin-bottom: 0.2rem;
  }
  algo-player .stat-val {
    font-size: 1.25rem;
    font-family: ui-monospace, monospace;
    color: var(--text);
    font-weight: bold;
  }
</style>
