---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';
import type { TeachingStep } from '../lib/teaching/types';

const nums = [1, 2, 3, 1];

const steps: TeachingStep[] = [
  {
    id: 'initialize-set',
    i: -1,
    val: null,
    set: [],
    found: false,
    phase: 'start',
    formula: 'seen = ∅',
    exp: 'Start with an empty hash set. As we scan the array, we store each number the first time we see it.',
    reason: 'A hash set gives constant-time membership checks, which is exactly what duplicate detection needs.',
    invariant: [
      'The set contains all values seen in earlier positions.',
      'If the current value is already in the set, a duplicate exists immediately.',
    ],
    action: 'compare',
    highlights: [
      { target: 'set-box', kind: 'focus' },
      { target: 'decision-box', kind: 'focus' },
      { target: 'formula-box', kind: 'derive' },
    ],
  },
  {
    id: 'check-1',
    i: 0,
    val: 1,
    set: [],
    found: false,
    phase: 'lookup',
    formula: 'Is 1 in seen? No',
    exp: 'Check nums[0] = 1. The set is empty, so 1 has not been seen before.',
    reason: 'The first occurrence of a value cannot be a duplicate.',
    invariant: 'We always test membership before inserting the current value.',
    action: 'compare',
    highlights: [
      { target: 'array-box', kind: 'focus' },
      { target: 'cell:0', kind: 'focus' },
      { target: 'set-box', kind: 'focus' },
      { target: 'formula-box', kind: 'derive' },
    ],
  },
  {
    id: 'store-1',
    i: 0,
    val: 1,
    set: [1],
    found: false,
    phase: 'store',
    formula: 'Insert 1 into seen',
    exp: 'Since 1 was not found in the set, insert it and continue scanning.',
    reason: 'Every new value becomes part of the history used to detect future duplicates.',
    invariant: 'After index i is processed, nums[i] is included in the seen set.',
    action: 'write',
    highlights: [
      { target: 'set-box', kind: 'write' },
      { target: 'entry:0', kind: 'write' },
      { target: 'cell:0', kind: 'write' },
      { target: 'decision-box', kind: 'focus' },
    ],
  },
  {
    id: 'check-2',
    i: 1,
    val: 2,
    set: [1],
    found: false,
    phase: 'lookup',
    formula: 'Is 2 in seen? No',
    exp: 'Check nums[1] = 2. The seen set currently contains only 1, so 2 is new.',
    reason: 'A membership miss means the current value has not appeared earlier.',
    invariant: 'The set summarizes all earlier values, not future ones.',
    action: 'compare',
    highlights: [
      { target: 'cell:1', kind: 'focus' },
      { target: 'set-box', kind: 'focus' },
      { target: 'formula-box', kind: 'derive' },
    ],
  },
  {
    id: 'store-2',
    i: 1,
    val: 2,
    set: [1, 2],
    found: false,
    phase: 'store',
    formula: 'Insert 2 into seen',
    exp: 'Insert 2 into the set. Now both 1 and 2 have been recorded as seen values.',
    reason: 'The set grows only when the current value is genuinely new.',
    invariant: 'Each unique value appears at most once inside the set.',
    action: 'write',
    highlights: [
      { target: 'set-box', kind: 'write' },
      { target: 'entry:1', kind: 'write' },
      { target: 'cell:1', kind: 'write' },
    ],
  },
  {
    id: 'check-3',
    i: 2,
    val: 3,
    set: [1, 2],
    found: false,
    phase: 'lookup',
    formula: 'Is 3 in seen? No',
    exp: 'Check nums[2] = 3. It is not in the set yet, so this is also a first occurrence.',
    reason: 'We still have no repeated value because every membership check so far has failed.',
    invariant: 'No duplicate has been found unless membership returns true.',
    action: 'compare',
    highlights: [
      { target: 'cell:2', kind: 'focus' },
      { target: 'set-box', kind: 'focus' },
      { target: 'formula-box', kind: 'derive' },
    ],
  },
  {
    id: 'store-3',
    i: 2,
    val: 3,
    set: [1, 2, 3],
    found: false,
    phase: 'store',
    formula: 'Insert 3 into seen',
    exp: 'Insert 3 into the set. The seen values are now {1, 2, 3}.',
    reason: 'Storing new values prepares the algorithm to catch later repeats instantly.',
    invariant: 'The set contains every distinct value from the processed prefix.',
    action: 'write',
    highlights: [
      { target: 'set-box', kind: 'write' },
      { target: 'entry:2', kind: 'write' },
      { target: 'cell:2', kind: 'write' },
    ],
  },
  {
    id: 'find-duplicate-1',
    i: 3,
    val: 1,
    set: [1, 2, 3],
    found: true,
    phase: 'found',
    formula: 'Is 1 in seen? Yes',
    exp: 'Check nums[3] = 1. This time 1 is already in the set, so we found a duplicate and return true.',
    reason: 'A membership hit proves the value appeared earlier in the array.',
    invariant: 'The first successful lookup is sufficient to conclude duplicates exist.',
    action: 'confirm',
    highlights: [
      { target: 'cell:3', kind: 'confirmed' },
      { target: 'set-box', kind: 'match' },
      { target: 'entry:0', kind: 'match' },
      { target: 'decision-box', kind: 'confirmed' },
      { target: 'answer-box', kind: 'confirmed' },
      { target: 'formula-box', kind: 'confirmed' },
    ],
  },
];
---

<contains-duplicate-visuals>
  <AlgorithmPlayer title="nums = [1, 2, 3, 1]" steps={steps}>
    <div class="stats-row cd-stats-row">
      <div class="stat-box" data-teach-target="formula-box">
        <span class="stat-label">Membership Check</span>
        <span class="stat-val cd-formula">-</span>
      </div>
      <div class="stat-box" data-teach-target="decision-box">
        <span class="stat-label">Decision</span>
        <span class="stat-val cd-decision">-</span>
      </div>
      <div class="stat-box" data-teach-target="answer-box">
        <span class="stat-label">Has Duplicate?</span>
        <span class="stat-val cd-answer">unknown</span>
      </div>
    </div>

    <div class="anim-row">
      <p class="anim-label">Array</p>
      <div class="array-row cd-array" data-teach-target="array-box">
        {nums.map((n, i) => (
          <div class="array-col">
            <div class="array-cell cd-cell" data-idx={i} data-teach-target={`cell:${i}`}>
              <span class="cell-val">{n}</span>
              <span class="cell-idx">{i}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="anim-row cd-set-section">
      <p class="anim-label">Hash Set (Seen Numbers)</p>
      <div class="hashmap-row cd-set" data-teach-target="set-box"></div>
    </div>
  </AlgorithmPlayer>
</contains-duplicate-visuals>

<script>
  class ContainsDuplicateVisuals extends HTMLElement {
    connectedCallback() {
      this.cells = Array.from(this.querySelectorAll(".cd-cell"));
      this.setEl = this.querySelector(".cd-set");
      this.formulaEl = this.querySelector(".cd-formula");
      this.decisionEl = this.querySelector(".cd-decision");
      this.answerEl = this.querySelector(".cd-answer");
      this.answerBox = this.querySelector('[data-teach-target="answer-box"]');
      this.setBox = this.querySelector('[data-teach-target="set-box"]');
      this.decisionBox = this.querySelector('[data-teach-target="decision-box"]');

      this.addEventListener("step-change", (e) => {
        const step = e.detail.step;

        if (this.formulaEl) {
          this.formulaEl.textContent = step.formula ?? '-';
        }

        if (this.decisionEl) {
          if (step.phase === 'start') {
            this.decisionEl.textContent = 'Initialize empty set';
          } else if (step.phase === 'lookup') {
            this.decisionEl.textContent = 'Check whether current value was seen before';
          } else if (step.phase === 'store') {
            this.decisionEl.textContent = 'Value is new → insert into set';
          } else {
            this.decisionEl.textContent = 'Duplicate found → return true';
          }
        }

        if (this.answerEl) {
          this.answerEl.textContent = step.found ? 'true' : 'false so far';
        }

        this.answerBox?.classList.toggle('success-box', Boolean(step.found));
        this.setBox?.classList.toggle('success-box', Boolean(step.found));
        this.decisionBox?.classList.toggle('success-box', Boolean(step.found));

        this.cells.forEach((cell, i) => {
          const valSpan = cell.querySelector(".cell-val");
          if (!valSpan) return;

          valSpan.className = "cell-val";
          if (i < step.i) valSpan.classList.add("visited");
          if (i === step.i) {
            valSpan.classList.add("active-eval");
            if (step.found) valSpan.classList.add("conflict");
          }
        });

        if (this.setEl) {
          if (step.set.length === 0) {
            this.setEl.innerHTML = "<span class='hashmap-empty'>empty</span>";
          } else {
            this.setEl.innerHTML = step.set
              .map((val, idx) => {
                const isMatch = step.found && val === step.val;
                return `<span class='hashmap-entry ${isMatch ? 'conflict-entry' : ''}' data-teach-target="entry:${idx}">${val}</span>`;
              })
              .join("");
          }
        }
      });
    }
  }

  if (!customElements.get('contains-duplicate-visuals')) {
    customElements.define('contains-duplicate-visuals', ContainsDuplicateVisuals);
  }
</script>

<style>
  contains-duplicate-visuals {
    display: block;
  }

  .cd-stats-row {
    margin-bottom: 1.5rem;
  }

  .cd-set-section {
    margin-top: 2rem;
  }

  .stat-box.success-box {
    border-color: var(--status-easy) !important;
    background: color-mix(in srgb, var(--status-easy) 10%, transparent) !important;
  }

  .stat-box.success-box .stat-val {
    color: var(--status-easy) !important;
  }

  .cell-val.visited {
    opacity: 0.5;
  }

  .cell-val.active-eval {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
    transform: translateY(-4px);
  }

  .cell-val.conflict {
    border-color: var(--status-hard) !important;
    color: var(--status-hard) !important;
    background: color-mix(in srgb, var(--status-hard) 15%, transparent) !important;
    animation: shake 0.4s ease-in-out;
  }

  .conflict-entry {
    border-color: var(--status-hard) !important;
    color: var(--status-hard) !important;
    background: color-mix(in srgb, var(--status-hard) 15%, transparent) !important;
    animation: shake 0.4s ease-in-out;
  }

  @keyframes shake {
    0%, 100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }
</style>
