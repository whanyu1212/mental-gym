---
import AlgorithmPlayer from './framework/AlgorithmPlayer.astro';

const initialArray = [2, 0, 2, 1, 1, 0];

const steps = [
  {
    array: [2, 0, 2, 1, 1, 0], low: 0, mid: 0, high: 5, activeMid: false,
    explanation: "Initial state: low=0, mid=0, high=5. Invariant: [0..low) is 0s, [low..mid) is 1s, (high..end] is 2s.",
  },
  {
    array: [2, 0, 2, 1, 1, 0], low: 0, mid: 0, high: 5, activeMid: true,
    explanation: "Evaluate nums[mid]=2 (Blue). Swap nums[mid] with nums[high], decrement high. Do NOT move mid — the swapped value is unknown.",
  },
  {
    array: [0, 0, 2, 1, 1, 2], low: 0, mid: 0, high: 4, activeMid: false,
    explanation: "After swap: 2 is now at index 5 (sorted). nums[mid] is now 0 — must evaluate it next.",
  },
  {
    array: [0, 0, 2, 1, 1, 2], low: 0, mid: 0, high: 4, activeMid: true,
    explanation: "Evaluate nums[mid]=0 (Red). Swap nums[low] with nums[mid], increment both low and mid.",
  },
  {
    array: [0, 0, 2, 1, 1, 2], low: 1, mid: 1, high: 4, activeMid: false,
    explanation: "Swap was 0 with 0 — array unchanged visually, but low and mid both advance. The 0 region is now [0..1).",
  },
  {
    array: [0, 0, 2, 1, 1, 2], low: 1, mid: 1, high: 4, activeMid: true,
    explanation: "Evaluate nums[mid]=0 (Red). Swap nums[low] with nums[mid], increment both.",
  },
  {
    array: [0, 0, 2, 1, 1, 2], low: 2, mid: 2, high: 4, activeMid: false,
    explanation: "Again a 0-0 swap — array unchanged, low=2, mid=2.",
  },
  {
    array: [0, 0, 2, 1, 1, 2], low: 2, mid: 2, high: 4, activeMid: true,
    explanation: "Evaluate nums[mid]=2 (Blue). Swap nums[mid] with nums[high], decrement high.",
  },
  {
    array: [0, 0, 1, 1, 2, 2], low: 2, mid: 2, high: 3, activeMid: false,
    explanation: "Swapped 2 and 1. Array: [0,0,1,1,2,2]. high=3. mid stays — the swapped 1 is unknown.",
  },
  {
    array: [0, 0, 1, 1, 2, 2], low: 2, mid: 2, high: 3, activeMid: true,
    explanation: "Evaluate nums[mid]=1 (White). Already in the right place. Just increment mid.",
  },
  {
    array: [0, 0, 1, 1, 2, 2], low: 2, mid: 3, high: 3, activeMid: true,
    explanation: "Evaluate nums[mid]=1 (White). Already in the right place. Increment mid.",
  },
  {
    array: [0, 0, 1, 1, 2, 2], low: 2, mid: 4, high: 3, activeMid: false,
    explanation: "mid=4 > high=3. Loop ends. Array is fully sorted in a single pass: [0,0,1,1,2,2].",
  },
];
---

<sort-colors-visuals>
  <AlgorithmPlayer title="Dutch National Flag (3-way partition)" steps={steps}>
    <div class="anim-row">
      <p class="anim-label">Array & Pointers</p>
      <div class="array-row">
        {initialArray.map((n, i) => (
          <div class="array-col">
            <div class="array-cell sc-cell" data-idx={i}>
              <span class="cell-val val-unknown">{n}</span>
              <span class="cell-idx">{i}</span>
            </div>
            <div class="pointers-row sc-ptr-col" data-idx={i}>
              <span class="ptr ptr-l hidden">L</span>
              <span class="ptr ptr-m hidden">M</span>
              <span class="ptr ptr-h hidden">H</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="anim-row legend-row">
      <div class="legend-item"><span class="legend-color val-0"></span> 0 (Red)</div>
      <div class="legend-item"><span class="legend-color val-1"></span> 1 (White)</div>
      <div class="legend-item"><span class="legend-color val-2"></span> 2 (Blue)</div>
    </div>
  </AlgorithmPlayer>
</sort-colors-visuals>

<script>
  class SortColorsVisuals extends HTMLElement {
    connectedCallback() {
      this.cells = Array.from(this.querySelectorAll(".sc-cell"));
      this.ptrCols = Array.from(this.querySelectorAll(".sc-ptr-col"));

      this.addEventListener("step-change", (e: any) => {
        const s = e.detail.step;

        this.cells.forEach((cell: any, i: number) => {
          const valSpan = cell.querySelector(".cell-val");
          const val = s.array[i];

          if (valSpan) {
            valSpan.textContent = val;
            valSpan.className = `cell-val val-${val}`;

            if (s.activeMid && i === s.mid) {
              valSpan.classList.add("active-eval");
            }
          }
        });

        this.ptrCols.forEach((col: any, i: number) => {
          const l = col.querySelector(".ptr-l");
          const m = col.querySelector(".ptr-m");
          const h = col.querySelector(".ptr-h");

          if (l) l.className = `ptr ptr-l ${i === s.low ? "" : "hidden"}`;
          if (m) m.className = `ptr ptr-m ${i === s.mid ? "" : "hidden"}`;
          if (h) h.className = `ptr ptr-h ${i === s.high ? "" : "hidden"}`;
        });
      });
    }
  }

  if (!customElements.get('sort-colors-visuals')) {
    customElements.define('sort-colors-visuals', SortColorsVisuals);
  }
</script>

<style>
  sort-colors-visuals {
    display: block;
  }

  /* Dutch National Flag Colors */
  .val-0 {
    background: rgba(176, 90, 90, 0.15); /* Reddish */
    border-color: #b05a5a;
    color: #e09090;
  }

  .val-1 {
    background: rgba(255, 255, 255, 0.05); /* White/Gray */
    border-color: #888;
    color: #ddd;
  }

  .val-2 {
    background: rgba(90, 130, 176, 0.15); /* Blueish */
    border-color: #5a82b0;
    color: #90b0e0;
  }

  .val-unknown {
    background: #0e0e0e;
    border-color: var(--border);
  }

  .active-eval {
    transform: translateY(-4px);
    box-shadow: 0 4px 12px rgba(201, 168, 76, 0.2);
    border-color: var(--accent);
  }

  .ptr-l { background: rgba(176, 90, 90, 0.2); color: #b05a5a; }
  .ptr-m { background: rgba(201, 168, 76, 0.2); color: #c9a84c; }
  .ptr-h { background: rgba(90, 130, 176, 0.2); color: #5a82b0; }

  .legend-row {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--muted);
    font-family: Inter, sans-serif;
  }

  .legend-color {
    width: 1rem;
    height: 1rem;
    border-radius: 2px;
    border: 1px solid;
  }
</style>
