---
import { withBase, stripBase } from "../lib/url";
import "../styles/tokens.css";
import "../styles/prose.css";

interface Props {
	title?: string;
	math?: boolean;
}

const { title = "Mental Gym", math = false } = Astro.props;
const pathname = stripBase(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
		<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.svg")} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				const saved = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				const theme = saved === "light" || saved === "dark" ? saved : prefersDark ? "dark" : "light";
				document.documentElement.setAttribute("data-theme", theme);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet" />
		{math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="brand" href={withBase("/")}>Mental Gym</a>
				<nav>
					<a href={withBase("/problems")} class={pathname.startsWith("/problems") || pathname.startsWith("/algorithms") || pathname.startsWith("/machine-learning") ? "active" : ""}
						>Problems</a
					>
					<a href={withBase("/notes")} class={pathname.startsWith("/notes") ? "active" : ""}
						>Notes</a
					>
					<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
						<span class="theme-toggle__icon" aria-hidden="true">◐</span>
					</button>
				</nav>
			</div>
		</header>
		<main class="container page-content">
			<slot />
		</main>
		<script is:inline>
			(() => {
				const html = document.documentElement;
				const btn = document.getElementById("theme-toggle");
				const icon = btn?.querySelector(".theme-toggle__icon");

				if (!btn || !icon) {
					return;
				}

				const applyTheme = (theme) => {
					html.setAttribute("data-theme", theme);
					localStorage.setItem("theme", theme);
					const isDark = theme === "dark";
					icon.textContent = isDark ? "☀" : "☾";
					btn.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
				};

				const current = html.getAttribute("data-theme") === "dark" ? "dark" : "light";
				applyTheme(current);

				btn.addEventListener("click", () => {
					const next = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
					applyTheme(next);
				});
			})();
		</script>
	</body>
</html>

<style>
	/* Structural tokens (type families, scale, radius, spacing, accent channels)
	   live in src/styles/tokens.css, imported above. This block holds only the
	   per-theme palette — the values that flip between dark and light. */

	:root,
	[data-theme="dark"] {
		color-scheme: dark;
		--bg: #0e0e0e;
		--panel: #161616;
		--surface-base: #0e0e0e;
		--surface-strong: #0a0a0a;
		--text: #f0ead6;
		--muted: #8a8070;
		--border: #2a2520;
		--accent-rgb: 201 168 76; /* brand gold — drives --accent + all --accent-* channels */
		--easy-rgb: 125 171 125;  /* status green — drives --easy-* channels */
		--link: rgb(var(--accent-rgb));
		--accent: rgb(var(--accent-rgb));
		--accent-dim: var(--accent-soft);
		--header-bg: rgba(14, 14, 14, 0.85);
		--bg-gradient: radial-gradient(ellipse at top, #1a1710 0%, var(--bg) 60%);
		--status-easy: rgb(var(--easy-rgb));
		--status-medium: var(--accent);
		--status-hard: #b05a5a;
		--status-info: #5a82b0;
		--glass-surface: rgba(22, 22, 22, 0.68);
		--glass-surface-strong: rgba(12, 12, 12, 0.78);
		--glass-border: rgba(240, 234, 214, 0.12);
		--glass-border-strong: rgba(240, 234, 214, 0.18);
		--glass-highlight: rgba(255, 255, 255, 0.08);
		--glass-highlight-strong: rgba(255, 255, 255, 0.12);
		--glass-blur: 14px;
		--shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.18);
		--shadow-lg: 0 10px 28px rgba(0, 0, 0, 0.38);
	}

	[data-theme="light"] {
		color-scheme: light;
		--bg: #fdfbf6;
		--panel: #f6f0e4;
		--surface-base: #efe7d8;
		--surface-strong: #e5dbc9;
		--text: #201d17;
		--muted: #5c5446;
		--border: #d8cfbd;
		--accent-rgb: 138 109 31; /* brand gold (light) */
		--easy-rgb: 46 125 50;    /* status green (light) */
		--link: rgb(var(--accent-rgb));
		--accent: rgb(var(--accent-rgb));
		--accent-dim: var(--accent-soft);
		--header-bg: rgba(253, 251, 246, 0.88);
		--bg-gradient: radial-gradient(ellipse at top, #f1e7d4 0%, var(--bg) 70%);
		--status-easy: rgb(var(--easy-rgb));
		--status-medium: #b26a00;
		--status-hard: #b23b3b;
		--status-info: #2f6fa6;
		--glass-surface: rgba(246, 240, 228, 0.68);
		--glass-surface-strong: rgba(239, 231, 216, 0.78);
		--glass-border: rgba(255, 255, 255, 0.42);
		--glass-border-strong: rgba(255, 255, 255, 0.58);
		--glass-highlight: rgba(255, 255, 255, 0.28);
		--glass-highlight-strong: rgba(255, 255, 255, 0.4);
		--glass-blur: 16px;
		--shadow-sm: 0 2px 8px rgba(32, 29, 23, 0.06);
		--shadow-lg: 0 10px 24px rgba(32, 29, 23, 0.1);
	}

	* {
		box-sizing: border-box;
	}

	html {
		font-size: 112.5%;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background: var(--bg-gradient);
		color: var(--text);
		font-family: var(--font-sans);
		font-feature-settings: "ss01", "cv11";
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	a {
		color: var(--link);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.site-header {
		border-bottom: 1px solid var(--glass-border);
		background: color-mix(in srgb, var(--header-bg) 76%, transparent);
		backdrop-filter: blur(var(--glass-blur)) saturate(140%);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.site-header .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.brand {
		color: var(--accent);
		font-weight: 600;
		font-size: 1.35rem;
		letter-spacing: 0.5px;
		font-family: var(--font-serif);
	}

	.brand:hover {
		text-decoration: none;
		opacity: 0.85;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.2rem;
	}

	nav a {
		color: var(--muted);
		font-size: var(--text-eyebrow);
		font-family: var(--font-sans);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	nav a:hover,
	nav a.active {
		color: var(--accent);
		text-decoration: none;
	}

	.theme-toggle {
		border: 1px solid var(--border);
		background: var(--panel);
		color: var(--muted);
		border-radius: 999px;
		width: 2rem;
		height: 2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--accent-dim);
	}

	.theme-toggle:active {
		transform: scale(0.96);
	}

	.theme-toggle__icon {
		font-size: 0.9rem;
		line-height: 1;
	}

	.page-content {
		padding-top: 1.25rem;
		padding-bottom: 2.5rem;
	}
</style>
