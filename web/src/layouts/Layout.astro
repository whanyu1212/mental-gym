---
import { withBase, stripBase } from "../lib/url";
import "../styles/tokens.css";
import "../styles/prose.css";

interface Props {
	title?: string;
	math?: boolean;
}

const { title = "Mental Gym", math = false } = Astro.props;
const pathname = stripBase(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
		<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.svg")} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				const saved = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				const theme = saved === "light" || saved === "dark" ? saved : prefersDark ? "dark" : "light";
				document.documentElement.setAttribute("data-theme", theme);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet" />
		{math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="brand" href={withBase("/")}>Mental Gym</a>
				<nav class="site-nav" aria-label="Primary navigation">
					<a href={withBase("/roadmap")} class={pathname.startsWith("/roadmap") ? "active" : ""}
						>Roadmap</a
					>
					<a href={withBase("/problems")} class={pathname.startsWith("/problems") || pathname.startsWith("/algorithms") || pathname.startsWith("/machine-learning") || pathname.startsWith("/sql") || pathname.startsWith("/system-design") ? "active" : ""}
						>Practice</a
					>
					<a href={withBase("/learn/")} class={pathname.startsWith("/learn") || pathname.startsWith("/notes") ? "active" : ""}
						>Learn</a
					>
					<a href={withBase("/#review")}>Review</a
					>
					<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
						<span class="theme-toggle__icon" aria-hidden="true">◐</span>
					</button>
				</nav>
			</div>
		</header>
		<main class="container page-content">
			<slot />
		</main>
		<script is:inline>
			(() => {
				const html = document.documentElement;
				const btn = document.getElementById("theme-toggle");
				const icon = btn?.querySelector(".theme-toggle__icon");

				if (!btn || !icon) {
					return;
				}

				const applyTheme = (theme) => {
					html.setAttribute("data-theme", theme);
					localStorage.setItem("theme", theme);
					const isDark = theme === "dark";
					icon.textContent = isDark ? "☀" : "☾";
					btn.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
				};

				const current = html.getAttribute("data-theme") === "dark" ? "dark" : "light";
				applyTheme(current);

				btn.addEventListener("click", () => {
					const next = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
					applyTheme(next);
				});
			})();
		</script>
	</body>
</html>

<style>
	/* Structural tokens (type families, scale, radius, spacing, accent channels)
	   live in src/styles/tokens.css, imported above. This block holds only the
	   per-theme palette — the values that flip between dark and light. */

	:root,
	[data-theme="dark"] {
		color-scheme: dark;
		--bg: #101613;
		--panel: #19221c;
		--surface-base: #141c17;
		--surface-strong: #0b100d;
		--text: #eef2e9;
		--muted: #b3b5a9;
		--border: #354338;
		--accent-rgb: 201 230 165; /* sage green — drives --accent + all --accent-* channels */
		--easy-rgb: 125 171 125;  /* status green — drives --easy-* channels */
		--link: rgb(var(--accent-rgb));
		--accent: rgb(var(--accent-rgb));
		--accent-dim: var(--accent-soft);
		--on-accent: #182e29;
		--header-bg: rgba(16, 22, 19, 0.9);
		--bg-gradient: none;
		--status-easy: rgb(var(--easy-rgb));
		--status-medium: #d5b56a;
		--status-hard: #b05a5a;
		--status-info: #5a82b0;
		--glass-surface: rgba(25, 34, 28, 0.75);
		--glass-surface-strong: rgba(16, 22, 19, 0.85);
		--glass-border: rgba(238, 242, 233, 0.12);
		--glass-border-strong: rgba(238, 242, 233, 0.18);
		--glass-highlight: rgba(255, 255, 255, 0.08);
		--glass-highlight-strong: rgba(255, 255, 255, 0.12);
		--glass-blur: 14px;
		--shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.18);
		--shadow-lg: 0 10px 28px rgba(0, 0, 0, 0.38);
	}

	[data-theme="light"] {
		color-scheme: light;
		--bg: #fcfdfb;
		--panel: #f3f6f0;
		--surface-base: #eff3eb;
		--surface-strong: #e4ebdf;
		--text: #202b25;
		--muted: #59645d;
		--border: #dce4d9;
		--accent-rgb: 36 88 68; /* forest green */
		--easy-rgb: 46 125 50;    /* status green (light) */
		--link: rgb(var(--accent-rgb));
		--accent: rgb(var(--accent-rgb));
		--accent-dim: var(--accent-soft);
		--on-accent: #fcfdfb;
		--header-bg: rgba(252, 253, 251, 0.94);
		--bg-gradient: none;
		--status-easy: rgb(var(--easy-rgb));
		--status-medium: #b26a00;
		--status-hard: #b23b3b;
		--status-info: #2f6fa6;
		--glass-surface: rgba(243, 246, 240, 0.75);
		--glass-surface-strong: rgba(239, 243, 235, 0.85);
		--glass-border: rgba(32, 43, 37, 0.09);
		--glass-border-strong: rgba(32, 43, 37, 0.16);
		--glass-highlight: rgba(255, 255, 255, 0.4);
		--glass-highlight-strong: rgba(255, 255, 255, 0.65);
		--glass-blur: 16px;
		--shadow-sm: 0 2px 8px rgba(32, 43, 37, 0.03);
		--shadow-lg: 0 10px 24px rgba(32, 43, 37, 0.08);
	}

	* {
		box-sizing: border-box;
	}

	html {
		font-size: 112.5%;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-sans);
		font-feature-settings: "ss01", "cv11";
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Background gradient as a single fixed layer pinned to the VIEWPORT, not
	   the (very tall) document. Painting it on `html, body` instead repeated the
	   radial across both boxes and let the warm bloom fade out ~60% down a long
	   page, leaving a visible horizontal seam ("shadow") below the fold. A fixed
	   ::before keeps the bloom anchored to the top of the screen on every scroll
	   position, so the background reads as one continuous field. */
	body::before {
		content: "";
		position: fixed;
		inset: 0;
		z-index: -1;
		background: var(--bg-gradient);
		pointer-events: none;
	}

	:global(a) {
		color: var(--link);
		text-decoration: none;
	}

	:global(a:hover) {
		text-decoration: underline;
	}

	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.site-header {
		border-bottom: 1px solid var(--glass-border);
		background: color-mix(in srgb, var(--header-bg) 76%, transparent);
		backdrop-filter: blur(var(--glass-blur)) saturate(140%);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%);
		box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.site-header .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.brand {
		color: var(--accent);
		font-weight: 600;
		font-size: var(--fs-xl);
		letter-spacing: 0.5px;
		font-family: var(--font-serif);
	}

	.brand:hover {
		text-decoration: none;
		opacity: 0.85;
	}

	.site-nav {
		align-items: center;
		display: flex;
		gap: 1.2rem;
	}

	.site-nav a {
		color: var(--muted);
		font-size: var(--text-eyebrow);
		font-family: var(--font-sans);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.site-nav a:hover,
	.site-nav a.active {
		color: var(--accent);
		text-decoration: none;
	}

	.theme-toggle {
		border: 1px solid var(--border);
		background: var(--panel);
		color: var(--muted);
		border-radius: 999px;
		width: 2rem;
		height: 2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--accent-dim);
	}

	.theme-toggle:active {
		transform: scale(0.96);
	}

	.theme-toggle__icon {
		font-size: var(--fs-sm);
		line-height: 1;
	}

	.page-content {
		padding-top: 1.25rem;
		padding-bottom: 2.5rem;
	}

	@media (max-width: 640px) {
		.site-header .container {
			gap: 1rem;
		}

		.brand {
			flex: 0 0 auto;
			font-size: var(--fs-lg);
		}

		.site-nav {
			gap: 0.8rem;
			margin-right: -1rem;
			overflow-x: auto;
			padding-right: 1rem;
			scrollbar-width: none;
		}

		.site-nav::-webkit-scrollbar {
			display: none;
		}

		.site-nav a {
			flex: 0 0 auto;
			font-size: var(--fs-micro);
		}
	}
</style>
