---
interface Props {
	title?: string;
	math?: boolean;
}

const { title = "Mental Gym", math = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		{math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="brand" href="/">Mental Gym</a>
				<nav>
					<a href="/" class={pathname === "/" ? "active" : ""}>Home</a>
					<a href="/problems" class={pathname.startsWith("/problems") || pathname.startsWith("/algorithms") || pathname.startsWith("/machine-learning") ? "active" : ""}
						>Problems</a
					>
					<a href="/notes/asymptotic-analysis" class={pathname.startsWith("/notes") ? "active" : ""}
						>Notes</a
					>
				</nav>
			</div>
		</header>
		<main class="container page-content">
			<slot />
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		--bg: #0e0e0e;
		--panel: #161616;
		--text: #f0ead6;
		--muted: #8a8070;
		--border: #2a2520;
		--link: #c9a84c;
		--accent: #c9a84c;
		--accent-dim: #7a6530;
		--font-serif: "Cormorant Garamond", Georgia, serif;
		--font-sans: "Inter", system-ui, -apple-system, sans-serif;
		--font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background: radial-gradient(ellipse at top, #1a1710 0%, var(--bg) 60%);
		color: var(--text);
		font-family: var(--font-sans);
	}

	a {
		color: var(--link);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.site-header {
		border-bottom: 1px solid var(--border);
		background: rgba(14, 14, 14, 0.85);
		backdrop-filter: blur(12px);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.site-header .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.brand {
		color: var(--accent);
		font-weight: 600;
		font-size: 1.35rem;
		letter-spacing: 0.5px;
		font-family: var(--font-serif);
	}

	.brand:hover {
		text-decoration: none;
		opacity: 0.85;
	}

	nav {
		display: flex;
		gap: 1.75rem;
	}

	nav a {
		color: var(--muted);
		font-size: 0.72rem;
		font-family: var(--font-sans);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	nav a:hover,
	nav a.active {
		color: var(--accent);
		text-decoration: none;
	}

	.page-content {
		padding-top: 1.25rem;
		padding-bottom: 2.5rem;
	}
</style>
