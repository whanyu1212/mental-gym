{
  "name": "mental-gym",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "type": "module",
  "description": "TypeScript ports and the Astro site in a shared Bun workspace.",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "leetcode": "bun",
    "typecheck": "tsc --noEmit",
    "web:dev": "bun run --cwd web dev",
    "web:test": "bun run --cwd web test",
    "web:build": "bun run --cwd web build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
